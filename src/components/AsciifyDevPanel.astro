---
// DEV-ONLY tweak panel for the contact-section ascii lens.
//
// Renders NOTHING in production: markup, styles and script all sit inside the
// import.meta.env.DEV conditional, and the styles are is:inline so Astro does
// not hoist them into the CSS bundle when the markup never renders — same
// approach as DevGrid.astro.
//
// Drives window.__asciify.instance.setOptions(), which ContactSection exposes
// (also dev-only). Values are NOT persisted across reloads on purpose: a reload
// should always show what is actually committed in the code, so the site can
// never quietly disagree with the source. Copy writes a pasteable literal.
const dev = import.meta.env.DEV;

// [key, label, min, max, step, decimals]
const SLIDERS: [string, string, number, number, number, number][] = [
  ["radius", "Radius", 0, 1, 0.01, 2],
  ["softness", "Softness", 0, 1, 0.01, 2],
  ["scale", "Scale", 0.5, 6, 0.1, 1],
  ["spacing", "Spacing", 0, 3, 1, 0],
  ["backgroundOpacity", "Bg opacity", 0, 1, 0.01, 2],
  ["contrast", "Contrast", 0, 5, 0.05, 2],
  ["brightness", "Brightness", -1, 1, 0.01, 2],
  ["invert", "Invert", 0, 1, 0.01, 2],
  ["glow", "Text glow", 0, 1, 0.01, 2],
  ["aberration", "Color fringe", 0, 1, 0.01, 2],
  ["strength", "Strength", 0, 1, 0.01, 2],
  ["baseStrength", "Base strength", 0, 1, 0.01, 2],
  ["followSpeed", "Follow speed", 0.5, 12, 0.1, 1],
];
---

{dev && (
  <>
    <div class="ap" id="ap" hidden>
      <div class="ap-head">
        <span class="ap-title mono-label">Asciify controls</span>
        <button class="ap-act mono-label" id="ap-copy" type="button">Copy</button>
        <button class="ap-act mono-label" id="ap-reset" type="button">Reset</button>
        <button class="ap-act ap-x" id="ap-close" type="button" title="Close">✕</button>
      </div>

      <div class="ap-seg" id="ap-charset">
        <button type="button" data-v="ascii" class="on">Ascii</button>
        <button type="button" data-v="blocks">Blocks</button>
        <button type="button" data-v="binary">Binary</button>
      </div>

      <div class="ap-rows">
        {SLIDERS.map(([key, label, min, max, step, dec]) => (
          <label class="ap-row" data-k={key} data-dec={dec}>
            <span class="ap-fill"></span>
            <span class="ap-name">{label}</span>
            <span class="ap-val">–</span>
            <input type="range" min={min} max={max} step={step} />
          </label>
        ))}
      </div>

      <p class="ap-note" id="ap-note">Scroll to the contact section to start the effect.</p>
    </div>

    <style is:inline>
      .ap {
        position: fixed;
        right: var(--space-2);
        bottom: calc(var(--space-2) + 44px);
        z-index: 9992;
        width: 270px;
        max-height: min(70vh, 620px);
        display: flex;
        flex-direction: column;
        padding: var(--space-2);
        gap: 6px;
        border: 1px solid var(--hairline);
        border-radius: var(--radius);
        background: rgba(10, 10, 11, 0.94);
        backdrop-filter: blur(8px);
      }
      .ap[hidden] { display: none; }

      .ap-head { display: flex; align-items: center; gap: 6px; }
      .ap-title { color: var(--cream); font-size: 11px; flex: 1; }
      .ap-act {
        padding: 3px 7px;
        font-size: 10px;
        border: 1px solid var(--hairline);
        border-radius: 5px;
        background: transparent;
        color: var(--cream-60);
        cursor: pointer;
      }
      .ap-act:hover { color: var(--cream); border-color: var(--hairline-hover); }
      .ap-x { padding: 3px 6px; }

      .ap-seg { display: flex; gap: 4px; }
      .ap-seg button {
        flex: 1;
        padding: 5px 0;
        font-family: var(--font-geist-mono);
        font-size: 10px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        border: 1px solid var(--hairline);
        border-radius: 5px;
        background: transparent;
        color: var(--cream-60);
        cursor: pointer;
      }
      .ap-seg button.on {
        color: var(--void);
        background: var(--cream);
        border-color: var(--cream);
      }

      .ap-rows {
        display: flex;
        flex-direction: column;
        gap: 4px;
        overflow-y: auto;
        overscroll-behavior: contain;
      }

      /* The filled bar IS the control: a real range input sits invisibly on top
         so keyboard and drag behaviour stay native. */
      .ap-row {
        position: relative;
        display: flex;
        align-items: center;
        height: 26px;
        padding-inline: 8px;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.05);
        overflow: hidden;
        cursor: ew-resize;
      }
      .ap-fill {
        position: absolute;
        inset: 0;
        width: calc(var(--v, 0) * 100%);
        background: rgba(255, 255, 255, 0.14);
        pointer-events: none;
      }
      .ap-name {
        position: relative;
        flex: 1;
        font-family: var(--font-geist-mono);
        font-size: 10px;
        color: var(--cream);
        pointer-events: none;
      }
      .ap-val {
        position: relative;
        font-family: var(--font-geist-mono);
        font-size: 10px;
        color: var(--cream-60);
        font-variant-numeric: tabular-nums;
        pointer-events: none;
      }
      .ap-row input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        opacity: 0;
        cursor: ew-resize;
      }

      .ap-note {
        margin: 0;
        font-family: var(--font-geist-mono);
        font-size: 9px;
        line-height: 1.4;
        color: var(--cream-39);
      }
      .ap-note[hidden] { display: none; }
    </style>

    <script is:inline>
      (function () {
        var panel = document.getElementById("ap");
        var btn = document.getElementById("dev-ascii-btn");
        if (!panel || !btn) return;

        var rows = [].slice.call(panel.querySelectorAll(".ap-row"));
        var seg = document.getElementById("ap-charset");
        var note = document.getElementById("ap-note");

        // Live values, seeded from the shipped config once it is available.
        var cur = {};
        var defaults = null;

        function api() {
          return window.__asciify && window.__asciify.instance;
        }

        function paintRow(row) {
          var input = row.querySelector("input");
          var k = row.dataset.k;
          var dec = +row.dataset.dec;
          var min = +input.min, max = +input.max;
          var v = +input.value;
          row.style.setProperty("--v", (v - min) / (max - min || 1));
          row.querySelector(".ap-val").textContent = v.toFixed(dec);
          cur[k] = v;
        }

        function seed(opts) {
          defaults = defaults || JSON.parse(JSON.stringify(opts));
          rows.forEach(function (row) {
            var k = row.dataset.k;
            if (typeof opts[k] === "number") row.querySelector("input").value = opts[k];
            paintRow(row);
          });
          [].forEach.call(seg.children, function (b) {
            b.classList.toggle("on", b.dataset.v === (opts.charset || "ascii"));
          });
          cur.charset = opts.charset || "ascii";
        }

        function push() {
          var a = api();
          if (a) a.setOptions(cur);
          if (note) note.hidden = !!a;
        }

        rows.forEach(function (row) {
          row.querySelector("input").addEventListener("input", function () {
            paintRow(row);
            push();
          });
        });

        seg.addEventListener("click", function (e) {
          var b = e.target.closest("button[data-v]");
          if (!b) return;
          [].forEach.call(seg.children, function (x) { x.classList.toggle("on", x === b); });
          cur.charset = b.dataset.v;
          push();
        });

        document.getElementById("ap-reset").addEventListener("click", function () {
          if (defaults) seed(defaults);
          push();
        });

        document.getElementById("ap-copy").addEventListener("click", function (e) {
          var order = rows.map(function (r) { return r.dataset.k; });
          var lines = ['  charset: "' + cur.charset + '",'];
          order.forEach(function (k) {
            lines.push("  " + k + ": " + (+cur[k].toFixed(4)) + ",");
          });
          var text = "{\n" + lines.join("\n") + "\n}";
          navigator.clipboard.writeText(text).then(function () {
            var t = e.target;
            t.textContent = "Copied";
            setTimeout(function () { t.textContent = "Copy"; }, 1200);
          });
        });

        function open(on) {
          panel.hidden = !on;
          btn.setAttribute("aria-pressed", String(on));
          try { localStorage.setItem("dev-ascii", on ? "1" : "0"); } catch (err) {}
          if (on && api()) { note.hidden = true; }
        }

        document.getElementById("ap-close").addEventListener("click", function () { open(false); });
        btn.addEventListener("click", function () { open(panel.hidden); });

        // The effect is created lazily on scroll, so seed whenever it appears.
        function onReady() {
          var a = window.__asciify;
          if (!a) return;
          seed(a.defaults);
          if (note) note.hidden = true;
        }
        addEventListener("asciify:ready", onReady);
        if (window.__asciify) onReady();

        var was = false;
        try { was = localStorage.getItem("dev-ascii") === "1"; } catch (err) {}
        open(was);
      })();
    </script>
  </>
)}
