---
interface Props {
  index: number;
  title: string;
  category: string;
  year: number;
  tagline: string;
  href: string;
  featured?: boolean;
}
const { index, title, category, year, tagline, href, featured = false } = Astro.props;
const num = String(index).padStart(2, "0");
---
<a class:list={["panel", { featured }]} href={href}>
  <div class="media machined" aria-hidden="true" data-reveal="media">
    <span class="ghost">{title}</span>
    <span class="chip">↗</span>
  </div>
  <div class="meta" data-reveal>
    <p class="eyebrow">{num} / {category} — {year}</p>
    <h2 class="title">{title}</h2>
    <p class="tagline">{tagline}</p>
  </div>
</a>

<style>
  /* No card frame — the media is the object, meta is clean text beneath it. */
  .panel { display: block; }
  .panel:hover { color: inherit; }

  .media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color var(--dur-ui) linear;
  }
  .panel:hover .media { border-color: var(--hairline-hover); }

  /* Featured (first) study reads as a commanding, near-full-height image. */
  .panel.featured .media {
    aspect-ratio: auto;
    height: clamp(440px, 72vh, 900px);
  }

  .ghost {
    font-family: var(--font-geist-mono);
    font-size: 12px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: var(--cream-39);
  }
  .chip {
    position: absolute;
    right: var(--spacing-16);
    bottom: var(--spacing-16);
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--ember);
    color: var(--ember);
    background: rgba(10, 10, 11, 0.55);
    box-shadow: var(--rim-light);
    font-size: 15px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur-ui) linear, transform var(--dur-ui) linear;
  }
  .panel:hover .chip { opacity: 1; transform: translateY(0); }

  .meta { margin-top: var(--spacing-20); }
  .title {
    margin-top: var(--spacing-12);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.2px;
    color: var(--cream);
  }
  .tagline {
    margin-top: var(--spacing-8);
    font-size: 15px;
    line-height: 1.5;
    color: var(--cream-88);
    max-width: 52ch;
  }

  /* True ultrawide only: uniform fixed-width cards in a horizontal gallery
     (featured hero height is reset so the row stays aligned). */
  @media (min-width: 2000px) and (min-aspect-ratio: 2/1) {
    .panel {
      flex: 0 0 auto;
      width: clamp(520px, 33vw, 720px);
      scroll-snap-align: start;
    }
    .media,
    .panel.featured .media { aspect-ratio: 4 / 3; height: auto; }
  }
</style>
