---
// Experience (Figma 2462:22611) — vertical scroll drives a horizontal timeline.
// The section pins; .exp-track translates in X beneath a fixed header. A ruler
// runs edge to edge, and each entry's divider grows to full height as it reaches
// the playhead. Motion is desktop-only: below 900px (and for reduced motion) no
// JS runs and the entries stack vertically via CSS alone.
// Target line count for an entry's body copy. Each column is sized from its
// own character count to land near this, then text-wrap:balance evens the
// ragged edge out.
// Each entry's panel takes either `video` + `poster` (a muted, looping,
// viewport-gated clip, same as the rest of the page) or `image` + `alt`.
// Video wins if both are present; neither leaves the flat placeholder.
const BODY_LINES = 4;
// Average glyph advance as a fraction of the font size, used to turn a
// character count into a column width. Measured against the rendered copy.
const AVG_ADVANCE_EM = 0.5;
// The CSS cap on the body column, in em at the body's own 14px size:
// calc(var(--measure) - var(--space-7)) = 680 - 96 = 584px -> 41.7em.
// Copy that exceeds it cannot fit BODY_LINES lines and wraps further, and
// those entries align to the top instead of the bottom. Hand-synced with the
// max-width in the stylesheet — change one and change the other.
const BODY_MAX_EM = (680 - 96) / 14;

const experience = [
  {
    year: "2018 → 2020",
    role: "Lead Designer",
    org: "Bank Account Builders",
    body: "Hired as lead designer at the marketing agency Bank Account Builders. Handled delivery of all client projects including sales funnel design and development and necessary branding assets. Handled back and forth communication with clients ensuring successful project delivery.",
    // ?v= bumps the cache key without renaming the file. Media is served with
    // max-age=86400, so re-encoding under the same URL would leave returning
    // visitors on the previous image for up to a day.
    image: "/exp-bank-account-builders.jpg?v=2",
    alt: "Client work from the Bank Account Builders era: sales funnel and landing page designs, before-and-after redesigns of two course funnels, and a photo of the team at the agency house in Scottsdale.",
  },
  {
    year: "2020 → Present",
    role: "Founder",
    org: "Conversion Designer (Freelancing)",
    body: "Begin my own personal freelancing business designing and building sales funnels and websites for clients. I’ve continued freelancing from 2020 till today.",
    image: "/exp-freelancing.jpg",
    alt: "A grid of freelance client work — landing pages and product sites for Luke Infinger, Realply, CleanConnect.ai, Infinite, Lions Not Sheep and Sterling Capital — with a note reading “I’ve freelanced on over 140 projects since 2020”.",
  },
  {
    year: "2020 → 2022",
    role: "Founder",
    // \n breaks the qualifier onto its own line — .exp-org is pre-line.
    org: "Conversion Designer Masterclass\n(Design Program)",
    body: "Created a program teaching beginner and intermediate designers how to design and build high-end sales funnels on the platform ClickFunnels through video courses and live trainings. Sold over $500,000 of revenue of the program and taught over 500 students. Owned a Facebook group giving free instructional content with 12k+ members. Created a software called “Template Builder” using Bubble.io that allowed ClickFunnels users to generate prebuilt layout templates from a massive library of templated sections I created.",
    video: "/exp-masterclass.mp4",
    poster: "/exp-masterclass-poster.jpg",
    image: null,
    alt: "",
  },
  {
    year: "2021 → 2022",
    role: "Co-Founder",
    org: "InterstellarX",
    body: "Co-founded a marketing and design agency serving Web3 and Crypto projects during the Web3 boom. We employed 5 employees and I oversaw client relations and delivered on all design-related projects for the agency.",
    image: null,
    alt: "",
  },
  {
    year: "2023 → Present",
    role: "Creative Lead",
    org: "USDKG",
    body: "Founding designer for USDKG, a stablecoin whose gold reserves are backed by the Ministry of Finance of Kyrgyzstan. Ideated and created brand from scratch and handled all things visual for the company, including brand creation, website design and development, document and deck design, social media direction and design, and more.",
    image: null,
    alt: "",
  },
  {
    year: "2023 → Present",
    role: "Co-Founder & Creative Director",
    org: "TL;DR",
    body: "Co-founded TL;DR, a first-of-its kind livestreaming software that generates highlight clips of a Twitch or Kick livestream during the livestream, not after. I handle all things visual and user-focused - including brand creation, website design & development, product direction, feature exploration, product design, front end agentic development, B2B decks and presentations, event design, clothing, and more. Till date we have over 35,000+ installs on our TL;DR Twitch Extension.",
    image: null,
    alt: "",
  },
];
---

<section class="section exp-band">
  {/* Header is a sibling of the stage, not inside it, so a short viewport can
      pin the stage alone and let the header scroll away — buying back its
      height for the entries. On tall viewports the whole band pins and the
      header rides along at the top. */}
  <div class="content-grid exp-head-grid">
    <header class="full exp-head">
      <h2 class="fw-title">
        <span class="mask"><span class="line">Experience</span></span>
      </h2>
      <span class="mask"><p class="exp-blurb">What I've been up to since 2018</p></span>
    </header>
  </div>

  <div class="exp-viewport">
    <div class="exp-track">
      {experience.map((item) => {
        const bodyEm = (item.body.length / BODY_LINES) * AVG_ADVANCE_EM;
        // Longer than BODY_LINES lines once capped — top-align those instead,
        // since there is no short paragraph to sit level with the org name.
        const runsLong = bodyEm > BODY_MAX_EM;
        return (
        <article class="exp-entry">
          <span class="exp-divider" aria-hidden="true"></span>
          <span class="exp-dot" aria-hidden="true"></span>
          <div class:list={["exp-copy", { "exp-copy-long": runsLong }]}>
            <div class="exp-meta">
              <span class="mask"><p class="exp-year">{item.year}</p></span>
              <span class="mask"><p class="exp-role">{item.role}</p></span>
              <span class="mask"><p class="exp-org">{item.org}</p></span>
            </div>
            <span class="mask exp-body-mask">
              {/* Column sized from the copy's own length so it settles at
                  BODY_LINES lines: (chars per line) x (average glyph advance).
                  em, not ch — ch is the width of "0", which in Geist runs ~30%
                  wider than the real average and pushed every column into the
                  cap. 0.5em is the usual average advance for proportional
                  Latin sans and measured within 0.1px here. Capped in CSS, so
                  an unusually long entry just runs to the cap and wraps on. */}
              <p class="exp-body" style={`--exp-body-w: ${bodyEm.toFixed(2)}em`}>{item.body}</p>
            </span>
          </div>
          {/* video wins over image when both are set; neither leaves the flat
              placeholder panel. Same treatment as the Featured Work covers and
              More Work tiles: preload="none" so it costs nothing until it
              nears the viewport, and .exp-video is picked up by the shared
              viewport gate in index.astro, which plays it on entry, pauses it
              on exit, retries a rejected play() and restarts on tab reveal. */}
          <div class="exp-media">
            {item.video ? (
              <video
                class="exp-video"
                src={item.video}
                poster={item.poster}
                muted
                loop
                playsinline
                preload="none"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            ) : item.image ? (
              <img
                src={item.image}
                alt={item.alt}
                width="1920"
                height="1080"
                loading="lazy"
                decoding="async"
              />
            ) : null}
          </div>
        </article>
        );
      })}
      <div class="exp-ruler" aria-hidden="true">
        <div class="exp-ruler-fill"></div>
        <!-- Real tick elements are injected here on desktop only; the gradient
             layers above stay as the cheap fallback for mobile / reduced
             motion. See buildTicks() in the script. -->
        <div class="exp-ticks"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const band = document.querySelector<HTMLElement>(".exp-band");
  const track = document.querySelector<HTMLElement>(".exp-track");

  // ---------------------------------------------------------------------
  // Tick magnification, ported from a React/framer-motion "chapter scrubber".
  // Only the maths carried over: a raised-cosine bump giving every tick its
  // rise from ONE shared value. There it was a pointer position on a vertical
  // rail; here it is the scroll playhead on a horizontal one, so the wave is
  // driven by scrub progress rather than a cursor and needs no springs — the
  // scrub is already eased by Lenis.
  // ---------------------------------------------------------------------
  const WAVE_RADIUS = 6;   // ticks either side of the playhead
  const REST_SCALE = 0.34; // resting tick height as a fraction of the band
  const OPACITY_AHEAD = 0.18;
  const OPACITY_TRAVELLED = 0.55;

  // 1 at the crest, 0 beyond the radius, zero slope at both ends — so the wave
  // has no seams. This is the whole trick.
  const bump = (distance: number, radius: number) =>
    distance >= radius ? 0 : 0.5 * (1 + Math.cos(Math.PI * (distance / radius)));

  if (band && track) {
    // Desktop, motion-friendly only. matchMedia creates the triggers on entry
    // and reverts them on exit, so crossing the breakpoint leaves no orphaned
    // pin-spacer behind.
    const mm = gsap.matchMedia();

    // Two conditions rather than one query: which element gets pinned depends
    // on whether there is room for the header inside the pinned screen. GSAP
    // re-runs this when the condition flips, so a resize across 950px rebuilds
    // against the right target.
    mm.add(
      {
        tall: "(min-width: 900px) and (prefers-reduced-motion: no-preference) and (min-height: 950px)",
        short: "(min-width: 900px) and (prefers-reduced-motion: no-preference) and (max-height: 949px)",
      },
      (ctx) => {
      const viewport = band.querySelector<HTMLElement>(".exp-viewport")!;
      // Tall: pin the whole band, header included. Short: pin only the stage,
      // so the header scrolls away and its height goes to the entries.
      const pinTarget = ctx.conditions?.tall ? band : viewport;
      // The run ends with the last entry's right edge on the right-hand grid
      // line — GridLines' .gl-d border, which sits at the right page margin,
      // so the target is (100vw - --margin). That gives a beat of travel past
      // the final entry without leaving it stranded beside empty canvas.
      // Function-based so invalidateOnRefresh recomputes on resize rather than
      // baking in a stale width.

      // Reads the margin live rather than the cached copy: --margin is a
      // clamp() of vw, and ScrollTrigger computes the pin's end from dist()
      // during a refresh, before any of our resize bookkeeping runs. Using the
      // stale value ended the run short by exactly the margin's delta.
      const marginNow = () =>
        parseFloat(getComputedStyle(track).paddingInlineStart) || 0;

      const dist = () => {
        const els = track.querySelectorAll<HTMLElement>(".exp-entry");
        const last = els[els.length - 1];
        if (!last) return Math.max(0, track.scrollWidth - window.innerWidth);
        const rightEdge = last.offsetLeft + last.offsetWidth;
        return Math.max(0, rightEdge - window.innerWidth + marginNow());
      };

      // The playhead is viewport centre. In track coordinates that is the
      // distance scrolled plus half a screen — which is exactly how far the
      // white fill should reach. Set on the track so both ruler layers inherit
      // it, and so the value is in the same coordinate space their percentages
      // resolve against.
      // --- real ticks + magnification wave -----------------------------
      const ticksHost = track.querySelector<HTMLElement>(".exp-ticks")!;
      const styles = getComputedStyle(band);
      const TICK = parseFloat(styles.getPropertyValue("--exp-tick")) || 16;
      // Mutable: --margin is a clamp() of vw, so it changes on resize. Re-read
      // whenever the ticks are rebuilt.
      let margin = parseFloat(getComputedStyle(track).paddingInlineStart) || 0;

      // The 16:9 panel is fixed; the entry's WIDTH yields instead. On a short
      // window a full-width panel would be taller than the band, and the
      // flex-shrink valve would squash it out of ratio — so the width is
      // derived from whatever vertical space is left once the header, the
      // track's padding and the tallest copy row have taken theirs.
      const sizeEntries = () => {
        const first = track.querySelector<HTMLElement>(".exp-entry");
        if (!first) return;
        // Clear the override so the entry falls back to --exp-entry-max, then
        // MEASURE it. Reading the custom property directly returns its literal
        // text — "calc(var(--wide) + var(--space-8))" — which parseFloat turns
        // into NaN, collapsing the whole calculation.
        band.style.removeProperty("--exp-entry-w");
        const maxW = first.getBoundingClientRect().width;

        const tcs = getComputedStyle(track);
        const contentH =
          track.clientHeight -
          parseFloat(tcs.paddingTop) -
          parseFloat(tcs.paddingBottom);
        const ecs = getComputedStyle(first);
        const stackGap = parseFloat(ecs.rowGap) || 0;
        const inset = parseFloat(ecs.paddingInlineStart) || 0;
        const tallestCopy = Math.max(
          ...Array.from(
            track.querySelectorAll<HTMLElement>(".exp-copy"),
            (c) => c.offsetHeight,
          ),
        );

        const mediaH = contentH - tallestCopy - stackGap;
        let w = Math.min(maxW, (mediaH * 16) / 9 + inset);
        // Pitch is w + --exp-gap, and --exp-gap is 8 past a tick multiple, so w
        // must also sit 8 past one for the dividers to stay on the ruler grid.
        w = Math.floor((w - 8) / TICK) * TICK + 8;
        band.style.setProperty("--exp-entry-w", Math.max(TICK, w) + "px");
      };

      // Runs before ScrollTrigger measures, so the pin distance and the tick
      // layout are both computed against the final width.
      ScrollTrigger.addEventListener("refreshInit", sizeEntries);
      sizeEntries();

      // No separate resize listener here on purpose. ScrollTrigger already
      // refreshes on resize and fires refreshInit first, which is exactly what
      // sizeEntries needs. An earlier version added its own listener that
      // called ScrollTrigger.refresh(), and because refreshInit mutates layout
      // that recursed — refresh triggering refresh until it threw
      // "Cannot read properties of undefined (reading 'end')".

      let ticks: HTMLElement[] = [];
      // Each tick's rise is fixed in TRACK space, centred on the entry
      // dividers — so the swell travels left with its entry instead of sitting
      // still at viewport centre. Computed once per build, not per frame.
      let riseOf: number[] = [];

      const computeRises = () => {
        const centres = Array.from(
          track.querySelectorAll<HTMLElement>(".exp-entry"),
          (e) => (e.offsetLeft - margin) / TICK,
        );
        riseOf = ticks.map((_, i) => {
          let peak = 0;
          for (const c of centres) {
            const r = bump(Math.abs(i - c), WAVE_RADIUS);
            if (r > peak) peak = r;
          }
          return peak;
        });
      };

      const buildTicks = () => {
        margin = marginNow();
        ticksHost.textContent = "";
        const count = Math.floor((track.scrollWidth - margin) / TICK) + 1;
        const frag = document.createDocumentFragment();
        ticks = Array.from({ length: count }, (_, i) => {
          const el = document.createElement("span");
          el.className = "exp-tick";
          el.style.left = margin + i * TICK + "px";
          frag.appendChild(el);
          return el;
        });
        ticksHost.appendChild(frag);
        band.classList.add("has-ticks");
        computeRises();
        boundary = -1;
        // One full pass so every tick starts at its resting swell; after this
        // only ticks crossing the playhead need repainting.
        for (let i = 0; i < ticks.length; i++) paintTick(i);
      };

      // The swell is static in track space, so the only per-frame work is
      // restyling ticks the playhead has just swept past — usually one.
      let boundary = -1;

      const baseOpacity = (i: number) =>
        i <= boundary ? OPACITY_TRAVELLED : OPACITY_AHEAD;
      const paintTick = (i: number) => {
        const el = ticks[i];
        if (!el) return;
        const rise = riseOf[i] ?? 0;
        const b = baseOpacity(i);
        el.style.opacity = String(b + rise * (1 - b));
        el.style.transform = `scaleY(${REST_SCALE + rise * (1 - REST_SCALE)})`;
      };

      const paintWave = (playhead: number) => {
        if (!ticks.length) return;
        const nextBoundary = Math.min(
          ticks.length - 1,
          Math.floor((playhead - margin) / TICK),
        );
        if (nextBoundary === boundary) return;
        const from = Math.max(0, Math.min(boundary, nextBoundary));
        const to = Math.max(boundary, nextBoundary);
        boundary = nextBoundary;
        for (let i = from; i <= to; i++) paintTick(i);
      };

      buildTicks();

      const setPlayhead = (progress: number) => {
        const playhead = progress * dist() + window.innerWidth / 2;
        track.style.setProperty("--exp-fill", playhead + "px");
        track.style.setProperty("--exp-glow", playhead + "px");
        paintWave(playhead);
      };

      const horiz = gsap.to(track, {
        x: () => -dist(),
        ease: "none",
        scrollTrigger: {
          // The <section> is the pin target on purpose: GSAP wraps a pinned
          // element in a .pin-spacer that replaces it as its parent's child,
          // so pinning anything inside .content-grid would break the
          // ".content-grid > .full" placement. main.content is a plain block,
          // so a spacer inserted there is harmless.
          trigger: pinTarget,
          pin: pinTarget,
          start: "top top",
          end: () => "+=" + dist(),
          scrub: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => setPlayhead(self.progress),
          // onUpdate only fires once progress CHANGES, so without this the
          // ruler would show no fill at all until the first scroll — when
          // everything left of centre should already read as travelled.
          // onRefresh also covers resize, where dist() changes underneath us.
          onRefresh: (self) => {
            // Resize changes both --margin and the track width, so the ticks
            // need re-laying out and their rises recomputing before the
            // playhead is repainted against them.
            buildTicks();
            setPlayhead(self.progress);
          },
        },
      });

      setPlayhead(0);

      const entries = gsap.utils.toArray<HTMLElement>(".exp-entry");

      entries.forEach((entry) => {
        const risers = entry.querySelectorAll<HTMLElement>(".mask > *");
        const media = entry.querySelector<HTMLElement>(".exp-media");
        const divider = entry.querySelector<HTMLElement>(".exp-divider");

        // Beat 1 — as the entry slides in from the right. Same riser language
        // as every other section on the page.
        if (risers.length) {
          gsap.from(risers, {
            yPercent: 110,
            duration: 0.9,
            ease: "power4.out",
            stagger: 0.09,
            scrollTrigger: {
              trigger: entry,
              containerAnimation: horiz,
              start: "left 85%",
              once: true,
            },
          });
        }

        if (media) {
          gsap.from(media, {
            opacity: 0,
            duration: 0.9,
            ease: "power2.out",
            scrollTrigger: {
              trigger: entry,
              containerAnimation: horiz,
              start: "left 85%",
              once: true,
            },
          });
        }

        // Beat 2 — the divider locks in at the playhead (viewport centre), so a
        // line is white only once it is behind the playhead, matching the ruler.
        // The dot lands just as the line finishes drawing up to meet it.
        if (divider) {
          const dot = entry.querySelector<HTMLElement>(".exp-dot");
          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: entry,
              containerAnimation: horiz,
              start: "left 50%",
              toggleActions: "play none none reverse",
            },
          });
          tl.to(divider, { scaleY: 1, duration: 0.7, ease: "power3.out" });
          if (dot) {
            tl.to(dot, { scale: 1, duration: 0.4, ease: "back.out(2)" }, 0.3);
          }
        }
      });

      return () => {
        ScrollTrigger.removeEventListener("refreshInit", sizeEntries);
        band.style.removeProperty("--exp-entry-w");
        horiz.scrollTrigger?.kill();
        horiz.kill();
        gsap.set(track, { clearProps: "transform" });
        ticksHost.textContent = "";
        band.classList.remove("has-ticks");
        ticks = [];
      };
      },
    );
  }
</script>

<style>
  /* Pinned viewport. Height is exactly one screen — GSAP adds the scroll
     distance via its pin-spacer, so .section's min-height must be neutralised
     or the band would be taller than the pin and the track would sit low. */
  /* Declares its own column layout rather than inheriting .section's. Astro
     scopes styles per file, so index.astro's ".section { display:flex }" never
     reaches this element — it carries this component's scope hash, not that
     one's. The .section class is kept for semantics and for the DOM-wide
     reveal selector, but its layout must be restated here. */
  /* The ruler's tick pitch is the unit this timeline is built on: a divider
     must land ON a tick, not between two. That forces the divider-to-divider
     pitch to be a whole number of ticks. --wide (920px) is not a multiple of
     the 16px tick, so the gap carries the 8px correction:
       920 + 136 = 1056 = 66 ticks exactly.
     The ruler's gradient is then phase-shifted by --margin so its first tick
     sits under the first divider. Both parts are needed — without the pitch
     fix, dividers alternate on/off the grid by 8px. */
  .exp-band {
    --exp-tick: var(--space-2);                          /* 16px pitch */
    --exp-tick-h: var(--space-3);                        /* 24px tall  */
    --exp-gap: calc(var(--space-8) + var(--space-1));    /* 136px      */
    --exp-entry-max: calc(var(--wide) + var(--space-8)); /* 1048px     */
    --exp-rule: 1px;                                     /* hairline   */
    /* Meta type metrics, hoisted so the divider can start at the year's
       optical centre without restating them. */
    --exp-meta-size: 14px;
    --exp-meta-lh: 1.35;
    --exp-meta-half: calc(var(--exp-meta-size) * var(--exp-meta-lh) / 2);
    /* Track's bottom padding: the ruler occupies --exp-tick-h of it, and the
       remainder is clear space so the media panel never touches the timeline. */
    --exp-track-pad-b: calc(var(--exp-tick-h) + var(--space-5));

    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100svh;
    min-height: 0;
    overflow: hidden;
  }
  .exp-viewport {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .exp-head-grid { padding-block-start: var(--space-6); flex: 0 0 auto; }

  /* Short viewports (laptops): the band grows instead of being a fixed screen,
     the stage alone is a screen tall, and the script pins the stage rather
     than the band. The header scrolls away above it, handing its ~116px back
     to the entries — enough at 900px tall to take them from 936px to their
     1048px cap. Above this height there is room for both, so the band pins
     whole and the header stays put, as before. */
  @media (max-height: 949px) {
    /* display:block, not flex, is load-bearing here. GSAP reserves a pin's
       scroll distance as padding-bottom on its spacer — but when the pinned
       element's parent is a flex container it takes a different path and
       reserves nothing, so the spacer stayed one screen tall against a
       5412px run and every section below rode up over the pinned stage.
       The stage is a fixed height in this mode, so it has no need of flex. */
    .exp-band {
      display: block;
      height: auto;
      min-height: 0;
      overflow: visible;
    }
    .exp-viewport {
      flex: 0 0 auto;
      height: 100svh;
    }
  }
  /* .full spans the grid edge to edge, margins included — inset it to the page
     margin so the title lines up with the track's first entry. */
  .exp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-inline: var(--margin);
  }
  .exp-blurb {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
    text-align: right;
  }

  /* The translating element. position:relative so the ruler can pin to its
     bottom edge and span the whole track rather than one screen.

     width:max-content + align-self:flex-start are load-bearing: .exp-viewport
     is a flex column, so the default align-self:stretch would size the track to
     the viewport and let its entries overflow. The ruler is absolutely
     positioned with inset-inline:0, so it would then span one screen instead of
     the whole timeline. max-content makes the track's own box equal its
     content, which is also what makes track.scrollWidth meaningful. */
  .exp-track {
    position: relative;
    flex: 1;
    /* Without this the flex item's auto min-height lets tall content grow the
       track past the band, which drags the ruler below the fold. */
    min-height: 0;
    align-self: flex-start;
    width: max-content;
    display: flex;
    align-items: stretch;
    gap: var(--exp-gap);
    padding-block: var(--space-6) var(--exp-track-pad-b);
    padding-inline-start: var(--margin);
    /* The run overshoots the track's own content width by exactly --margin
       (it ends with the last entry on the right grid line, not on the screen
       edge). Matching that here keeps the ruler running to the viewport edge
       instead of stopping short with blank canvas beside it — and it makes the
       track's inline padding symmetric. */
    padding-inline-end: var(--margin);
    will-change: transform;
  }

