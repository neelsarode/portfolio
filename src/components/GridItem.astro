---
interface Props { label: string; }
const { label } = Astro.props;
---
<div class="item">
  <div class="media machined" aria-hidden="true"></div>
  <span class="label mono-label">{label}</span>
</div>

<style>
  .item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .media {
    width: 100%;
    aspect-ratio: 4 / 3;
    transition: border-color var(--dur-ui) linear;
  }
  .item:hover .media { border-color: var(--hairline-hover); }
  .label { color: var(--cream-60); }
</style>
