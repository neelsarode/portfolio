---
// Structural grid lines — the faint full-height hairlines of high-end
// portfolio sites. NOT decoration: each line sits on a column anchor the
// layout actually uses (left margin, col 3 = intro frame, col 9 = right
// rail, col 11 = Featured Work meta rail, right margin), drawn from the
// same tokens as .full-composed so they can never drift from the real grid.
//
// Layering: fixed at z-index 0, mounted AFTER the fixed WebGL scene and
// below all content (.content is z-index 1) — the opaque hero covers the
// lines entirely, so they only emerge as you scroll into the structured
// sections, and they show through the intro video's transparent pixels.
---
<div class="gridlines" aria-hidden="true">
  <div class="gl gl-a"></div>
  <div class="gl gl-b"></div>
  <div class="gl gl-c"></div>
  <div class="gl gl-d"></div>
</div>

<style>
  .gridlines {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    padding-inline: var(--margin);
    pointer-events: none;
  }
  .gl { border-inline-start: 1px solid var(--gridline); }
  .gl-a { grid-column: 1 / 3; }   /* line at col 1  = left page margin   */
  .gl-b { grid-column: 3 / 9; }   /* line at col 3  = intro frame anchor */
  .gl-c { grid-column: 9 / 11; }  /* line at col 9  = right-rail anchor  */
  .gl-d {
    grid-column: 11 / 13;         /* line at col 11 = fw meta rail       */
    border-inline-end: 1px solid var(--gridline); /* right page margin   */
  }

  /* Small screens: content runs full-width (cols 1/-1), so the interior
     anchors stop meaning anything — keep only the two margin lines. */
  @media (max-width: 640px) {
    .gl-b, .gl-c { border-inline-start: none; }
    .gl-d { border-inline-start: none; }
  }
</style>
