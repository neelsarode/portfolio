---
// "More work" — the foot of every case study (Figma 2548:24573 §8). Lists the
// other featured case studies as a 3-up row of cards: looping cover on top,
// name + tags beneath. Pass the current page's slug so it excludes itself.
// Entries without an href (page not built yet) render as plain tiles — no
// link, no cursor label, no hover zoom.
//
// Reveal: the same [data-reveal-group] / .mask / [data-fade] hooks as the
// case-study pages — their gsap script queries the whole document, so these
// animate with the rest of the page. The .mask recipe is repeated here
// because the pages' copies are scoped to their own markup.
import { featuredWork } from "../data/featured-work";

interface Props {
  current: string;
}
const { current } = Astro.props;
const cards = featuredWork.filter((w) => w.slug !== current);
---
<section class="more">
  <div class="content-grid">
    <div class="full-composed">
      <h2 class="more-title" data-reveal-group>
        <span class="mask"><span class="line">More work</span></span>
      </h2>
      <div class="cards">
        {cards.map((card) => {
          const Tag = card.href ? "a" : "div";
          return (
          <Tag class="card" href={card.href} data-reveal-group data-cursor-label={card.href ? `${card.name} Case Study →` : undefined}>
            <div class="card-media" data-fade>
              <video
                src={card.video}
                poster={card.poster}
                muted
                loop
                playsinline
                preload="none"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            </div>
            <div class="card-caption">
              <span class="mask"><p class="card-name">{card.name}</p></span>
              <div class="card-tags">
                {card.tags.map((t, i) => (
                  <>
                    {i > 0 && <span class="card-sep" aria-hidden="true"></span>}
                    <span class="mask"><p class="card-tag">{t}</p></span>
                  </>
                ))}
              </div>
            </div>
          </Tag>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- Cover loops sit at the very bottom of long pages, so they preload
     nothing and only play while on screen (Chrome's offscreen-media pause
     doesn't reliably resume on its own — same gate as the panel loops).
     Reduced motion: posters only. -->
<script>
  const vids = document.querySelectorAll<HTMLVideoElement>(".card-media > video");
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { rootMargin: "160px" },
    );
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  .more { padding-block-end: var(--space-8); }

  .mask {
    display: block;
    overflow: clip;
    padding-block-end: 0.14em;
    margin-block-end: -0.14em;
  }
  .line { display: block; }

  .more-title {
    grid-column: 1 / -1;
    margin: 0 0 var(--space-6);
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #fff;
  }
  /* 3-up (416px tiles at 1440, same track as the homepage Work Dump).
     minmax(0, 1fr) keeps nowrap captions from blowing the tracks wide. */
  .cards {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--gutter);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: #fff;
    text-decoration: none;
  }
  .card-media {
    position: relative;
    aspect-ratio: 636 / 551;
    overflow: hidden;
    background: #171718;
  }
  .card-media > video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Linked cards: the loop eases in a touch on hover — same clickable-media
     cue as the homepage's Featured Work rows. */
  a.card:hover .card-media > video { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    .card-media > video { transition: none; }
    a.card:hover .card-media > video { transform: none; }
  }
  /* Caption sized like the Work Dump's 3-up tiles: 13px at 1440+, easing to
     11px below. Tags ride the right edge while they fit and drop under the
     name (wrapping among themselves) when they don't — each tag stays nowrap
     so a label never breaks mid-word. */
  .card-caption {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    min-width: 0;
    font-size: clamp(11px, 0.588vw + 4.53px, 13px);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .card-name { margin: 0; color: #fff; white-space: nowrap; }
  .card-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-inline-start: auto;
  }
  .card-tag { margin: 0; color: rgba(255, 255, 255, 0.5); white-space: nowrap; }
  .card-sep { width: 1px; height: 13px; background: rgba(255, 255, 255, 0.1); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .card-tags { display: none; }
  }
</style>
