---
interface Props { activePath: string; }
const { activePath } = Astro.props;
const links = [
  { href: "/", label: "Work" },
  { href: "/info", label: "Info" },
  { href: "/contact", label: "Contact" },
];
---
<aside class="sidebar">
  <div class="sidebar-top">
    <p class="eyebrow">Design Portfolio</p>
    <p class="name">Neel Sarode</p>
    <p class="bio">
      Product &amp; brand designer based in San Francisco. I design clear,
      considered interfaces and identities for early-stage teams. Selected work
      below.
    </p>
    <nav class="nav">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["nav-link", { active: activePath === l.href }]}
        >{l.label}</a>
      ))}
    </nav>
  </div>
  <div class="sidebar-footer">
    <a class="mono-label" href="mailto:neel@example.com">Email ↗</a>
    <a class="mono-label" href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn ↗</a>
    <div class="theme-toggle" role="group" aria-label="Color theme">
      <button type="button" class="tt-btn" data-theme-set="dark" aria-label="Dark theme" title="Dark">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 1 1 6.4 2.5 4.6 4.6 0 0 0 13.5 9.6Z"/></svg>
      </button>
      <button type="button" class="tt-btn" data-theme-set="light" aria-label="Light theme" title="Light">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.1 1.1M11.85 11.85l1.1 1.1M12.95 3.05l-1.1 1.1M4.15 11.85l-1.1 1.1"/></svg>
      </button>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: var(--spacing-64) var(--spacing-32);
    gap: var(--spacing-64);
  }
  .name {
    margin-top: var(--spacing-16);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.2px;
    color: var(--cream);
  }
  .bio {
    margin-top: var(--spacing-16);
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--cream-88);
  }
  .nav {
    margin-top: var(--spacing-48);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    width: fit-content;
    font-size: 14px;
    color: var(--cream-60);
  }
  .nav-link::before {
    content: "";
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    background: transparent;
    transition: background var(--dur-ui) linear;
  }
  .nav-link:hover { color: var(--cream); }
  .nav-link.active { color: var(--cream); }
  .nav-link.active::before { background: var(--ember); }

  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    color: var(--cream-60);
  }
  .sidebar-footer a:hover { color: var(--ember); }

  /* Theme selector — pinned to the far-right corner of the footer */
  .theme-toggle {
    margin-left: auto;
    display: inline-flex;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tt-btn {
    display: grid;
    place-items: center;
    width: 28px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cream-60);
    cursor: pointer;
    transition: background var(--dur-ui) linear, color var(--dur-color) linear;
  }
  .tt-btn + .tt-btn { border-left: 1px solid var(--hairline); }
  .tt-btn:hover { color: var(--cream); }
  .tt-btn[aria-pressed="true"] { background: var(--onyx); color: var(--ember); }

  @media (max-width: 991px) {
    .sidebar {
      flex-direction: column;
      height: auto;
      padding: var(--spacing-24);
      gap: var(--spacing-24);
    }
    .name { margin-top: var(--spacing-12); font-size: 16px; }
    .nav { flex-direction: row; gap: var(--spacing-24); margin-top: var(--spacing-16); }
    .bio { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll(".tt-btn");
  function setTheme(theme) {
    root.dataset.theme = theme;
    try { localStorage.setItem("theme", theme); } catch (e) {}
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.themeSet === theme))
    );
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => setTheme(b.dataset.themeSet || "dark"))
  );
  // Reflect the theme the inline head script already applied.
  setTheme(root.dataset.theme || "dark");
</script>
