---
// Theme switcher: ThemeToggle is the v2 "Eclipse" morph + circular reveal.
// To revert to the classic two-button switcher, import ThemeToggleClassic instead.
import ThemeToggle from "./ThemeToggle.astro";
interface Props { activePath: string; }
const { activePath } = Astro.props;
const links = [
  { href: "/", label: "Work" },
  { href: "/info", label: "Info" },
  { href: "/contact", label: "Contact" },
];
---
<aside class="sidebar">
  <div class="sidebar-top">
    <p class="eyebrow" data-reveal-session>Design Portfolio</p>
    <p class="name" data-reveal-session>Neel Sarode</p>
    <p class="bio" data-reveal-session>
      Product &amp; brand designer based in San Francisco. I design clear,
      considered interfaces and identities for early-stage teams. Selected work
      below.
    </p>
    <nav class="nav" data-reveal-session>
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["nav-link", { active: activePath === l.href }]}
        >{l.label}</a>
      ))}
    </nav>
  </div>
  <div class="sidebar-footer" data-reveal-session>
    <a class="mono-label" href="mailto:neel@example.com">Email ↗</a>
    <a class="mono-label" href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn ↗</a>
    <div class="theme-slot"><ThemeToggle /></div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: var(--spacing-64) var(--spacing-32);
    gap: var(--spacing-64);
  }
  .name {
    margin-top: var(--spacing-16);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.2px;
    color: var(--cream);
  }
  .bio {
    margin-top: var(--spacing-16);
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--cream-88);
  }
  .nav {
    margin-top: var(--spacing-48);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    width: fit-content;
    font-size: 14px;
    color: var(--cream-60);
  }
  .nav-link::before {
    content: "";
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    background: transparent;
    transition: background var(--dur-ui) linear;
  }
  .nav-link:hover { color: var(--cream); }
  .nav-link.active { color: var(--cream); }
  .nav-link.active::before { background: var(--ember); }

  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    color: var(--cream-60);
  }
  .sidebar-footer a:hover { color: var(--ember); }

  /* Theme selector — pinned to the far-right corner of the footer */
  .theme-slot { margin-left: auto; display: inline-flex; }

  @media (max-width: 991px) {
    .sidebar {
      flex-direction: column;
      height: auto;
      padding: var(--spacing-24);
      gap: var(--spacing-24);
    }
    .name { margin-top: var(--spacing-12); font-size: 16px; }
    .nav { flex-direction: row; gap: var(--spacing-24); margin-top: var(--spacing-16); }
    .bio { display: none; }
  }
</style>
