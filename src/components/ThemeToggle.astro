---
// "Eclipse" theme switcher — a single button whose sun/moon glyph morphs
// (rays retract, a mask bites the disc into a crescent) and whose click
// floods the new theme across the page as an expanding circle via the
// View Transitions API. Classic two-button switcher preserved in
// ThemeToggleClassic.astro — swap the import in Sidebar.astro to revert.
---
<button
  type="button"
  class="eclipse-btn"
  aria-pressed="false"
  aria-label="Switch to light theme"
>
  <svg class="eclipse" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <defs>
      <mask id="eclipse-bite">
        <rect width="24" height="24" fill="white" />
        <circle class="bite" cx="16" cy="8" r="7" fill="black" />
      </mask>
    </defs>
    <circle class="disc" cx="12" cy="12" r="7" fill="currentColor" mask="url(#eclipse-bite)" />
    <g class="rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <g transform="rotate(0 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(45 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(90 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(135 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(180 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(225 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(270 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
      <g transform="rotate(315 12 12)"><line x1="12" y1="2.2" x2="12" y2="4.4" /></g>
    </g>
  </svg>
</button>

<style>
  /* Spring with overshoot for the pop-out moments; crisp ease for retreats. */
  .eclipse-btn {
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--cream-60);
    cursor: pointer;
    transition:
      color var(--dur-color) linear,
      border-color var(--dur-ui) linear,
      transform 300ms var(--spring);
  }
  .eclipse-btn:hover {
    color: var(--cream);
    border-color: var(--hairline-hover);
  }
  .eclipse-btn:active { transform: scale(0.92); }

  .eclipse {
    /* Orient the crescent so its opening faces right (bite enters at 45°
       up-right; +50° swings it to ~horizontal with a slight tilt). */
    transform: rotate(50deg);
    transform-origin: center;
    scale: 1;
    transition:
      transform 500ms var(--spring),
      scale 300ms var(--spring);
  }
  .eclipse-btn:hover .eclipse { scale: 1.1; }

  /* Disc: full moon by default, shrinks to sun core in light theme. */
  .disc {
    r: 7px;
    transition: r 500ms var(--spring);
  }

  /* Mask bite: overlaps the disc for the crescent, slides away for the sun. */
  .bite {
    cx: 16px;
    cy: 8px;
    transition: cx 450ms ease, cy 450ms ease;
  }

  /* Rays: retracted in dark mode, pop out with a stagger in light mode. */
  .rays line {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
    transition:
      transform 250ms ease-in,
      opacity 200ms linear;
  }

  :global(:root[data-theme="light"]) .eclipse { transform: rotate(0deg); }
  :global(:root[data-theme="light"]) .disc { r: 4.5px; }
  :global(:root[data-theme="light"]) .bite { cx: 26px; cy: -4px; }
  :global(:root[data-theme="light"]) .rays line {
    transform: scale(1);
    opacity: 1;
    transition:
      transform 450ms var(--spring),
      opacity 200ms linear;
  }
  :global(:root[data-theme="light"]) .rays g:nth-child(1) line { transition-delay: 60ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(2) line { transition-delay: 90ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(3) line { transition-delay: 120ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(4) line { transition-delay: 150ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(5) line { transition-delay: 180ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(6) line { transition-delay: 210ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(7) line { transition-delay: 240ms; }
  :global(:root[data-theme="light"]) .rays g:nth-child(8) line { transition-delay: 270ms; }

  @media (prefers-reduced-motion: reduce) {
    .eclipse-btn,
    .eclipse,
    .disc,
    .bite,
    .rays line {
      transition: none !important;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>(".eclipse-btn");

  function apply(theme: string) {
    root.dataset.theme = theme;
    try { localStorage.setItem("theme", theme); } catch (e) {}
    btn?.setAttribute("aria-pressed", String(theme === "light"));
    btn?.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
    );
  }

  btn?.addEventListener("click", () => {
    const next = (root.dataset.theme || "dark") === "dark" ? "light" : "dark";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!document.startViewTransition || reduceMotion) {
      apply(next);
      return;
    }

    // Flood the new theme outward from the button's center.
    const rect = btn.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const radius = Math.hypot(
      Math.max(cx, window.innerWidth - cx),
      Math.max(cy, window.innerHeight - cy)
    );

    root.classList.add("theme-vt");
    const vt = document.startViewTransition(() => apply(next));
    vt.ready
      .then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${cx}px ${cy}px)`,
              `circle(${radius}px at ${cx}px ${cy}px)`,
            ],
          },
          {
            // Soft gather at the button, sweep, then a long settle at the edges.
            duration: 850,
            easing: "cubic-bezier(0.45, 0.05, 0.15, 1)",
            pseudoElement: "::view-transition-new(root)",
          }
        );
      })
      .catch(() => {});
    vt.finished.finally(() => root.classList.remove("theme-vt"));
  });

  // Reflect the theme the inline head script already applied before paint.
  apply(root.dataset.theme || "dark");
</script>
