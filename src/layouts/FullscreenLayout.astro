---
// Minimal full-bleed layout: same head essentials (fonts, tokens, theme
// no-flash) as Layout, but NO sidebar and NO shell/padding — the page's
// content owns the whole viewport. Deliberately omits the entrance-reveal
// orchestrator, so [data-reveal] gating never applies here.
import "../styles/global.css";
import AxisCursor from "../components/AxisCursor.astro";
interface Props { title: string; description?: string; }
const {
  title,
  description = "I join early stage companies and design & build everything users see.",
} = Astro.props;
// Social cards need absolute URLs — built off astro.config's `site`.
const ogImage = new URL("/og.jpg", Astro.site);
const ogUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@300&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Neel Sarode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
    <AxisCursor />
  </body>
</html>

<script>
  // Lenis smooth scroll — site-wide. Uses native window scroll under the
  // hood, so position:fixed scenes and ScrollTrigger keep working; exposed
  // on window (+ an event for scripts that load first) so the homepage can
  // wire ScrollTrigger.update to it. Skipped for reduced-motion users.
  import Lenis from "lenis";
  import "lenis/dist/lenis.css";

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const lenis = new Lenis({ autoRaf: true });
    (window as any).lenis = lenis;
    dispatchEvent(new Event("lenis:init"));
  }
</script>

<style>
  /* Full-bleed. Allow vertical scroll (pages may stack sections over a fixed
     scene); clip horizontal overflow from 100vw elements. */
  body { overflow-x: hidden; }
</style>
