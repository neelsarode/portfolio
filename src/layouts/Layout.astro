---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
interface Props { title: string; activePath: string; }
const { title, activePath } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@300&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="shell">
      <div class="left"><Sidebar activePath={activePath} /></div>
      <main id="main" class="right"><slot /></main>
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--spacing-16);
    top: -48px;
    background: var(--cream);
    color: var(--void);
    font-family: var(--font-geist-mono);
    font-size: 12px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    padding: var(--spacing-8) var(--spacing-16);
    border-radius: var(--radius);
    z-index: 10;
    transition: top var(--dur-ui) linear;
  }
  .skip-link:focus { top: var(--spacing-16); }

  .shell { min-height: 100vh; background: var(--void); }
  .left {
    position: fixed;
    top: 0; left: 0;
    width: var(--sidebar-w);
    min-width: var(--sidebar-min);
    height: 100vh;
    background: var(--onyx);
    border-right: 1px solid var(--hairline);
  }
  .right {
    margin-left: max(var(--sidebar-w), var(--sidebar-min));
    padding: var(--spacing-40) var(--spacing-40) var(--spacing-80);
    background: var(--void);
    min-height: 100vh;
  }
  @media (max-width: 991px) {
    .left {
      position: static;
      width: 100%;
      min-width: 0;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
    .right {
      margin-left: 0;
      padding: var(--spacing-32) var(--spacing-32) var(--spacing-64);
    }
  }
  @media (max-width: 767px) {
    .right { padding: var(--spacing-24) var(--spacing-20) var(--spacing-48); }
  }
</style>
