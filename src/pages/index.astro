---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import CaseStudyPanel from "../components/CaseStudyPanel.astro";
import GridItem from "../components/GridItem.astro";

const studies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);

const archive = [
  "Poster series", "Type study", "Icon set", "Wordmark exploration",
  "Landing page", "Mobile app concept", "Editorial layout", "Motion study",
  "Packaging", "Data viz",
];
---
<Layout title="Neel Sarode — Work" activePath="/">
  <p class="eyebrow page-eyebrow">Selected Work — 2026</p>

  <section class="case-studies">
    {studies.map((s, i) => (
      <CaseStudyPanel
        index={i + 1}
        title={s.data.title}
        category={s.data.category}
        year={s.data.year}
        tagline={s.data.tagline}
        href={`/work/${s.slug}`}
      />
    ))}
  </section>

  <p class="eyebrow section-eyebrow">More work</p>

  <section class="grid">
    {archive.map((label) => <GridItem label={label} />)}
  </section>
</Layout>

<style>
  .page-eyebrow { max-width: var(--max-w); }
  .case-studies {
    max-width: var(--max-w);
    margin-top: var(--spacing-32);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
  }
  .section-eyebrow {
    max-width: var(--max-w);
    margin-top: var(--spacing-120);
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--hairline);
  }
  .grid {
    max-width: var(--max-w);
    margin-top: var(--spacing-24);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-24);
  }
  @media (max-width: 767px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .section-eyebrow { margin-top: var(--spacing-64); }
  }
</style>
