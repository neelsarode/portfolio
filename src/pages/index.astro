---
import FullscreenLayout from "../layouts/FullscreenLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import DevGrid from "../components/DevGrid.astro";
import AsciifyDevPanel from "../components/AsciifyDevPanel.astro";
import IntroBgDevPanel from "../components/IntroBgDevPanel.astro";
import MobileVideoSwap from "../components/MobileVideoSwap.astro";
import GridLines from "../components/GridLines.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ContactSection from "../components/ContactSection.astro";
// Homepage — the full-screen (no-sidebar) site. Two Unicorn Studio scenes:
//   1. HERO — the original embed, full-screen and OPAQUE, so it covers the
//      fixed scene while at the top; scrolls away to reveal it.
//   2. BG   — pinned as a FIXED, full-viewport background, revealed on scroll.
// The hero keeps its original edge-hug spacing (Figma). The scroll sections
// compose on the 12-column .full-composed macro grid (see CLAUDE.md).
const HERO_PROJECT = "J3nKIyvrA2pTD0nflb6G"; // hero embed (video texture)
const BG_PROJECT = "BUheAkQsKZMgqGU2BVrJ";   // fixed background — managed at
// runtime by the scene-manager script below (default OFF; dev "BG" chip
// toggles it). Flip DEFAULT_ON in that script when the decision is final.

// Featured Work rows (Figma 2167:11568): TL;DR, Gold Dollar (USDKG), and
// Crow Industries. `note` is the company blurb riding the connector's spark.
const fwRows = [
  {
    flip: false,
    logo: "tldr",
    name: "TL;DR",
    href: "/work/tldr",
    video: "/tldr-dashboard.mp4",
    poster: "/tldr-dashboard-poster.jpg",
    videoMobile: "/tldr-dashboard-mobile.mp4",
    posterMobile: "/tldr-dashboard-poster-mobile.jpg",
    desc: "Co-founder and founding designer. Created brand, product design, and user experience from scratch.",
    note: "TL;DR is a first-of-its-kind clipping software that generates clips of a livestream during the livestream, not after.",
    label: "Founding Design Engineer",
    roles: [
      "Brand Identity Design",
      "Product UI/UX",
      "Website Design",
