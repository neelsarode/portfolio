    logo: "gold",
    name: "Gold Dollar",
    href: "/work/usdkg",
    video: "/gold-dollar-cover.mp4",
    poster: "/gold-dollar-poster.jpg",
    videoMobile: "/gold-dollar-cover-mobile.mp4",
    posterMobile: "/gold-dollar-poster-mobile.jpg",
    desc: "Founding designer and creative lead at USDKG (Gold Dollar). Brand created from scratch.",
    note: "USDKG is a enterprise solution for stablecoin payments with liquidity backed by the gold-reserves of the Ministry of Finance of Kyrgyzstan.",
    label: "Founding Designer",
    roles: [
      "Brand Identity Design",
      "Website Design",
      "Website Development",
      "Document Design",
      "Deck Design",
    ],
  },
  {
    flip: false,
    logo: "crow",
    name: "Crow Industries",
    href: "/work/crow-industries",
    video: "/crow-cover.mp4",
    poster: "/crow-poster.jpg",
    videoMobile: "/crow-cover-mobile.mp4",
    posterMobile: "/crow-poster-mobile.jpg",
    desc: "Early stage designer. Revamped brand and designed and developed new website. Created system for generating AI imagery and video of product.",
    note: "Crow Industries creates unmanned ground vehicles with applications in defense, mining, and space.",
    label: "Head of Design",
    roles: [
      "Website Design",
      "Website Development",
      "AI-Generated Imagery",
      "AI-Generated Video",
      "Document Design",
      "Deck Design",
    ],
  },
  {
    flip: true,
    logo: "solarshare",
    name: "SolarShare",
    href: "/work/solarshare",
    video: "/solarshare-cover.mp4",
    poster: "/solarshare-poster.jpg",
    videoMobile: "/solarshare-cover-mobile.mp4",
    posterMobile: "/solarshare-poster-mobile.jpg",
    desc: "Designed product and revamped brand for SolarShare",
    note: "Solarshare is a SAAS that gives users fractional ownership in solar energy projects through blockchain-powered returns.",
    label: "Lead Designer",
    roles: [
      "Brand Identity Design",
      "Product Design",
      "Website Design",
      "Website Development",
      "Document Design",
    ],
  },
];

// Work Dump grid (Figma 2186:11689). Media is optional per tile: `video`
// gets lazy viewport-gated playback (preload=none + IntersectionObserver);
// `image` is a plain lazy img; neither = flat placeholder. Loops are 1080²
// VP9 webm at 60fps, muted, named dump-<project>-loop.webm with a matching
// -poster.jpg (Braces by Britt is 720² — that's all its master had).
const dumpItems = [
  {
    title: "Nickel Garden",
    tags: ["Brand Identity", "Website Design", "Product Design"],
    category: "Mobile App",
    video: "/dump-nickelgarden-loop.webm",
    poster: "/dump-nickelgarden-poster.jpg",
  },
  {
    title: "Luke Infinger Personal Brand",
    tags: ["Brand Identity", "Website Design"],
    category: "Personal Brand",
    video: "/dump-lukeinfinger-loop.webm",
    poster: "/dump-lukeinfinger-poster.jpg",
  },
  {
    title: "Braces by Britt",
    tags: ["Website Design", "Website Development"],
    category: "Personal Brand",
    video: "/dump-bracesbybritt-loop.webm",
    poster: "/dump-bracesbybritt-poster.jpg",
  },
  {
    title: "Perfect",
    tags: ["Brand Identity", "Website Design & Development"],
    category: "Personal Brand",
    video: "/dump-perfectcheckout-loop.webm",
    poster: "/dump-perfectcheckout-poster.jpg",
  },
  {
    title: "Infinite Dodos",
    tags: ["Brand Identity", "Website Design & Development"],
    category: "Personal Brand",
    video: "/dump-infinitedodos-loop.webm",
    poster: "/dump-infinitedodos-poster.jpg",
  },
  {
    title: "Winter",
    tags: ["Website Design", "Website Development"],
    category: "Personal Brand",
    video: "/dump-winter-loop.webm",
    poster: "/dump-winter-poster.jpg",
  },
  {
    title: "Aavid Wallet",
    tags: ["Brand Identity", "Exploration", "Website Design"],
    category: "Personal Brand",
    video: "/dump-aavidwallet-loop.webm",
    poster: "/dump-aavidwallet-poster.jpg",
  },
  {
    title: "FlareLink",
    tags: ["Brand Identity", "Website Design", "Product Design"],
    category: "Personal Brand",
    video: "/dump-flarelink-loop.webm",
    poster: "/dump-flarelink-poster.jpg",
  },
  {
    title: "FunnelPortals",
    tags: ["Personal", "Website", "No-Code Development"],
    category: "Personal Brand",
    video: "/dump-funnelportals-loop.webm",
    poster: "/dump-funnelportals-poster.jpg",
  },
  {
    title: "Reed's Island",
    tags: ["Website Design", "Website Development"],
    category: "Personal Brand",
    video: "/dump-reedsisland-loop.webm",
    poster: "/dump-reedsisland-poster.jpg",
  },
  {
    title: "Inova",
    tags: ["Website Design", "Website Development"],
    category: "Personal Brand",
    video: "/dump-inova-loop.webm",
    poster: "/dump-inova-poster.jpg",
  },
  {
    title: "Project Kepler",
    tags: ["Website Design", "Website Development"],
    category: "Personal Brand",
    video: "/dump-projectkepler-loop.webm",
    poster: "/dump-projectkepler-poster.jpg",
  },
];

---
<FullscreenLayout title="Neel Sarode — Founding Design Engineer">
  <!-- Arm the hero entrance before first paint: html.js gates the CSS that
       hides hero risers (see the is:global style block), so there's no flash
       of text before GSAP takes over. Failsafe: if the GSAP bundle never
       loads, the class is stripped at 4s and the text simply appears. -->
  <script is:inline>
    document.documentElement.classList.add("js");
    window.__heroFailsafe = setTimeout(function () {
      document.documentElement.classList.remove("js");
    }, 4000);
  </script>

  <!-- Fixed background scene container. NO data-us-project on purpose — the
       auto-init never grabs it; the scene-manager script below creates and
       destroys the scene here at runtime (dev "BG" chip / DEFAULT_ON). -->
  <div class="us-scene us-fixed" id="us-fixed-bg" aria-hidden="true"></div>

  <!-- Structural grid lines: above the scene, below content (opaque hero
       covers them; they emerge on scroll into the sections). -->
  <GridLines />

  <main class="content">
    <!-- Hero: original embed, opaque; scrolls away to reveal the fixed scene.
         Nav + title/desc are placed on the 12-col macro grid. -->
    {/* data-cursor-scroll: the axis cursor shows its "Scroll ↓" hint while the
        pointer is anywhere over the hero — but only once the entrance has
        finished (see the hero timeline's onComplete below). */}
    <section class="hero" data-cursor-scroll>
      <div
        class="us-scene us-hero"
        data-us-project={HERO_PROJECT}
        data-us-scale="1"
        data-us-dpi="1"
        data-us-fps="30"
      ></div>

      <div class="hero-overlay">
        <div class="mask"><SiteNav activePath="/" /></div>

        <div class="hero-bottom">
          <h1 class="hero-title">
            <span class="mask"><span class="line">Founding</span></span>
            <span class="mask"><span class="line">Design Engineer</span></span>
          </h1>
          <div class="mask mask-desc">
            <p class="hero-desc">
              Specializing in taking companies from 0→ 1 with ownership of all
              things visual.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro (Figma 2155:11374): bracket-framed statement + services list,
         composed on the 12-col macro grid over the fixed scene. -->
    <section class="section intro-band">
      <!-- Section background media (Figma "image 8": bleeds off the left
           edge). VP9 webm re-encoded from the 57MB original (CRF 38 / 30fps
           → 2.8MB); the old still serves as the poster frame. -->
      <div class="intro-bg" aria-hidden="true">
        <!-- Two sources: Safari (iOS/macOS) plays VP9 webm but DROPS its
             alpha channel (black box), so it gets HEVC-with-alpha first.
             The bare `hvc1` codec string is deliberate: Chrome answers
             canPlayType("") for it (it only claims fully-qualified HEVC
             strings), so Chrome skips to the transparent webm, while
             Safari accepts and takes the mov. -->
        <video
          poster="/intro-reel.png"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          tabindex="-1"
        >
          <source src="/intro-reel.mov" type='video/mp4; codecs="hvc1"' />
          <source src="/intro-reel.webm" type="video/webm" />
        </video>
      </div>
      <div class="content-grid">
        <div class="full-composed">
          <div class="intro-frame" data-reveal-group>
            <svg class="corner corner-tl" viewBox="0 0 29.25 29.75" fill="none" aria-hidden="true">
              <path d="M0.25 29.75L0.25 0.25L29.25 0.25" stroke="currentColor" stroke-width="0.5" />
            </svg>
            <span class="mask"><p class="intro-name">
              <svg class="intro-logomark" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill="currentColor" d="M5.76562 17.6538C5.76562 17.845 5.61065 18 5.41947 18H0.346154C0.154978 18 0 17.845 0 17.6538V12.4467C0 12.2556 0.154978 12.1006 0.346154 12.1006H5.41947C5.61065 12.1006 5.76562 12.2556 5.76562 12.4467V17.6538ZM7.62312 0.0056229C7.64182 0.0132722 7.65667 0.0280943 7.66436 0.046776L9.76617 5.15295C9.85995 5.38077 9.69244 5.63086 9.44607 5.63086H8.46263C8.08345 5.63086 7.98021 6.15272 8.33083 6.29709L10.4926 7.18728C10.578 7.22242 10.6457 7.29019 10.6809 7.37554L11.5701 9.53465C11.7145 9.88525 12.2363 9.782 12.2363 9.40284V8.42126C12.2363 8.17486 12.4865 8.00735 12.7143 8.1012L17.7145 10.161C17.7997 10.1961 17.8674 10.2637 17.9026 10.349L17.9738 10.5215C17.9911 10.5634 18 10.6083 18 10.6536V17.6538C18 17.845 17.845 18 17.6538 18H11.1143C11.0691 18 11.0244 17.9912 10.9826 17.974L10.484 17.7688C10.3986 17.7336 10.3308 17.6658 10.2957 17.5805L8.23588 12.5785C8.14206 12.3507 8.30957 12.1006 8.55596 12.1006H9.53835C9.91752 12.1006 10.0208 11.5787 9.67015 11.4344L7.50839 10.5442C7.42302 10.509 7.35523 10.4412 7.32009 10.3559L6.43188 8.19784C6.28755 7.84717 5.76562 7.95038 5.76562 8.32959V9.30932C5.76562 9.5557 5.51552 9.7232 5.28769 9.62941L0.286826 7.57059C0.201389 7.53541 0.133559 7.46754 0.0984367 7.38209L0.0259862 7.20581C0.00882777 7.16406 0 7.11936 0 7.07422V0.346154C0 0.154978 0.154978 0 0.346154 0H7.59452C7.60433 0 7.61404 0.00190985 7.62312 0.0056229ZM18 5.28471C18 5.47588 17.845 5.63086 17.6538 5.63086H12.5825C12.3913 5.63086 12.2363 5.47588 12.2363 5.28471V0.346154C12.2363 0.154978 12.3913 0 12.5825 0H17.6538C17.845 0 18 0.154978 18 0.346154V5.28471Z" />
              </svg>
              <span class="dim">My name is</span> Neel Sarode
            </p></span>
            <p class="intro-statement">
              <span class="mask"><span class="line">I join early stage</span></span>
              <span class="mask"><span class="line">companies and design &amp;</span></span>
              <span class="mask"><span class="line">build <span class="u">everything</span> users see.</span></span>
            </p>
            <svg class="corner corner-br" viewBox="0 0 29.25 29.75" fill="none" aria-hidden="true">
              <path d="M0.25 29.75L0.25 0.25L29.25 0.25" stroke="currentColor" stroke-width="0.5" />
            </svg>
          </div>
          <div class="intro-services" data-reveal-group>
            <div class="intro-col-block">
              <span class="mask"><p class="intro-blurb">
                8 years of experience designing for brands from scratch,
                specializing in taking a company with <span class="hl">0</span>
                to visually competing with others that are
                <span class="hl">10x their size.</span>
              </p></span>
              {/* About Me link removed for now (2026-09-04, Neel) — restore
                  by un-commenting. */}
              {/* <span class="mask"><a class="intro-about" href="/info">About Me →</a></span> */}
            </div>
            <div class="rail-rule" aria-hidden="true">
              <div class="hseg h-r1"></div><div class="hseg h-r2 hseg-end"></div>
            </div>
            <div class="intro-col-block intro-skills">
              <span class="mask"><p class="skills-label">Skills:</p></span>
              <div class="skills-list">
                <span class="mask"><p>Product UI/UX</p></span>
                <span class="mask"><p>Product Front-End Code</p></span>
                <span class="mask"><p>Website Design</p></span>
                <span class="mask"><p>Website Development</p></span>
                <span class="mask"><p>Brand Identity Design</p></span>
                <span class="mask"><p class="intro-extras">Extras: Documents, print, creative direction</p></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Work (Figma 2167:11568): section title + mirrored case-study
         rows — media on the macro grid (10 cols) with a TL;DR meta rail
         (2 cols) beside it; the rail's connector line stretches so the rail
         always matches the media height. -->
    <section class="section fw-band">
      <div class="section-rule section-rule-top" aria-hidden="true">
        <div class="hseg h-a"></div><div class="hseg h-b"></div><div class="hseg h-c"></div><div class="hseg h-d hseg-end"></div>
      </div>
      <div class="section-rule section-rule-bottom" aria-hidden="true">
        <div class="hseg h-a"></div><div class="hseg h-b"></div><div class="hseg h-c"></div><div class="hseg h-d hseg-end"></div>
      </div>
      <div class="content-grid">
        <div class="full-composed">
          <div class="fw-stack">
            <h2 class="fw-title" data-reveal-group>
              <span class="mask"><span class="line">Featured</span></span>
              <span class="mask"><span class="line">Work</span></span>
            </h2>

            <div class="fw-rows">
              {fwRows.map((row) => {
                const RowTag = row.href ? "a" : "div";
                return (
                <RowTag href={row.href} class:list={["fw-row", { "fw-flip": row.flip }]} data-reveal-group data-cursor-label={`${row.name} Case Study →`}>
                  <div class="fw-media" data-fade>
                    {row.video && (
                      <video
                        class="fw-video"
                        src={row.video}
                        poster={row.poster}
                        data-desktop-src={row.video}
                        data-desktop-poster={row.poster}
                        data-mobile-src={row.videoMobile}
                        data-mobile-poster={row.posterMobile}
                        muted
                        loop
                        playsinline
                        preload="none"
                        tabindex="-1"
                      ></video>
                    )}
                  </div>
                  <aside class="fw-meta">
                    <span class="mask">
                      {row.logo === "tldr" ? (
                        <svg class="fw-logo" viewBox="0 0 63 17.17" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="TL;DR">
                          <path fill="currentColor" d="M0 0H13.1962V3.55661H8.46228V17.1698H4.7585V3.55661H0V0Z" />
                          <path transform="translate(14.64 0)" fill="currentColor" d="M3.70378 13.6132H0V0H3.70378V13.6132ZM11.0623 17.1698H3.70378V13.6132H11.0623V17.1698Z" />
                          <g fill="#c197ff">
                            <rect x="27.81" y="2.47" width="3.734" height="3.734" />
                            <rect x="27.81" y="9.71" width="3.734" height="3.734" />
                            <rect x="29.68" y="13.44" width="1.867" height="3.734" />
                          </g>
                          <path transform="translate(34.81 0)" fill="currentColor" d="M0 17.1698V0H8.95284V3.55661H12.5095V17.1698H0ZM8.80567 3.55661H3.70378V13.6132H8.80567V3.55661Z" />
                          <path transform="translate(50.05 0)" fill="currentColor" d="M3.70378 8.90378H9.24718V12.4849H3.70378V17.1698H0V0H9.24718V3.55661H3.70378V8.90378ZM12.951 8.90378H9.24718V3.55661H12.951V8.90378ZM12.951 17.1698H9.24718V12.4849H12.951V17.1698Z" />
                        </svg>
                      ) : row.logo === "gold" ? (
                        <span class="fw-gold">
                          <svg viewBox="0 0 20.8679 20.8679" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <circle cx="10.434" cy="10.434" r="9.78762" fill="#D5A042" stroke="#D5A042" stroke-width="1.2927" />
                            <path fill="white" d="M12.9056 12.347L14.3209 11.4121V16.1645H13.1003L12.9056 12.347ZM10.3735 11.4121H14.3209L14.1261 12.7366H10.3735V11.4121ZM6.64691 11.8147C6.64691 11.1481 6.74213 10.5465 6.93258 10.0098C7.12302 9.46441 7.39137 8.99696 7.73763 8.60742C8.08389 8.21788 8.49508 7.91923 8.97118 7.71147C9.45595 7.49506 9.99265 7.38685 10.5813 7.38685C11.2825 7.38685 11.9014 7.51237 12.4381 7.76341C12.9835 8.00579 13.4206 8.35638 13.7496 8.81517C14.0785 9.27397 14.269 9.81933 14.3209 10.4513H12.6848C12.6415 9.95783 12.4381 9.56829 12.0745 9.28263C11.7196 8.9883 11.2392 8.84114 10.6332 8.84114C10.1398 8.84114 9.71564 8.95801 9.36073 9.19173C9.00581 9.42546 8.73746 9.76306 8.55567 10.2045C8.37388 10.646 8.28299 11.1827 8.28299 11.8147C8.28299 12.7669 8.47776 13.5027 8.86731 14.0221C9.2655 14.5414 9.81952 14.8011 10.5294 14.8011C10.9535 14.8011 11.3214 14.7059 11.6331 14.5155C11.9447 14.3164 12.1827 14.0394 12.3472 13.6845C12.5203 13.3295 12.6069 12.9184 12.6069 12.4509H13.6197C13.6197 13.1867 13.4812 13.8446 13.2042 14.4246C12.9272 14.9959 12.5463 15.4461 12.0616 15.775C11.5768 16.1039 11.0184 16.2684 10.3865 16.2684C9.64206 16.2684 8.9885 16.0823 8.42582 15.7101C7.86315 15.3378 7.426 14.8185 7.11436 14.1519C6.80273 13.4854 6.64691 12.7063 6.64691 11.8147Z" />
                            <path fill="white" d="M10.1426 7.69005L10.1622 7.65782L8.25982 9.85997V12.1568H6.64947V4.6168H8.25982V7.66075L10.7637 4.6168H12.7481L10.1426 7.69005Z" />
                          </svg>
                          Gold Dollar
                        </span>
                      ) : row.logo === "crow" ? (
                        <img
                          class="fw-crow"
                          src="/crow-logo.svg"
                          alt="Crow Industries"
                          width="74"
                          height="33"
                          loading="lazy"
                        />
                      ) : (
                        <img
                          class="fw-solarshare"
                          src="/solarshare-logo.svg"
                          alt="SolarShare"
                          width="91"
                          height="14"
                          loading="lazy"
                        />
                      )}
                    </span>
                    <span class="mask"><p class="fw-desc">{row.desc}</p></span>

                    <div class="fw-line fw-line-a" aria-hidden="true"></div>
                    <!-- Company blurb riding the connector at the spark -->
                    <div class="fw-note">
                      <svg class="fw-note-spark" viewBox="0 0 13.125 13.125" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M6.5625 0C6.26992 6.0293 6.0293 6.26992 0 6.5625C6.0293 6.85508 6.26992 7.0957 6.5625 13.125C6.85508 7.0957 7.0957 6.85508 13.125 6.5625C7.0957 6.26992 6.85508 6.0293 6.5625 0Z" fill="url(#fw-spark-grad)" />
                        <defs>
                          <radialGradient id="fw-spark-grad" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(6.5625 6.5625) rotate(90) scale(6.5625)">
                            <stop stop-color="white" />
                            <stop offset="1" stop-color="#999999" />
                          </radialGradient>
                        </defs>
                      </svg>
                      <span class="mask"><p>{row.note}</p></span>
                    </div>
                    <div class="fw-line fw-line-b" aria-hidden="true"></div>

                    <div class="fw-roles">
                      <span class="mask"><p class="fw-label">{row.label}</p></span>
                      <div class="fw-roles-list">
                        {row.roles.map((r) => (
                          <span class="mask"><p>{r}</p></span>
                        ))}
                      </div>
                    </div>
                  </aside>
                </RowTag>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- More Work (Figma 2186:11689): header + 3-up grid of project tiles.
         Video tiles are lazy (preload=none) and viewport-gated — they only
         play while on screen, so the grid can hold 15-20 loops without
         touching initial page load or piling up hot decoders. -->
    <section class="section wd-band">
      <div class="content-grid">
        <div class="full-composed">
          <div class="wd-stack">
            <div class="wd-head" data-reveal-group>
              <h2 class="fw-title">
