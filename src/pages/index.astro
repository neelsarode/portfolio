<!-- Unicorn Studio — self-loading vanilla snippet (SDK v2.2.8, loads on demand,
     idempotent). init() picks up every [data-us-project] on the page. -->
<script is:inline>
  !(function () {
    // Publishes the moment the hero scene actually starts, so the hero text
    // can be timed from the scene's own intro rather than from navigation.
    // The gap between the two is the CDN fetch plus init, which varies with
    // connection — anchoring to navigation drifted against the scene.
    function mark() {
      if (window.__usHeroStart != null) return;
      window.__usHeroStart = performance.now();
      window.dispatchEvent(new Event("us:hero-start"));
    }
    // init() resolves once the scenes are built and rendering. Older builds
    // return nothing, so treat a non-thenable as "started now". A throw or a
    // rejection still marks: better an early hero than a hero that never
    // arrives because the scene failed.
    function start(ctx) {
      var r;
      try { r = ctx.init(); } catch (e) { mark(); return; }
      if (r && typeof r.then === "function") r.then(mark, mark);
      else mark();
    }
    function whenReady(ctx) {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function () { start(ctx); });
      } else { start(ctx); }
    }

    var u = window.UnicornStudio;
    if (u && u.init) {
      whenReady(u);
    } else {
      window.UnicornStudio = { isInitialized: !1 };
      var i = document.createElement("script");
      i.src = "https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.2.8/dist/unicornStudio.umd.js";
      i.onload = function () { whenReady(window.UnicornStudio); };
      // Blocked or offline CDN: mark immediately rather than leaving the text
      // waiting on a scene that is never coming.
      i.onerror = mark;
      (document.head || document.body).appendChild(i);
    }
  })();
</script>

<!-- Fixed-background scene manager: creates/destroys the secondary Unicorn
     scene at runtime so it can be A/B'd for real (destroy frees the WebGL
     context — not just hidden). Default OFF; the dev BG chip (DevGrid.astro)
     flips it and persists to localStorage. When the decision is final, set
     DEFAULT_ON accordingly (or fold the scene back into the auto-init). -->
<script is:inline define:vars={{ BG_PROJECT }}>
  (function () {
    var DEFAULT_ON = false;
    var scene = null;
    var pending = false;
    var want = DEFAULT_ON;
    try {
      var saved = localStorage.getItem("dev-fixed-bg");
      if (saved !== null) want = saved === "1";
    } catch (e) {}

    function apply() {
      if (want && !scene && !pending && window.UnicornStudio && window.UnicornStudio.addScene) {
        pending = true;
        window.UnicornStudio.addScene({
          elementId: "us-fixed-bg",
          projectId: BG_PROJECT,
          scale: 1,
          dpi: 1,
          fps: 30,
        }).then(function (s) {
          pending = false;
          scene = s;
          if (!want) { s.destroy(); scene = null; } // toggled off mid-flight
        }).catch(function () { pending = false; });
      } else if (!want && scene) {
        scene.destroy();
        scene = null;
      }
    }

    // The SDK loads async — wait for it, then apply the initial state.
    var poll = setInterval(function () {
      if (window.UnicornStudio && window.UnicornStudio.addScene) {
        clearInterval(poll);
        apply();
      }
    }, 250);

    window.__fixedBg = {
      isOn: function () { return want; },
      set: function (on) {
        want = !!on;
        try { localStorage.setItem("dev-fixed-bg", want ? "1" : "0"); } catch (e) {}
        apply();
      },
    };
  })();
</script>

<!-- GSAP + ScrollTrigger — masked line reveals (sananes.co pattern): each
     text element sits inside an overflow-clip .mask wrapper and rises from
     yPercent 110 → 0 with a stagger. Bracket corners fade in alongside.
     gsap.from() only sets the hidden from-state when this runs, so if the
     bundle fails to load the text just renders normally. -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.registerPlugin(ScrollTrigger);

    // GSAP owns the hero from here — cancel the no-JS failsafe.
    clearTimeout((window as any).__heroFailsafe);

    // Keep ScrollTrigger in lockstep with Lenis (created in FullscreenLayout;
    // module order isn't guaranteed, so fall back to the init event).
    // Also: scroll-velocity-reactive intro reel — the ring spins faster while
    // you scroll (playbackRate driven by Lenis velocity), easing back to 1x
    // at rest. Cheap: one property set + a lerp per tick; extra decode only
    // happens in transient bursts during active scrolling.
    const REEL_MAX_RATE = 4;    // top speed multiplier
    const REEL_VELOCITY_GAIN = 0.18; // |lenis velocity| → rate boost
    const reel = document.querySelector<HTMLVideoElement>(".intro-bg video");
    let reelTarget = 1;
    const wireLenis = () => {
      const lenis = (window as any).lenis;
      if (!lenis) return;
      lenis.on("scroll", (e: any) => {
        ScrollTrigger.update();
        if (reel) {
          const boost = Math.min(REEL_MAX_RATE - 1, Math.abs(e.velocity || 0) * REEL_VELOCITY_GAIN);
          reelTarget = Math.max(reelTarget, 1 + boost);
        }
      });
    };
    (window as any).lenis
      ? wireLenis()
      : addEventListener("lenis:init", wireLenis, { once: true });

    if (reel) {
      gsap.ticker.add(() => {
        // snappy spin-up toward the target; slower decay back to 1x so the
        // boost lingers long enough to register
        reel.playbackRate += (reelTarget - reel.playbackRate) * 0.2;
        reelTarget += (1 - reelTarget) * 0.025;
      });
    }

    // Hero entrance at the 5.5s mark — anchored to navigation start (not
    // script-load time) so it syncs with the Unicorn scene's authored intro.
    // fromTo (not from): the CSS gate holds risers at translateY(110%), which
    // computes to a px matrix — from{} restates it as y:0/yPercent:110 so the
    // tween ends at a true 0. immediateRender hands off from CSS seamlessly.
    const heroRisers = document.querySelectorAll(".hero-overlay .mask > *");
    if (heroRisers.length) {
      const HERO_AT = 5.5; // seconds into the Unicorn scene's intro
      // Latest we will wait for the scene to report in. It normally starts
      // within a couple of seconds; this only fires if the scene is broken in
      // a way that never resolves and never errors, and it stops the copy
      // being held hostage to that.
      const GIVE_UP_AT = 9000;

      const runHero = (sceneStartMs: number) => {
        const elapsed = (performance.now() - sceneStartMs) / 1000;
        gsap.timeline({
          delay: Math.max(0, HERO_AT - elapsed),
          // The axis cursor holds its "Scroll" hint back until the entrance
          // has fully played, so the hint never competes with the headline
          // still rising. Flag + event: the flag covers a cursor script that
          // checks later, the event wakes one already waiting.
          onComplete: () => {
            (window as any).__heroIntroDone = true;
            dispatchEvent(new Event("hero:intro-done"));
          },
        })
          .fromTo(
            heroRisers,
            { y: 0, yPercent: 110 },
            {
              yPercent: 0,
              duration: 0.9,
              ease: "power4.out",
              stagger: 0.09,
              immediateRender: true,
            }
          );
      };

      const started = (window as any).__usHeroStart;
      if (started != null) {
        runHero(started);
      } else {
        let fired = false;
        const once = (from: number) => {
          if (fired) return;
          fired = true;
          clearTimeout(timer);
          runHero(from);
        };
        const timer = window.setTimeout(() => once(performance.now()), GIVE_UP_AT);
        window.addEventListener(
          "us:hero-start",
          () => once((window as any).__usHeroStart ?? performance.now()),
          { once: true }
        );
      }
    }

    // Viewport-gated playback for every preview loop — Featured Work covers
    // AND More Work tiles. preload="none" means a video costs zero bytes until
    // it approaches the viewport; play only while on screen, pause when
    // scrolled away. Without this the covers alone (5-7MB each, autoplaying
    // from page load regardless of position) put ~8MB on first paint, and
    // 15-20 tiles would stack up hot decoders.
    // .exp-video included so the Experience panels behave like every other
    // loop on the page. They sit inside a horizontally translated track, which
    // IntersectionObserver handles fine — it works off the visual box, so a
    // panel counts as on screen only once the track has actually carried it
    // there.
    const gatedVideos = document.querySelectorAll<HTMLVideoElement>(
      ".fw-video, .wd-video, .exp-video",
    );
    if (gatedVideos.length) {
      const nearViewport = (v: HTMLVideoElement) => {
        const r = v.getBoundingClientRect();
        return r.bottom > -160 && r.top < window.innerHeight + 160;
      };

      // play() rejects for transient reasons — the commonest being a tab
      // loaded in the BACKGROUND, where Chrome refuses playback outright, but
      // also decoder pressure or an interrupted load. This used to be
      // `.catch(() => {})`, which meant one rejection left the tile on its
      // poster permanently: the observer only fires again when the
      // intersection CHANGES, and that never happens for someone already
      // looking at it. Retry with backoff while the element is still near the
      // viewport.
      const tryPlay = (v: HTMLVideoElement, attempt = 0) => {
        if (!v.isConnected || !nearViewport(v)) return;
        v.play().catch(() => {
          if (attempt < 4) {
            setTimeout(() => tryPlay(v, attempt + 1), 300 * 2 ** attempt);
          }
        });
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) tryPlay(v);
            else v.pause();
          }
        },
        { rootMargin: "160px 0px" } // start loading/playing just before entry
      );
      gatedVideos.forEach((v) => io.observe(v));

      // Every play() during a background load is rejected, and returning to
      // the tab fires no intersection change — so nothing would ever restart.
      // Re-attempt whatever is on screen and paused when the tab is revealed.
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState !== "visible") return;
        gatedVideos.forEach((v) => {
          if (v.paused && nearViewport(v)) tryPlay(v);
        });
      });
    }

    // :not(.exp-band) — the Experience timeline reveals its entries from their
    // own HORIZONTAL triggers (containerAnimation). Left unscoped, this would
    // catch them on vertical position and fire every entry at once as the
    // section enters. Defensive: its entries carry no data-reveal-group today.
    gsap.utils.toArray<HTMLElement>(".section:not(.exp-band) [data-reveal-group]").forEach((group) => {
      const risers = group.querySelectorAll(".mask > *");
      const corners = group.querySelectorAll(".corner");
      const tl = gsap.timeline({
        scrollTrigger: { trigger: group, start: "top 82%", once: true },
      });
      tl.from(risers.length ? risers : [...group.children], {
        yPercent: 110,
        duration: 0.9,
        ease: "power4.out",
        stagger: 0.09,
      });
      if (corners.length) {
        tl.from(corners, { opacity: 0, duration: 0.7, ease: "power2.out" }, 0.15);
      }
      const fades = group.querySelectorAll("[data-fade]");
      if (fades.length) {
        tl.from(fades, { opacity: 0, duration: 0.9, ease: "power2.out" }, 0.1);
      }
    });
  } else {
    // Reduced motion: background/preview loops stay on their poster frame.
    document.querySelectorAll<HTMLVideoElement>(".fw-video, .intro-bg video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
      v.currentTime = 0;
    });
  }
</script>

<style is:global>
  /* Pre-paint gate for the HERO entrance only (sections handle their own
     from-state via gsap.from). Global because .mask children include the
     SiteNav component root, which page-scoped selectors can't reach. Gated
     on html.js (set by the inline arm script) and reduced-motion so no-JS /
     reduced-motion visitors always see the text. GSAP's inline transforms
     take over from this the moment the module runs. */
  @media (prefers-reduced-motion: no-preference) {
    html.js .hero-overlay .mask > * {
      transform: translateY(110%);
    }
  }
</style>

<style>
  /* Fixed, full-viewport background — pinned behind everything (z-index 0). */
  .us-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh; /* fits the visible area on mobile browser chrome */
    background: #0a0a0b; /* fallback while the scene loads */
  }

  /* Content stack sits above the fixed scene. */
  .content { position: relative; z-index: 1; }

  /* Hero: full-screen original embed. Solid background makes it OPAQUE so it
     covers the fixed scene while at the top, then scrolls away to reveal it. */
  .hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #0a0a0b;
  }
  .us-hero { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* ---- Hero text overlay (from Figma node 2138:11513) — original edge-hug ---- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 1.2vw, 20px);
    color: #fff;
    font-family: var(--font-geist-sans);
    font-weight: 400;
  }

  /* Title (left) + descriptor (right), pinned to the bottom edge */
  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
  }
  .hero-title {
    flex: 0 0 auto;
    margin: 0;
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em; /* -2.08px @ 52px */
    font-weight: 400;
    color: #fff;
  }
  /* Layout lives on the mask (the flex item); typography on the text. */
  .mask-desc {
    flex: 0 1 auto;
    max-width: 293px;
  }
  .hero-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.01em; /* -0.16px @ 16px */
    color: #fff;
  }

  /* Stack title over descriptor on narrow screens. */
  @media (max-width: 640px) {
    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .mask-desc { max-width: 42ch; }
  }

  /* Sections: vertically centered; text placed on the macro grid. */
  .section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ---- Intro section (Figma 2155:11374) ---- */
  /* Band model (per Figma): a compact section whose vertical space is real
     --space-* padding, not a full-viewport centered block. No overflow
     clipping — the background media may bleed past the band's bottom edge
     (the off-left horizontal bleed is contained by the body's overflow-x). */
  .section.intro-band {
    position: relative;
    /* Size the band to the video's VISIBLE CONTENT, not its box: alpha-scan
       of every frame shows carousel pixels never extend below row 885/1080
       (81.9%) — the box's bottom 18% is always transparent. So the band ends
       where content ends: 75vw × (0.819 − 0.18 lift) = 48vw. The next
       section's --space-8 padding is then the exact card→title gap at any
       viewport width; the box's transparent remainder bleeds harmlessly. */
    min-height: 48vw;
    justify-content: flex-start; /* keep content top-anchored (video is top-anchored) */
    padding-block: var(--space-8);
  }

  /* Background media layer (image now, webm video later — the <img>/<video>
     swaps 1:1 inside .intro-bg). Figma: 1440-wide media at x -320 in a
     1440 frame → full section width, offset -22% so it bleeds off-left.
     Renders at natural aspect, anchored to the band top — never cropped;
     if taller than the band it bleeds below rather than being cut off. */
  .intro-bg {
    position: absolute;
    top: 0;
    left: -22%;
    width: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .intro-bg img,
  .intro-bg video {
    width: 100%;
    height: auto;
    /* Lift the carousel so its back row sits behind the statement text
       (Figma comp). The lifted-out top portion is clipped — it must not
       paint over the hero above — while the bottom bleed stays uncut.
       The two values must match; tune the lift with this one number. */
    --bg-lift: 18%;
    transform: translateY(calc(-1 * var(--bg-lift)));
    clip-path: inset(var(--bg-lift) 0 0 0);
  }
  .intro-band > .content-grid { position: relative; z-index: 1; }

  /* Bracket-framed statement: corners pin to the frame's TL/BR; text insets
     via --space padding (Figma's 107/64/90 offsets snapped to the scale). */
  .intro-frame {
    grid-column: 3 / 9;
    /* Don't stretch to the (taller) right column's row height — the frame
       hugs its own content so the bottom-right corner stays anchored just
       below the statement text, not the bottom of the whole row. */
    align-self: start;
    position: relative;
    padding: var(--space-6) var(--space-7);
    color: #fff;
  }
  .corner {
    position: absolute;
    width: 29px;
    height: 30px;
    color: #fff;
  }
  .corner-tl { top: 0; left: 0; }
  .corner-br {
    bottom: 0;
    /* One column + gutter in from the frame's right edge: the frame spans 6
       columns (3/9), so this keeps the closing bracket in the column it
       occupied before the frame shifted right. Grid-derived, not arbitrary. */
    right: calc((100% - 5 * var(--gutter)) / 6 + var(--gutter));
    rotate: 180deg;
  }

  .intro-name {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 18px;
    line-height: 1;
    letter-spacing: -0.04em; /* -0.72px @ 18px */
  }
  .intro-logomark { width: 18px; height: 18px; flex: 0 0 auto; }
  .intro-name .dim { color: rgba(255, 255, 255, 0.6); }

  .intro-statement {
    margin-block-start: var(--space-2);
    font-size: clamp(28px, 2.5vw, 36px);
    line-height: 1;
    letter-spacing: -0.04em; /* -1.44px @ 36px */
    text-shadow: 0 1px 20px rgba(10, 10, 11, 0.6);
  }
  .intro-statement .u {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  /* Right column (Figma 2167:11632): auto-layout column on our tokens —
     blurb+link block, then Skills block, --space-8 between them. Spans grid
     cols 9-13 (416px at 1440 ≈ the Figma's 417px container). */
  .intro-services {
    grid-column: 9 / 13;
    padding-block-start: var(--space-7); /* aligns blurb top with the statement */
    display: flex;
    flex-direction: column;
    /* Block separation now comes from .rail-rule's margins (64 + 1 + 64
       ≈ the old 128 gap), so the divider sits centered in the same space. */
    gap: 0;
    font-size: 16px;
    letter-spacing: -0.01em; /* -0.16px @ 16px */
    color: #fff;
    text-shadow: 0 1px 20px rgba(10, 10, 11, 0.6);
  }
  /* Divider between the About block and Skills block — spans the rail
     (macro cols 9-13 = 4 local tracks, same track width), notched at the
     col-9, col-11, and right-margin crossings via the shared .hseg system. */
  .rail-rule {
