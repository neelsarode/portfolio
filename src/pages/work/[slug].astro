---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const studies = await getCollection("case-studies");
  return studies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Layout title={`${entry.data.title} — Neel Sarode`} activePath="/">
  <article class="study">
    <a class="back mono-label" href="/">← Work</a>
    <div class="media machined" aria-hidden="true"></div>
    <header class="head">
      <p class="eyebrow">{entry.data.category} — {entry.data.year}</p>
      <h1 class="title">{entry.data.title}</h1>
      <p class="tagline">{entry.data.tagline}</p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .study { max-width: var(--max-w); }
  .back { color: var(--cream-60); }
  .back:hover { color: var(--ember); }
  .media {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: var(--spacing-24);
  }
  .head { margin-top: var(--spacing-32); }
  .title {
    margin-top: var(--spacing-16);
    font-size: 40px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -1px;
    color: var(--cream);
  }
  .tagline {
    margin-top: var(--spacing-16);
    font-size: 20px;
    line-height: 1.4;
    color: var(--cream-88);
    max-width: 52ch;
  }
  .body { margin-top: var(--spacing-64); }
  .body :global(h2) {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    margin-top: var(--spacing-48);
    font-family: var(--font-geist-mono);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: var(--cream-60);
  }
  .body :global(h2)::before {
    content: "";
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    background: var(--ember);
  }
  .body :global(p) {
    margin-top: var(--spacing-16);
    color: var(--cream-88);
    max-width: 65ch;
  }
  @media (max-width: 767px) {
    .title { font-size: 32px; letter-spacing: -0.5px; }
  }
</style>
