---
import { getCollection } from "astro:content";
import FullscreenLayout from "../../layouts/FullscreenLayout.astro";
import PageShell from "../../layouts/PageShell.astro";
import SiteNav from "../../components/SiteNav.astro";

export async function getStaticPaths() {
  const studies = await getCollection("case-studies");
  return studies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<FullscreenLayout title={`${entry.data.title} — Neel Sarode`}>
  <header class="page-header"><SiteNav activePath="/" /></header>
  <PageShell>
    <a class="back mono-label lede-top" href="/">← Work</a>

    <!-- Case-study image breaks out to the wide (920px) zone. -->
    <div class="media machined wide" aria-hidden="true"></div>

    <p class="eyebrow">{entry.data.category} — {entry.data.year}</p>
    <h1 class="title">{entry.data.title}</h1>
    <p class="tagline">{entry.data.tagline}</p>

    <div class="body">
      <Content />
    </div>
  </PageShell>
</FullscreenLayout>

<style>
  .page-header { padding: var(--space-3) var(--margin); }
  .lede-top { margin-block-start: var(--space-7); }

  .back { color: var(--cream-60); }
  .back:hover { color: var(--ember); }

  /* .wide places the media in the wide zone; the grid item stretches to fill,
     so no width needed — just the ratio. */
  .media { aspect-ratio: 16 / 9; }

  .title {
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.5px;
    color: var(--cream);
  }
  .tagline { font-size: 16px; line-height: 1.5; color: var(--cream-88); }

  /* Larger break before the long-form body (section-level spacing). */
  .body { margin-block-start: var(--space-6); }
  .body :global(h2) {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-block-start: var(--space-5);
    font-family: var(--font-geist-mono);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: var(--cream-60);
  }
  .body :global(h2)::before {
    content: "";
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    background: currentColor;
    -webkit-mask: var(--icon-spark) no-repeat center / contain;
    mask: var(--icon-spark) no-repeat center / contain;
  }
  .body :global(p) { margin-block-start: var(--space-2); color: var(--cream-88); }
</style>
