---
import FullscreenLayout from "../../layouts/FullscreenLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import GridLines from "../../components/GridLines.astro";
import DevGrid from "../../components/DevGrid.astro";
import MoreWork from "../../components/MoreWork.astro";
import MobileVideoSwap from "../../components/MobileVideoSwap.astro";
// LiquidAcre case study — the product-design one. Same shared case-study
// format as SolarShare / TL;DR (type recipes copied exactly, label/body rows,
// centred intros, media on the 12-col macro grid), plus a few composed
// blocks the product story needs: the trust rules, the interactive parcel
// grid, the palette, the naming table and the motion table.
//
// Screen panels: the product media are flat recordings of a LIGHT UI, so
// rather than full-bleed slabs they sit inset on the cover's own Forest plat
// backdrop (public/liquidacre-panel-bg.jpg — the Ultramock background) and
// size themselves from the media (width/height attrs), which also means they
// never crop at any width (site rule for work-page panels).

const info = [
  {
    label: "Things I Did",
    values: [
      "Product Design",
      "UX Strategy",
      "Design System",
      "Interaction & Motion Design",
      "Prototype Development",
    ],
  },
  { label: "Company", values: ["LiquidAcre"] },
  { label: "Role", values: ["Product Designer"] },
  { label: "Year", values: ["2026"] }, // TODO: confirm LiquidAcre year
  { label: "Platform", values: ["Desktop web app"] },
];

// "Where trust gets lost" — the rules the design had to keep.
const rules = [
  {
    title: "Ownership you can see",
    body: "100 shares of a 25,000-share villa is 0.4% of it. That’s hard to picture, so ownership is drawn as lots on a plat.",
  },
  {
    title: "Returns that sound like real estate",
    body: "A triple-digit return reads as a warning, not a pitch. Projected returns stay in the range a rental property can plausibly earn.",
  },
  {
    title: "No surprises where money moves",
    body: "Fees, totals and your balance appear before you commit, never after a payment fails.",
  },
];

const dashboardNotes = [
  { title: "The number people come for", body: "Portfolio value leads, with a 12-month chart beneath it drawn to scale." },
  { title: "Income in its own colour", body: "Rent is Harvest everywhere it appears: the monthly figure, the income chart and every payout." },
  { title: "Setup that asks for one thing", body: "A compact card names only the next step, so finishing setup never competes with your portfolio." },
];

const marketplaceNotes = [
  { title: "Filters that say what they do", body: "Search, type, price and status filters, a sort, and a result count that updates as you filter." },
  { title: "Returns you can believe", body: "Projected 1-year returns of 8.9% to 14.1% and rental yields of 6.0% to 9.2%, all from the same dataset as the dashboard." },
  { title: "One quiet action", body: "Instead of a bright Invest button on every card, a quiet “View property” lets the photos and numbers do the selling." },
];

// Parcel grid: 100 lots for Verbena Coastal Villa — 1 lot = 1% = 250 shares,
// 72 funded, the default 100-share order shown as one lot. The script below
// keeps this in step with the slider; SSR renders the default state.
const PLAT_FUNDED = 72;
const plat = Array.from({ length: 100 }, (_, i) =>
  i < PLAT_FUNDED ? "is-funded" : i === PLAT_FUNDED ? "is-mine" : "",
);
// One-row strips (20 cells): f = funded, m = yours, "" = available.
const strip = (f: number, m: number, mineFirst = false) => {
  const funded = Array(f).fill("is-funded");
  const mine = Array(m).fill("is-mine");
  return [...(mineFirst ? [...mine, ...funded] : [...funded, ...mine]), ...Array(20 - f - m).fill("")];
};
const uses = [
  { title: "Marketplace cards", body: "A one-row strip shows how funded each property is.", strip: strip(13, 0) },
  { title: "Your properties", body: "Owned cards show your share of the building in Mint.", strip: strip(14, 2, true) },
  { title: "Checkout and selling", body: "Lots fill as you change the quantity, and release when you sell.", strip: strip(14, 2) },
];

const swatches = [
  { name: "Forest", hex: "#0F2A23", ink: "#EAF2EE", body: "The sidebar and dark surfaces, so the frame itself belongs to the brand." },
  { name: "Evergreen", hex: "#0D6F5B", ink: "#FFFFFF", body: "Primary actions, links and funded lots. White on it is 6.10:1." },
  { name: "Mint", hex: "#1EAB88", ink: "#0F2A23", body: "Chart lines and your lots. Never text on white, at 2.90:1." },
  { name: "Harvest", hex: "#C98A2E", ink: "#12201C", body: "Rental income and payouts, and nothing else." },
  { name: "Ink", hex: "#12201C", ink: "#EAF2EE", body: "Primary text, at 16.8:1. Neutrals lean slightly green." },
  { name: "Canvas", hex: "#F6F8F7", ink: "#12201C", body: "The app background: a cool off-white, not cream." },
];

const words = [
  { label: "The thing you buy", now: "Shares", was: "fractional tokens" },
  { label: "Money in your account", now: "LiquidAcre balance", was: "LiquidAcre Wallet" },
  { label: "The deposit button", now: "Add funds", was: "Connect Wallet" },
  { label: "The history page", now: "Transactions", was: "Order History" },
];

const motion = [
  { screen: "Dashboard", moves: "The value counts up, the line draws, the income bars rise", why: "Your money arrives as a story: what it’s worth, how it got there, what it earns" },
  { screen: "Listing", moves: "The parcel fills lot by lot, your lot last", why: "Teaches the grid before the legend" },
  { screen: "Marketplace", moves: "Each card’s strip fills in reading order", why: "Shows at a glance which properties are selling fastest" },
  { screen: "Everywhere else", moves: "Lots fill as quantity changes, tab indicators slide, dialogs scale in from 98%", why: "Confirms that an action landed" },
];
---
<FullscreenLayout title="LiquidAcre — Case Study — Neel Sarode">
  <GridLines />

  <!-- Shared radial fill for the spark bullets (same gradient as the other
       case studies: white core to #999 tips). -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <radialGradient id="cs-spark-grad" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(7.5 7.5) rotate(90) scale(7.5)">
        <stop stop-color="white" />
        <stop offset="1" stop-color="#999999" />
      </radialGradient>
    </defs>
  </svg>

  <main class="content">
    <!-- 1 · Hero — full viewport, nav overlaid, title bottom-left. The
         Ultramock cover (dashboard → listing → marketplace on the Forest
         plat), same loop as the homepage Featured Work row. -->
    <section class="cs-hero" data-reveal-group>
      <video
        class="cs-hero-img"
        src="/liquidacre-cover.mp4" width="1920" height="1080"
        poster="/liquidacre-poster.jpg"
        data-desktop-src="/liquidacre-cover.mp4"
        data-desktop-poster="/liquidacre-poster.jpg"
        data-mobile-src="/liquidacre-cover-mobile.mp4"
        data-mobile-poster="/liquidacre-poster-mobile.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
        data-fade
      ></video>
      <!-- Mobile: the square 1080² centre cut of the 4K master. -->
      <MobileVideoSwap />
      <div class="cs-hero-scrim" aria-hidden="true"></div>
      <div class="cs-hero-overlay">
        <header class="cs-nav"><SiteNav activePath="/" /></header>
        <h1 class="cs-title">
          <span class="mask"><span class="line">LiquidAcre</span></span>
        </h1>
      </div>
    </section>

    <!-- 2 · About — info tiles (cols 1-6) + standfirst (cols 8-13). -->
    <section class="cs-band cs-about">
      <div class="content-grid">
        <div class="full-composed">
          <div class="cs-info" data-reveal-group>
            <div class="cs-tile cs-tile-tall">
              <span class="mask"><p class="cs-ilabel">{info[0].label}</p></span>
              <div class="cs-tile-values">
                {info[0].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
            </div>
            <div class="cs-tile-stack">
              {[info[1], info[2]].map((t) => (
                <div class="cs-tile">
                  <span class="mask"><p class="cs-ilabel">{t.label}</p></span>
                  {t.values.map((v) => (
                    <span class="mask"><p class="cs-ivalue">{v}</p></span>
                  ))}
                </div>
              ))}
            </div>
            {[info[3], info[4]].map((t) => (
              <div class="cs-tile">
                <span class="mask"><p class="cs-ilabel">{t.label}</p></span>
                {t.values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
            ))}
          </div>

          <div class="cs-standfirst" data-reveal-group>
            <span class="mask"><p class="cs-statement">
              <span class="mut">LiquidAcre lets everyday investors buy $50
              shares of a house, a cabin or a warehouse, earn their part of the
              rent every month, and sell when they’re ready.</span>
            </p></span>
            <span class="mask"><p class="cs-statement">
              I designed the product end-to-end for first-time property
              investors, with one job: make a fraction of a building feel
              tangible, and every number on screen trustworthy.
            </p></span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Where trust gets lost. Label/body row opening the band, then the
         rules as a 3-up row of Onyx cards. -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed cs-row-lead" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">Where trust gets lost</p></span>
          <div class="cs-rowbody cs-rowbody-stack">
            <span class="mask"><p class="cs-body">
              <span class="mut">An investing app is only as convincing as its
              least believable number.</span>
            </p></span>
            <span class="mask"><p class="cs-body">
              Before drawing any screens, I listed the moments where a
              first-time investor would hesitate, and turned each one into a
              rule the design had to keep.
            </p></span>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          {rules.map((r, i) => (
            <div class="cs-card cs-rule" data-fade>
              <p class="cs-card-num">{String(i + 1).padStart(2, "0")}</p>
              <div class="cs-card-text">
                <span class="mask"><p class="cs-feat-title">{r.title}</p></span>
                <span class="mask"><p class="cs-feat-body">{r.body}</p></span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 · The Product. Centred label + body stack, then two mirrored
         feature rows (TL;DR's Feature Builds layout): dashboard screen left
         with its notes right, marketplace notes left with its screen right. -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-intro cs-intro-stack">
            <span class="mask"><p class="cs-label">The Product</p></span>
            <span class="mask"><p class="cs-body cs-center">
              <span class="mut">Twelve screens, six payment dialogs and the
              sell flow. </span>Each main screen is built around the one
              question people bring to it.
            </p></span>
          </div>
        </div>
      </div>

      <!-- Dashboard — screen left, notes right. -->
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-screen cs-feat-left" data-fade>
            <div class="cs-screen-frame">
              <video
                src="/liquidacre-dashboard-loop.mp4" width="1920" height="1200"
                poster="/liquidacre-dashboard-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            </div>
            <p class="cs-img-caption">The dashboard on arrival, once per session</p>
          </div>
          <div class="cs-feat-col cs-feat-col-right">
            <div class="cs-feat-head">
              <span class="mask"><h3 class="cs-feat-title">Dashboard</h3></span>
              <span class="mask"><p class="cs-feat-body">
                The dashboard answers three questions in the order people ask
                them. What is my money worth? What is it earning? What should
                I do next?
              </p></span>
            </div>
            <div class="cs-feat-list">
              {dashboardNotes.map((n) => (
                <div class="cs-feat-item">
                  <svg class="cs-bullet" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M7.5 0C7.16563 6.89063 6.89063 7.16563 0 7.5C6.89063 7.83438 7.16563 8.10938 7.5 15C7.83438 8.10938 8.10938 7.83438 15 7.5C8.10938 7.16563 7.83438 6.89063 7.5 0Z" fill="url(#cs-spark-grad)" />
                  </svg>
                  <div class="cs-feat-note">
                    <p class="cs-feat-lead">{n.title}</p>
                    <p class="cs-feat-body">{n.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Marketplace — notes left, screen right. -->
      <div class="content-grid">
        <div class="full-composed cs-feature" data-reveal-group>
          <div class="cs-feat-col cs-feat-col-left">
            <div class="cs-feat-head">
              <span class="mask"><h3 class="cs-feat-title">Marketplace</h3></span>
              <span class="mask"><p class="cs-feat-body">
                Browsing should feel like looking at properties, not at
                buttons. Each card leads with the photo, the name and the
                returns, and the whole card is clickable.
              </p></span>
            </div>
            <div class="cs-feat-list">
              {marketplaceNotes.map((n) => (
                <div class="cs-feat-item">
                  <svg class="cs-bullet" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M7.5 0C7.16563 6.89063 6.89063 7.16563 0 7.5C6.89063 7.83438 7.16563 8.10938 7.5 15C7.83438 8.10938 8.10938 7.83438 15 7.5C8.10938 7.16563 7.83438 6.89063 7.5 0Z" fill="url(#cs-spark-grad)" />
                  </svg>
                  <div class="cs-feat-note">
                    <p class="cs-feat-lead">{n.title}</p>
                    <p class="cs-feat-body">{n.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="cs-screen cs-feat-right" data-fade>
            <div class="cs-screen-frame">
              <video
                src="/liquidacre-marketplace-loop.mp4" width="1920" height="1200"
                poster="/liquidacre-marketplace-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            </div>
            <p class="cs-img-caption">Each card’s strip fills in reading order, like a row of plots selling out</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · The parcel grid — the product's signature. Label/body row, then
         the grid REBUILT AS HTML on the Forest plat backdrop: drag the slider
         and the order's lots fill (product-mock internals keep the app's own
         lot geometry, like the TL;DR extension mock), then the three places
         the grid appears as one-row strips. -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed cs-row-lead" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">Land you can subdivide</p></span>
          <div class="cs-rowbody cs-rowbody-stack">
            <span class="mask"><p class="cs-body">
              <span class="mut">An acre is land you can split into lots, and
              that idea gave the product its signature: </span>a parcel grid.
              Each property is drawn as a simple plat. Funded lots are filled,
              available lots are outlined, and yours are Mint.
            </p></span>
            <span class="mask"><p class="cs-body">
              <span class="mut">A figure like 0.4% is hard to picture. A lot on
              a plat is something you can point at.</span> Try it on the villa
              below.
            </p></span>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-plat" data-fade>
            <div
              class="cs-plat-grid"
              id="plat-grid"
              role="img"
              aria-label="Parcel grid for Verbena Coastal Villa: 72 lots funded, 1 lot for this order, 27 available"
            >
              {plat.map((c) => <i class={c || undefined}></i>)}
            </div>
            <div class="cs-plat-side">
              <div class="cs-plat-head">
                <p class="cs-plat-title">72% funded</p>
                <p class="cs-plat-sub">Verbena Coastal Villa: 18,000 of 25,000 shares sold, $50 a share.</p>
              </div>
              <div class="cs-plat-control">
                <label class="cs-plat-label" for="plat-qty">
                  Shares to buy <output id="plat-qty-out" for="plat-qty">100</output>
                </label>
                <input type="range" id="plat-qty" min="50" max="2500" step="50" value="100" />
              </div>
              <p class="cs-plat-read" id="plat-read" aria-live="polite">
                <span class="cs-plat-strong">100 shares</span> for $5,000 is
                0.4% of the property, shown as 1 lot. One lot is 250 shares.
              </p>
              <ul class="cs-plat-legend">
                <li><i class="is-funded"></i>Funded</li>
                <li><i class="is-mine"></i>This order</li>
                <li><i></i>Available</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-row-tight" data-reveal-group>
          {uses.map((u) => (
            <div class="cs-use">
              <div class="cs-strip" aria-hidden="true" data-fade>
                {u.strip.map((c) => <i class={c || undefined}></i>)}
              </div>
              <span class="mask"><p class="cs-feat-title">{u.title}</p></span>
              <span class="mask"><p class="cs-feat-body">{u.body}</p></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · Listing. Centred label + body stack, then one wide screen panel:
         the listing's arrival, the invest card's grid filling to 72%. -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-intro cs-intro-stack">
            <span class="mask"><p class="cs-label">Listing</p></span>
            <span class="mask"><p class="cs-body cs-center">
              <span class="mut">The listing is where people decide, so the page
              is built around that decision. </span>The photo and three key
              figures lead, and the invest card stays in view as you scroll,
              carrying the full parcel grid.
            </p></span>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-screen cs-screen-wide" data-fade>
            <div class="cs-screen-frame">
              <video
                src="/liquidacre-listing-loop.mp4" width="1920" height="1200"
                poster="/liquidacre-listing-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            </div>
            <p class="cs-img-caption">The parcel fills lot by lot to 72%, and your order’s lot appears last</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · Buying. Label/body row, the full buy flow as a wide screen
         panel, then the two checkout details half/half. -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed cs-row-lead" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">Buying, from listing to first payout</p></span>
          <div class="cs-rowbody cs-rowbody-stack">
            <span class="mask"><p class="cs-body">
              <span class="mut">Buying is where money moves, so nothing should
              come as a surprise.</span> The checkout shows the whole order
              before you commit: shares times price, the fee and the total.
            </p></span>
            <span class="mask"><p class="cs-body">
              <span class="mut">Your balance sits on the payment option.</span>
              If it’s too low, you see “Not enough for this order” with Add
              funds right beside it, before you choose it rather than after a
              payment fails.
            </p></span>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-screen cs-screen-wide" data-fade>
            <div class="cs-screen-frame">
              <video
                src="/liquidacre-buyflow-loop.mp4" width="1920" height="1200"
                poster="/liquidacre-buyflow-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            </div>
            <p class="cs-img-caption">Buying 100 shares of Verbena Coastal Villa for $5,075, from the listing to the confirmation</p>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-stack" data-reveal-group>
          <div class="cs-screen cs-screen-half-left" data-fade>
            <div class="cs-screen-frame">
              <img src="/liquidacre-checkout-shares.jpg" width="1971" height="1100" alt="Choosing how many shares: options for 10, 50 and 100 shares and a custom amount, with 50 shares for $2,500 selected. Five lots fill on the strip below, and the order is 0.20% of the property, earning an estimated $15.42 a month." loading="lazy" decoding="async" />
            </div>
            <p class="cs-img-caption">Lots fill as you pick a quantity</p>
          </div>
          <div class="cs-screen cs-screen-half-right" data-fade>
            <div class="cs-screen-frame">
              <img src="/liquidacre-checkout-pay.jpg" width="1260" height="704" alt="Pay with: the LiquidAcre balance shows $1,240.50 available and is flagged Not enough for this order, with an Add funds button. Visa ending in 4242 is selected, with a 1.5% fee." loading="lazy" decoding="async" />
            </div>
            <p class="cs-img-caption">A short balance is flagged on the option itself</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · The system. Label/body row, the palette as six paint chips,
         then a second label/body row and the naming table (4-up). -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed cs-row-lead" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">A system taken from the land</p></span>
          <div class="cs-rowbody cs-rowbody-stack">
            <span class="mask"><p class="cs-body">
              <span class="mut">My first instinct was near-black with a bright
              mint accent, the default look of every fintech app.</span> I
              chose Forest and Evergreen instead, colours that come from the
              land itself, and gave income its own colour so rent has a visual
              story.
            </p></span>
            <span class="mask"><p class="cs-body">
              <span class="mut">Mint stays a graphic colour only, because it
              can’t carry text on white.</span> The interface is set in Satoshi
              on one scale from 12 to 48px, with tabular figures for every
              number that moves.
            </p></span>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          {swatches.map((s) => (
            <div class="cs-swatch">
              <div class="cs-swatch-chip" style={`background:${s.hex};color:${s.ink}`} data-fade>
                <span>{s.name}</span>
              </div>
              <span class="mask"><p class="cs-swatch-hex">{s.hex}</p></span>
              <span class="mask"><p class="cs-feat-body">{s.body}</p></span>
            </div>
          ))}
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-row" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">Plain names</p></span>
          <span class="mask cs-rowbody"><p class="cs-body">
            <span class="mut">The words got the same care.</span> Each thing
            has one name that says what it does, chosen over the crypto and
