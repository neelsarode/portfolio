<!-- Same reveal system as the other case studies: masked line rises + media
     fades per [data-reveal-group], wired to Lenis. gsap.from only —
     no-JS/reduced-motion visitors simply see the content. The parcel grid
     runs for everyone (reduced motion just drops the fill stagger). -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const panelVideos = document.querySelectorAll<HTMLVideoElement>(".cs-screen video");

  if (!reduce) {
    gsap.registerPlugin(ScrollTrigger);

    const wireLenis = () => {
      const lenis = (window as any).lenis;
      if (lenis) lenis.on("scroll", ScrollTrigger.update);
    };
    (window as any).lenis
      ? wireLenis()
      : addEventListener("lenis:init", wireLenis, { once: true });

    // Panel loops autoplay below the fold, and Chrome's offscreen media
    // optimisation can pause them there without resuming on scroll — gate
    // each on visibility (same fix as the other case studies).
    panelVideos.forEach((v) => {
      new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          });
        },
        { rootMargin: "160px" },
      ).observe(v);
    });

    gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
      const risers = group.querySelectorAll(".mask > *");
      const fades = group.querySelectorAll("[data-fade]");
      const tl = gsap.timeline({
        scrollTrigger: { trigger: group, start: "top 82%", once: true },
      });
      if (risers.length) {
        tl.from(risers, {
          yPercent: 110,
          duration: 0.9,
          ease: "power4.out",
          stagger: 0.09,
        });
      }
      if (fades.length) {
        tl.from(fades, { opacity: 0, duration: 0.9, ease: "power2.out" }, 0.1);
      }
    });
  } else {
    // Reduced motion: the hero and panel loops stay on their posters.
    document.querySelectorAll<HTMLVideoElement>("video.cs-hero-img, .cs-screen video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
      v.currentTime = 0;
    });
  }

  // ---- Parcel grid: 100 lots, 1 lot = 1% = 250 shares, 72 funded. The
  // order is always drawn as at least one lot; lots fill outward from the
  // edge of the funded block (same timing as the prototype). ----
  const grid = document.getElementById("plat-grid");
  const qty = document.getElementById("plat-qty") as HTMLInputElement | null;
  const out = document.getElementById("plat-qty-out");
  const read = document.getElementById("plat-read");
  if (grid && qty && out && read) {
    const TOTAL = 25000;
    const PRICE = 50;
    const PER_LOT = 250;
    const FUNDED = 72;
    const lots = Array.from(grid.children) as HTMLElement[];
    const fmt = new Intl.NumberFormat("en-US");
    let shown = 1;
    const update = () => {
      const n = Number(qty.value);
      const mine = Math.max(1, Math.ceil(n / PER_LOT));
      const pct = (n / TOTAL) * 100;
      const lotWord = mine === 1 ? "lot" : "lots";
      lots.forEach((el, i) => {
        const isMine = i >= FUNDED && i < FUNDED + mine;
        if (isMine !== el.classList.contains("is-mine")) {
          const step = Math.abs(i - (FUNDED + Math.min(shown, mine)));
          el.style.transitionDelay = reduce ? "0ms" : `${Math.min(step * 22, 220)}ms`;
          el.classList.toggle("is-mine", isMine);
        }
      });
      shown = mine;
      out.textContent = fmt.format(n);
      grid.setAttribute(
        "aria-label",
        `Parcel grid for Verbena Coastal Villa: ${FUNDED} lots funded, ${mine} ${lotWord} for this order, ${100 - FUNDED - mine} available`,
      );
      const pctText = pct < 1 ? pct.toFixed(1) : fmt.format(Math.round(pct * 10) / 10);
      read.innerHTML =
        `<span class="cs-plat-strong">${fmt.format(n)} shares</span> for $${fmt.format(n * PRICE)} is ` +
        `${pctText}% of the property, shown as ${mine} ${lotWord}. One lot is 250 shares.`;
    };
    qty.addEventListener("input", update);
  }
</script>

