<!-- Same reveal system as the homepage: masked line rises + media fades per
     [data-reveal-group], wired to Lenis. gsap.from only — no-JS/reduced-motion
     visitors simply see the content. -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.registerPlugin(ScrollTrigger);

    const wireLenis = () => {
      const lenis = (window as any).lenis;
      if (lenis) lenis.on("scroll", ScrollTrigger.update);
    };
    (window as any).lenis
      ? wireLenis()
      : addEventListener("lenis:init", wireLenis, { once: true });

    // Panel loops autoplay below the fold, and Chrome's offscreen media
    // optimisation can pause them there without resuming on scroll — same
    // failure mode the homepage covers solve. Gate each on visibility.
    document
      .querySelectorAll<HTMLVideoElement>("video.cs-ext-bg, .cs-img > video")
      .forEach((v) => {
        new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) v.play().catch(() => {});
              else v.pause();
            });
          },
          { rootMargin: "160px" },
        ).observe(v);
      });

    gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
      const risers = group.querySelectorAll(".mask > *");
      const fades = group.querySelectorAll("[data-fade]");
      const tl = gsap.timeline({
        scrollTrigger: { trigger: group, start: "top 82%", once: true },
      });
      if (risers.length) {
        tl.from(risers, {
          yPercent: 110,
          duration: 0.9,
          ease: "power4.out",
          stagger: 0.09,
        });
      }
      if (fades.length) {
        tl.from(fades, { opacity: 0, duration: 0.9, ease: "power2.out" }, 0.1);
      }
    });
  } else {
    // Reduced motion: the hero and extension loops stay on their posters.
    document.querySelectorAll<HTMLVideoElement>("video.cs-hero-img, video.cs-ext-bg, .cs-img > video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
      v.currentTime = 0;
    });
  }
</script>

<script>
  // Upcoming Scheduled Posts — the animated dashboard-card rebuild in the
  // Product Design section. Self-contained: it only touches usp-* elements,
  // and the loop restarts from the empty state each time the card scrolls
  // into view. All timings live in TIMELINE.
  const uspCard = document.querySelector(".usp-card");
  const uspEmpty = document.getElementById("usp-empty");
  const uspPill = document.getElementById("usp-pill");
  const uspPosts = document.getElementById("usp-posts");
  const uspBones = document.getElementById("usp-bones");

  if (uspCard && uspEmpty && uspPill && uspPosts && uspBones) {
    const rows = uspPosts.querySelectorAll("[data-step]");

    // Skeleton stack (mirrors the production EmptyState).
    const groups = [["72%", "58%", "84%"], ["66%", "78%"], ["54%", "70%", "62%"]];
    uspBones.innerHTML = groups
      .map(
        (widths) =>
          '<div class="usp-dayrow"><span class="usp-bone usp-bone--day"></span><span class="usp-divider"></span></div>' +
          widths
            .map(
              (w) =>
                '<div class="usp-item" style="border-color:transparent">' +
                '<div class="usp-item-head"><span class="usp-bone usp-bone--time"></span>' +
                '<div class="usp-platforms"><span class="usp-bone usp-bone--dot"></span><span class="usp-bone usp-bone--dot"></span><span class="usp-bone usp-bone--dot"></span></div></div>' +
                '<span class="usp-bone usp-bone--title" style="width:' + w + '"></span></div>',
            )
            .join(""),
      )
      .join("");

    // Reduced motion: the CSS shows the populated state statically.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // [delay-from-loop-start(ms), action]
      const TIMELINE: [number, () => void][] = [
        [1400, () => uspPill.classList.add("usp-out")],
        [1750, () => { uspEmpty.classList.add("usp-fade"); uspPosts.classList.add("usp-live"); }],
        [1950, () => rows[0].classList.add("usp-in")], // day: today
        [2150, () => rows[1].classList.add("usp-in")], // post 1
        [2800, () => rows[2].classList.add("usp-in")], // post 2
        [3450, () => rows[3].classList.add("usp-in")], // day: tomorrow
        [3650, () => rows[4].classList.add("usp-in")], // post 3
        [7400, () => uspPosts.classList.add("usp-fade")],
        [7850, () => reset()],
      ];

      let timers: ReturnType<typeof setTimeout>[] = [];
      let running = false;

      const clearState = () => {
        uspPosts.classList.remove("usp-live", "usp-fade");
        uspEmpty.classList.remove("usp-fade");
        uspPill.classList.remove("usp-out");
        rows.forEach((r) => r.classList.remove("usp-in"));
      };
      const schedule = () => {
        TIMELINE.forEach(([delay, action]) => timers.push(setTimeout(action, delay)));
      };
      function reset() {
        clearState();
        if (running) schedule();
      }
      const start = () => {
        if (running) return;
        running = true;
        schedule();
      };
      const stop = () => {
        running = false;
        timers.forEach(clearTimeout);
        timers = [];
        clearState();
      };

      new IntersectionObserver(
        (entries) => (entries[0].isIntersecting ? start() : stop()),
        { threshold: 0.35 },
      ).observe(uspCard);
    }
  }
</script>

