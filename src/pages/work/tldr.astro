---
import FullscreenLayout from "../../layouts/FullscreenLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import GridLines from "../../components/GridLines.astro";
import DevGrid from "../../components/DevGrid.astro";
// TL;DR case study (Figma 2548:24573). Typography is copied EXACTLY from the
// file (sizes, line-heights, tracking, the muted/white emphasis rhythm);
// spacing and columns are mapped onto the site system — the design's 1296px
// container IS the 12-col macro grid at 1440 (col 86 + gutter 24), so every
// media width in the file lands on a whole column span:
//   746 = 7 cols · 526 = 5 cols · 636 = 6 cols · wide = 12 cols.
// The one exception is the TwitchCon pair (360/912), which sits off-grid in
// the file and is approximated to 4/8 cols.
//
// Media policy: the Brand row is real — left panel is an exported image, the
// right panel is the Twitch extension REBUILT AS HTML over the prism
// backdrop (interim image; swap in the background video when supplied).
// Every other panel is a placeholder slot (the file leaves them empty)
// awaiting real screenshots/loops — same drop-in flow as the homepage covers.

const info = [
  {
    label: "Things I Did",
    values: [
      "Brand Creation",
      "Product UI/UX",
      "Product Front-End Code (React)",
      "Website Design & Development",
      "Investor & Sales Decks",
      "Clothing & Event Design",
    ],
  },
  { label: "Company", values: ["TL;DR"] },
  { label: "Role", values: ["Co-Founder", "Creative Director"] },
  { label: "Year", values: ["2024 → Present"] },
  { label: "Live website", values: [], link: { text: "Visit website", href: "https://tl-dr.tv" } },
];

const myTldrFeatures = [
  "Modular bento-style layout engine that adapts based off what the user sets up",
  "Detection if the user is live on Twitch or Kick to drive traffic to their stream",
  "Opt-in for user to send out email and text blasts when they go live",
  "Stream highlight clips from TL;DR",
  "User’s livestreaming schedule",
  "Links to their affiliate products",
];

const streamhubFeatures = [
  "Drag and drop canvas to position and resize sub account livestreams",
  "Manual clipping button per sub account livestream",
  "Ability to toggle on & off subaccounts in the canvas view",
];

// Placeholder cards carried over from the design file (it still shows the
// template's example projects here). Swap for two real projects + media.
const moreWork = [
  { title: "Nomad Vision™", tags: ["Branding", "Web Design", "AI Prompting"] },
  { title: "Livingless", tags: ["Sora Consulting", "Webflow Development", "AI Prompting"] },
];
---
<FullscreenLayout title="TL;DR — Case Study — Neel Sarode">
  <GridLines />

  <!-- Shared radial fill for the spark bullets (exact gradient from the file:
       white core to #999 tips). One defs block; every bullet references it. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <radialGradient id="cs-spark-grad" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(7.5 7.5) rotate(90) scale(7.5)">
        <stop stop-color="white" />
        <stop offset="1" stop-color="#999999" />
      </radialGradient>
    </defs>
  </svg>

  <main class="content">
    <!-- 1 · Hero — full viewport, nav overlaid, title bottom-left. The file
         leaves the hero media empty; the dashboard loop is the obvious
         occupant and was already encoded for the homepage. -->
    <section class="cs-hero" data-reveal-group>
      <video
        class="cs-hero-img"
        src="/tldr-dashboard.mp4"
        poster="/tldr-dashboard-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
        data-fade
      ></video>
      <div class="cs-hero-scrim" aria-hidden="true"></div>
      <div class="cs-hero-overlay">
        <header class="cs-nav"><SiteNav activePath="/" /></header>
        <h1 class="cs-title">
          <span class="mask"><span class="line">TL;DR</span></span>
        </h1>
      </div>
    </section>

    <!-- 2 · About — info tiles (cols 1-6) + standfirst (cols 7-13). -->
    <section class="cs-band cs-about">
      <div class="content-grid">
        <div class="full-composed">
          <div class="cs-info" data-reveal-group>
            <div class="cs-tile cs-tile-tall">
              <span class="mask"><p class="cs-ilabel">{info[0].label}</p></span>
              <div class="cs-tile-values">
                {info[0].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
            </div>
            <div class="cs-tile-stack">
              <div class="cs-tile">
                <span class="mask"><p class="cs-ilabel">{info[1].label}</p></span>
                {info[1].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
              <div class="cs-tile">
                <span class="mask"><p class="cs-ilabel">{info[2].label}</p></span>
                {info[2].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
            </div>
            <div class="cs-tile">
              <span class="mask"><p class="cs-ilabel">{info[3].label}</p></span>
              {info[3].values.map((v) => (
                <span class="mask"><p class="cs-ivalue">{v}</p></span>
              ))}
            </div>
            <div class="cs-tile">
              <span class="mask"><p class="cs-ilabel">{info[4].label}</p></span>
              <span class="mask">
                <a class="cs-ivalue cs-ilink" href={info[4].link!.href} target="_blank" rel="noopener">{info[4].link!.text}</a>
              </span>
            </div>
          </div>

          <div class="cs-standfirst" data-reveal-group>
            <span class="mask"><p class="cs-statement">
              <span class="mut">TL;DR is a software platform that empowers livestreamers
              with growth tools like AI-generated live highlight clips, video editing,
              and distribution across socials.</span>
            </p></span>
            <span class="mask"><p class="cs-statement">
              I joined at formation and built everything users see: the brand and
              website from zero, the product UX, and large parts of shipped React
              front-end. Most feature and product direction decisions were mine.
            </p></span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Brand — final media: brand panel (5 cols) + the extension panel
         (7 cols) rebuilt in HTML, then The Brand System row. -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-img cs-pair-b-left" data-fade>
            <img src="/tldr-brand-system.jpg" alt="The TL;DR brand system: pixel logotype on black with a purple glow." loading="lazy" decoding="async" />
          </div>
          {/* Extension panel: ColorFlow loop behind the Twitch extension
              rebuilt as live HTML at (80,89)/746×648 per the file, plus the
              stat card. The mock is sized in container-query units so it
              scales with the panel exactly like the Figma frame. */}
          <div class="cs-img cs-pair-a-right cs-ext-panel" data-fade>
            <video
              class="cs-ext-bg"
              src="/tldr-prism-loop.mp4"
              poster="/tldr-prism-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              tabindex="-1"
              aria-hidden="true"
            ></video>
            <div class="cs-ext" aria-hidden="true">
              <div class="cs-ext-head">
                <span class="cs-ext-logo"><img src="/tldr-ext-logo.svg" alt="" /></span>
                <span class="cs-ext-px cs-ext-px1"></span>
                <span class="cs-ext-px cs-ext-px2"></span>
                <span class="cs-ext-px cs-ext-px3"></span>
                <span class="cs-ext-pill">
                  <span class="cs-ext-pill-icon"><img src="/tldr-ext-pill-icon.svg" alt="" /></span>
                  <span class="cs-ext-pill-text">Capturing Clips</span>
                </span>
              </div>
              <div class="cs-ext-row">
                <p class="cs-ext-h">Stream Highlights</p>
                <span class="cs-ext-avatar"><img src="/tldr-ext-avatar.jpg" alt="" /></span>
              </div>
              <div class="cs-ext-card">
                <span class="cs-ext-thumb"><img src="/tldr-ext-clip-deadlock.jpg" alt="" loading="lazy" decoding="async" /></span>
                <div class="cs-ext-cap">
                  <p class="cs-ext-title">Getting a crazy double kill while getting pushed</p>
                  <div class="cs-ext-meta"><span>Deadlock</span><span class="cs-ext-dim">1:03:56</span></div>
                  <div class="cs-ext-actions">
                    <div class="cs-ext-reacts">
                      <span class="cs-ext-react cs-ext-react-hot"><img src="/tldr-ext-emoji-heart.png" alt="" /><span>15</span></span>
                      <span class="cs-ext-react cs-ext-react-mid"><img src="/tldr-ext-emoji-grin.png" alt="" /><span>242</span></span>
                      <span class="cs-ext-react"><img src="/tldr-ext-emoji-joy.png" alt="" /><span>4</span></span>
                      <span class="cs-ext-react"><img src="/tldr-ext-emoji-weary.png" alt="" /><span>12</span></span>
                      <span class="cs-ext-react"><img src="/tldr-ext-emoji-astonished.png" alt="" /><span>10</span></span>
                    </div>
                    <span class="cs-ext-share">
                      <span class="cs-ext-share-t">Share</span>
                      <img class="cs-ext-share-i" src="/tldr-ext-share-icon.svg" alt="" />
                    </span>
                  </div>
                </div>
              </div>
              <div class="cs-ext-card">
                <span class="cs-ext-thumb"><img src="/tldr-ext-clip-league.jpg" alt="" loading="lazy" decoding="async" /></span>
                <div class="cs-ext-cap">
                  <p class="cs-ext-title">MayzeFPS and his girlfriend share a High-Five for Muscles!</p>
                  <div class="cs-ext-meta">
                    <span>Just Chatting</span><span class="cs-ext-dim">1:03:56</span>
                    <span class="cs-ext-badge"><img src="/tldr-ext-badge.png" alt="" /></span>
                    <span class="cs-ext-share cs-ext-share-solo">
                      <img class="cs-ext-share-i cs-ext-share-i-lg" src="/tldr-ext-share-icon.svg" alt="" />
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <div class="cs-stat cs-stat-brand">
              <div class="cs-stat-logo-row">
                <img class="cs-stat-twitch" src="/tldr-twitch-logo.png" alt="Twitch" width="56" height="28" />
                <p class="cs-stat-store">Extension Store</p>
              </div>
              <div class="cs-stat-nums">
                <p class="cs-stat-num">35,000+</p>
                <p class="cs-stat-sub">Twitch Extension Installs</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-row" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">The Brand System</p></span>
          <span class="mask cs-rowbody"><p class="cs-body">
            TL;DR originally began as an extension inside of Twitch’s ecosystem, so
            the brand had to feel native to it. I built the identity on codes
            streamers already trust: Purples similar to Twitch’s spectrum and a
            pixel logotype that gives TL;DR its own mark inside that familiar world.
          </p></span>
        </div>
      </div>
    </section>

    <!-- 4 · Website -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <span class="mask cs-intro"><p class="cs-body cs-center">
            <span class="mut">The platform does a bunch of things. The website had to
            promise just one: </span>growth. <span class="mut">I designed the site
            so </span>every feature is framed as a piece of the puzzle of growing as
            a livestreamer.
          </p></span>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-img cs-img-wide" data-fade>
            <video
              src="/tldr-website-loop.mp4"
              poster="/tldr-website-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              tabindex="-1"
              aria-hidden="true"
            ></video>
            <div class="cs-stat">
              <p class="cs-stat-num">10,000+</p>
              <p class="cs-stat-sub">Signups to our platform</p>
            </div>
          </div>
          <div class="cs-img cs-pair-a-left" data-fade>
            <img src="/tldr-website-pages.jpg" alt="TL;DR website pages: the streamer landing page, social scheduling, and the Twitch extension section." loading="lazy" decoding="async" />
          </div>
          <div class="cs-img cs-pair-b-right" data-fade>
            <video
              src="/tldr-mobile-loop.mp4"
              poster="/tldr-mobile-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              tabindex="-1"
              aria-hidden="true"
            ></video>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-row" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">The Website Challenge</p></span>
          <span class="mask cs-rowbody"><p class="cs-body">
            <span class="mut">I designed and built the entire website end-to-end: </span>
            structure, copy hierarchy, and development on Webflow.
            <span class="mut"> Streamers don’t shop for features, they shop for </span>outcomes<span class="mut">
            - so every section leads with what a streamer gets and demotes “how it
            works” to a supporting layer.</span>
          </p></span>
        </div>
      </div>
    </section>

    <!-- 5 · Product Design -->
    <section class="cs-band">
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <span class="mask cs-intro"><p class="cs-body cs-center">
            <span class="mut">Product design at TL;DR wasn’t just hand-off work. </span>
            I made most feature and UX direction calls, deciding not just how things
            looked but what features got built and why.
          </p></span>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed" data-reveal-group>
          <div class="cs-img cs-img-wide" data-fade>
            <video
              src="/tldr-timeline-loop.mp4"
              poster="/tldr-timeline-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              tabindex="-1"
              aria-hidden="true"
            ></video>
          </div>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-row" data-reveal-group>
          <span class="mask cs-rowlabel"><p class="cs-label">Product Design</p></span>
          <span class="mask cs-rowbody"><p class="cs-body">
            I designed the platform around the idea that streamers use TL;DR around
            their streams - before going live, between sessions, and in the minutes
            after ending. The UI was built for that rhythm: fast to scan and
            dark-native alongside OBS and Twitch. I placed key components in
            specific places for quick and easy usage of the platform.
          </p></span>
        </div>
      </div>
      <div class="content-grid">
        <div class="full-composed cs-row" data-reveal-group>
          {/* Scheduled-posts panel: the dashboard's "Upcoming Scheduled
              Posts" card REBUILT AS HTML, centered on the panel fill —
              skeleton empty state loops into three populated posts
              (usp-* global styles + script; timings in TIMELINE). */}
          <div class="cs-img cs-pair-a-left cs-usp-panel" data-fade>
            <img src="/tldr-scheduled-bg.jpg" alt="" loading="lazy" decoding="async" />
            <div class="cs-usp-center">
              <section class="usp-card" aria-hidden="true">
                <div class="usp-layout">

                  <header class="usp-head">
                    <p class="usp-title">Upcoming<br />Scheduled Posts</p>
                    <button class="usp-cta" type="button" tabindex="-1">
                      Go to Content Calendar
                      <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                        <path d="M1.5 7.5L7.5 1.5M7.5 1.5H2.7M7.5 1.5V6.3" stroke="white" stroke-opacity="0.72" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </header>

                  <div class="usp-list">

                    <!-- empty state: skeleton stack + pill -->
                    <div class="usp-empty" id="usp-empty" aria-hidden="true">
                      <div class="usp-bones" id="usp-bones"></div>
                      <div class="usp-pill-wrap">
                        <span class="usp-pill" id="usp-pill">No posts scheduled</span>
                      </div>
                    </div>

                    <!-- live layer: 3 posts across 2 day groups -->
                    <div class="usp-posts" id="usp-posts">

                      <div class="usp-dayrow usp-row" data-step="0">
                        <time class="usp-day">Today · Fri, Aug 8</time>
                        <span class="usp-divider"></span>
                      </div>

                      <article class="usp-item" data-step="1">
                        <div class="usp-item-head">
                          <time class="usp-time">3:00PM PST</time>
                          <div class="usp-platforms">
                            <!-- tiktok active · instagram dim · youtube dim -->
