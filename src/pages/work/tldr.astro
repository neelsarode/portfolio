       stat number      24 / 1.15 / -0.02em   · stat sub 16 / 1.15 / 65%
       info label       14 / 1.2  / -0.01em   65%
       info value       14 / 1.48 / -0.01em   white
       feature title    18 / 1.48 / -0.01em   white
       feature body     14 / 1.2  / -0.01em   65% (lead-in white)
       image caption    12 / 1.2  / -0.01em   88%
     ============================================================ */
  .cs-title {
    margin: 0;
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #fff;
  }
  .cs-body {
    margin: 0;
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-statement {
    margin: 0;
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .mut { color: rgba(255, 255, 255, 0.65); }
  .cs-center { text-align: center; text-wrap: balance; }
  .cs-label {
    margin: 0;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-ilabel {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-ivalue {
    margin: 0;
    font-size: 14px;
    line-height: 1.48;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .cs-ilink { text-decoration: underline; text-underline-offset: 3px; }

  /* ---- 1 · Hero ---- */
  .cs-hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--placeholder);
  }
  .cs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.25) 0%, rgba(10, 10, 11, 0) 30%, rgba(10, 10, 11, 0) 55%, rgba(10, 10, 11, 0.55) 100%);
  }
  /* Edge-hug overlay — the homepage hero's exact padding recipe. */
  .cs-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 1.2vw, 20px);
  }
  .cs-nav { padding: 0; }

  /* ---- Section rhythm (from the file: 96 into About, 128 between bands,
         64 around intros and label/body rows, 24 between media rows). ---- */
  .cs-band { padding-block-end: var(--space-8); }
  .cs-about { padding-block: var(--space-7) var(--space-8); }
  .cs-row { margin-block-start: var(--space-6); }
  .cs-intro {
    grid-column: 1 / -1;
    justify-self: center;
    max-width: 702px;
    margin-block-end: var(--space-6);
  }
  .cs-feature { margin-block-start: var(--space-6); }

  /* ---- 2 · About ---- */
  .cs-info {
    grid-column: 1 / 6;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--gutter);
    align-content: start;
  }
  .cs-tile { display: flex; flex-direction: column; gap: var(--space-1); align-content: start; }
  .cs-tile-values { display: flex; flex-direction: column; gap: var(--space-1); }
  .cs-tile-stack { display: flex; flex-direction: column; gap: var(--space-3); }
  .cs-standfirst {
    grid-column: 7 / 13;
    max-width: 618px;
    align-self: center;
    display: flex;
    flex-direction: column;
    /* One blank line at 24/1.15 — the file separates the paragraphs with a
       double break, not a spacing token. */
    gap: 1.15em;
    font-size: clamp(18px, 1.67vw, 24px);
  }

  /* ---- Media panels ----
     The pair/wide widths in the file are whole column spans (see header
     comment). Heights: pairs are 648 at 1440 (45vw), wides 806 (56vw). */
  .cs-img {
    position: relative;
    overflow: hidden;
    background: #171718; /* the file's placeholder fill */
  }
  /* Direct child only: the extension panel nests its own imgs (logo, emoji,
     thumbnails, the stat card's Twitch mark) which size themselves — a bare
     descendant selector here would stretch every one of them to 100%. */
  .cs-img > img,
  .cs-img > video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Heights via aspect-ratio, not clamps: the grid is fluid past 1440, and a
     capped height lets the panels drift wide-and-short there — which pushed
     the extension mock (sized off panel WIDTH) out of the panel's bottom.
     Each ratio is the file's box (row height 648, or 806 for wides), so every
     pair resolves to the same row height at any container width. */
  /* ONE box per row carries the ratio and drives the row height; its partner
     has no ratio and stretches to match. Giving both boxes their own ratio
     leaves them ~2px ragged at wide viewports, because the fixed 24px gutters
     shift each box's width FRACTION slightly as the grid grows. */
  .cs-pair-a-left { grid-column: 1 / 8; aspect-ratio: 746 / 648; }
  .cs-pair-b-right { grid-column: 8 / 13; }
  .cs-pair-b-left { grid-column: 1 / 6; }
  .cs-pair-a-right { grid-column: 6 / 13; aspect-ratio: 746 / 648; }
  .cs-pair-half-left { grid-column: 1 / 7; aspect-ratio: 636 / 648; }
  .cs-pair-half-right { grid-column: 7 / 13; }
  /* 4/8-col approximation of the file's off-grid 360/912 pair. */
  .cs-pair-narrow-left { grid-column: 1 / 5; }
  .cs-pair-broad-right { grid-column: 5 / 13; aspect-ratio: 856 / 648; }
  .cs-img-wide { grid-column: 1 / 13; aspect-ratio: 1296 / 806; }
  /* Scheduled-posts panel: real HTML, not a video — the card centers on
     the panel fill. Component styles live in the is:global block below. */
  .cs-usp-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
  }
  .cs-img-caption {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.88);
  }
  /* Before/After chip (Figma 2589:38875) — top-left partner to the caption.
     The file's 36px chip read massive in situ, so it runs at 16px with the
     dev-chip padding rhythm; the fill maps to the charcoal token. */
  .cs-img-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: var(--space-1) var(--space-2);
    border-radius: 999px;
    background: var(--charcoal);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.15;
    color: #fff;
  }

  /* ---- Stat overlay (bottom-right of a media panel) ---- */
  .cs-stat {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    background: var(--void);
  }
  .cs-stat-num {
    margin: 0;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-stat-sub {
    margin: 0;
    font-size: 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.65);
  }

  /* ---- Hover note (bottom-right corner box, shown on panel hover) ----
     Same box language as .cs-stat, but holds a sentence of copy and only
     appears while the panel is hovered — fades/rises in, reverses out. */
  .cs-hover-note {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 340px;
    margin: 0;
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    background: var(--void);
    font-size: 14px;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.88);
    opacity: 0;
    transform: translateY(var(--space-1));
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-img:hover > .cs-hover-note {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-hover-note { transition: none; transform: none; }
  }

  /* Brand stat card variant: Twitch logo row above the numbers (gap 32). */
  .cs-stat-brand { gap: var(--space-4); }
  .cs-stat-logo-row { display: flex; align-items: center; gap: var(--space-1); }
  .cs-stat-twitch { width: 56px; height: auto; display: block; }
  .cs-stat-store {
    margin: 0;
    white-space: nowrap;
    font-size: 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-stat-nums { display: flex; flex-direction: column; gap: var(--space-1); }

  /* ============================================================
     Twitch extension — rebuilt as HTML (Figma 2549:24992).
     The frame is 318×496 at (80,89) inside the 746×648 panel. The panel is
     a size container and the mock's font-size is set in cqw so that 1em on
     the mock equals 16 design-px AT ANY PANEL WIDTH — every internal
     measurement below is the Figma px value divided by 16.
     Product type is Open Sauce Two (self-hosted below); the two 8px meta
     runs are Inter Display in the file and fall back to Geist here.
     ============================================================ */
  @font-face {
    font-family: "Open Sauce Two";
    src: url("/fonts/OpenSauceTwo-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Open Sauce Two";
    src: url("/fonts/OpenSauceTwo-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .cs-ext-panel { container-type: inline-size; }
  .cs-ext-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cs-ext {
    position: absolute;
    left: 10.72%;          /* 80 / 746 */
    top: 13.73%;           /* 89 / 648 */
    width: 42.63%;         /* 318 / 746 */
    height: 31em;          /* 496 — clips the list mid-card, per the file */
    font-size: 16px;       /* fallback if container queries are unsupported */
    font-size: 2.1447cqw;  /* 16px × (panel / 746) */
    font-family: "Open Sauce Two", var(--font-geist-sans);
    display: flex;
    flex-direction: column;
    gap: 1em;
    padding: 3em 1em 1em;  /* 48 / 16 / 16 — header bar sits in the top 32 */
    border-radius: 0.25em;
    background: #201c2b;
    overflow: hidden;
    /* The file's five-layer ambient shadow, in em so it scales too. */
    box-shadow:
      9.9375em 17.6875em 5.6875em rgba(0, 0, 0, 0.01),
      6.3125em 11.3125em 5.1875em rgba(0, 0, 0, 0.04),
      3.5625em 6.375em 4.375em rgba(0, 0, 0, 0.15),
      1.5625em 2.8125em 3.25em rgba(0, 0, 0, 0.26),
      0.375em 0.6875em 1.8125em rgba(0, 0, 0, 0.29);
  }
  .cs-ext p { margin: 0; }

  /* Header bar: logo left, Capturing Clips pill right. */
  .cs-ext-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2em;
    background: rgba(255, 255, 255, 0.05);
  }
  .cs-ext-logo {
    position: absolute;
    left: 0.6875em;
    top: 0.5625em;
    width: 3.0625em;
    height: 0.8346em;
  }
  .cs-ext-logo img { width: 100%; height: 100%; display: block; }
  /* The purple semicolon of the logotype — drawn as pixels in the file. */
  .cs-ext-px { position: absolute; background: #c197ff; }
  .cs-ext-px1 { left: 2.0394em; top: 0.6825em; width: 0.1816em; height: 0.1816em; }
  .cs-ext-px2 { left: 2.0394em; top: 1.0338em; width: 0.1816em; height: 0.1816em; }
  .cs-ext-px3 { left: 2.1306em; top: 1.2156em; width: 0.0908em; height: 0.1816em; }
  .cs-ext-pill {
    position: absolute;
    right: 0.2856em;
    top: 0.25em;
    height: 1.5em;
    display: flex;
    align-items: center;
    gap: 0.125em;
    padding: 0.25em;
    border-radius: 0.25em;
    background: rgba(141, 122, 255, 0.12);
    box-shadow:
      inset 0 0.125em 0.1875em rgba(255, 255, 255, 0.07),
      inset 0 -0.0625em 0.1875em -0.0625em rgba(255, 255, 255, 0.07);
  }
  .cs-ext-pill-icon { position: relative; width: 0.7143em; height: 0.7143em; flex: none; }
  .cs-ext-pill-icon img {
    position: absolute;
    inset: -5% -13.2% -29.61% -13.21%;
    width: auto;
    height: auto;
  }
  .cs-ext-pill-text {
    padding-inline: 0.125em;
    font-size: 0.6875em;      /* 11 */
    line-height: 1.4545;      /* 16 */
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
  }

  /* Stream Highlights + avatar */
  .cs-ext-row { display: flex; align-items: center; justify-content: space-between; }
  .cs-ext-h {
    font-size: 0.9375em;      /* 15 */
    line-height: 1.6;         /* 24 */
    font-weight: 600;
    color: #fff;
  }
  .cs-ext-avatar {
    position: relative;
    width: 1.5em;
    height: 1.5em;
    flex: none;
    border-radius: 0.125em;
    border: 0.033em solid rgba(255, 255, 255, 0.17);
    overflow: hidden;
  }
  .cs-ext-avatar img {
    position: absolute;
    left: 0;
    top: -24.92%;             /* the file's crop of the portrait */
    width: 100%;
    height: 199.1%;
    max-width: none;
  }

  /* Clip cards */
  .cs-ext-card { display: flex; flex-direction: column; gap: 1em; }
  .cs-ext-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 132 / 74;
    border-radius: 0.25em;
    border: 0.0625em solid rgba(255, 255, 255, 0.17);
    overflow: hidden;
  }
  .cs-ext-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cs-ext-cap { display: flex; flex-direction: column; gap: 0.375em; }
  .cs-ext-title {
    font-size: 0.6875em;      /* 11 */
    line-height: 1.4545;      /* 16 */
    font-weight: 600;
    color: #fff;
  }
  .cs-ext-meta {
    display: flex;
    align-items: center;
    gap: 1em; /* meta font is 8px, so 1em = the file's 8px gap */
    font-family: var(--font-geist-sans); /* Inter Display in the file */
    font-size: 0.5em;         /* 8 */
    font-weight: 500;
    line-height: normal;
    color: #fff;
  }
  .cs-ext-dim { color: rgba(255, 255, 255, 0.59); }
  /* Inside the 8px meta row, so 1.75em/1.875em = the file's 14×15. */
  .cs-ext-badge { width: 1.75em; height: 1.875em; flex: none; }
  .cs-ext-badge img { width: 100%; height: 100%; display: block; }

  .cs-ext-actions { display: flex; align-items: flex-start; justify-content: space-between; }
  .cs-ext-reacts { display: flex; align-items: center; gap: 0.125em; }
  .cs-ext-react {
    display: flex;
    align-items: center;
    gap: 0.125em;
    padding: 0.125em;
    border-radius: 0.25em;
    border: 0.03125em solid rgba(255, 255, 255, 0.08);
    background: #15121e;
  }
  .cs-ext-react-hot { background: #373245; border-color: transparent; }
  .cs-ext-react-mid { background: #231f2f; }
  .cs-ext-react img { width: 0.75em; height: 0.75em; display: block; }
  .cs-ext-react span {
    font-size: 0.5em;         /* 8 */
    line-height: 1.22;
    font-weight: 500;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .cs-ext-share {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 0.923em;
    padding: 0.1539em 0.2308em;
    border-radius: 0.2609em;
    background: rgba(141, 122, 255, 0.12);
    box-shadow:
      inset 0 0.0769em 0.1154em -0.0625em rgba(255, 255, 255, 0.07),
      inset 0 -0.0385em 0.1154em -0.125em rgba(255, 255, 255, 0.07),
      0 0.0385em 0.0385em -0.03125em rgba(0, 0, 0, 0.12);
    flex: none;
  }
  .cs-ext-share-t {
    padding-inline: 0.1539em;
    font-size: 0.4231em;      /* 6.77 */
    line-height: 1.4544;      /* 9.85 */
    font-weight: 600;
    color: #d1b2ff;
    white-space: nowrap;
  }
  .cs-ext-share-i { width: 0.3314em; height: 0.3314em; display: block; }
  .cs-ext-share-i-lg { width: 0.5384em; height: 0.5384em; }
  .cs-ext-meta .cs-ext-share-solo {
    margin-left: auto;
    font-size: 2em; /* meta is 8px-based; restore the 16px em basis */
  }

  /* ---- Label / body rows: label cols 1-6, body cols 6-13 (549px start and
         747px measure in the file — exactly the col-6 boundary). ---- */
  .cs-rowlabel { grid-column: 1 / 6; align-self: start; }
  .cs-rowbody { grid-column: 6 / 13; text-wrap: balance; }
  /* The fluid grid outgrows a comfortable measure on big monitors — step the
     body's start line right one column at a time, so the block stays near the
     1440 design's 746px but its left edge always sits on a grid line. Each
     threshold is where the current span passes ~880px. (These must follow the
     base rule: same specificity, later wins.) */
  @media (min-width: 1650px) { .cs-rowbody { grid-column: 7 / 13; } }
  @media (min-width: 1980px) { .cs-rowbody { grid-column: 8 / 13; } }
  @media (min-width: 2340px) { .cs-rowbody { grid-column: 9 / 13; } }
  @media (min-width: 2880px) { .cs-rowbody { grid-column: 10 / 13; } }

  /* ---- Feature rows (My TL:DR / Streamhub) ---- */
  .cs-feat-img-left { grid-column: 1 / 10; aspect-ratio: 984 / 806; }
  .cs-feat-img-right { grid-column: 4 / 13; aspect-ratio: 984 / 806; }
  .cs-feat-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .cs-feat-col-right { grid-column: 10 / 13; }
  .cs-feat-col-left { grid-column: 1 / 4; grid-row: 1; }
  .cs-feat-head { display: flex; flex-direction: column; gap: var(--space-2); }
  .cs-feat-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.48;
    letter-spacing: -0.01em;
    font-weight: 400;
    color: #fff;
  }
  .cs-feat-body {
    margin: 0;
    max-width: 280px;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-feat-lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .cs-feat-list { display: flex; flex-direction: column; gap: var(--space-2); }
  .cs-feat-item { display: flex; gap: var(--space-2); align-items: flex-start; }
  .cs-bullet { flex: 0 0 auto; width: 15px; height: 15px; margin-top: 1px; }

  /* ---- 8 · More work ---- */
  .cs-more { padding-block-end: var(--space-8); }
  .cs-more-title {
    grid-column: 1 / -1;
    margin: 0 0 var(--space-6);
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #fff;
  }
  .cs-cards {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--gutter);
  }
  .cs-card { display: flex; flex-direction: column; gap: var(--space-2); color: #fff; }
  .cs-card-media {
    position: relative;
    aspect-ratio: 636 / 551;
    overflow: hidden;
    background: #171718;
  }
  .cs-card-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .cs-card-name { margin: 0; color: #fff; white-space: nowrap; }
  .cs-card-tags { display: flex; align-items: center; gap: var(--space-1); }
  .cs-card-tag { margin: 0; color: rgba(255, 255, 255, 0.5); white-space: nowrap; }
  .cs-card-sep { width: 1px; height: 13px; background: rgba(255, 255, 255, 0.1); }

  /* ---- Responsive: collapse to single column under 900px ---- */
  @media (max-width: 900px) {
    .cs-info, .cs-standfirst,
    .cs-rowlabel, .cs-rowbody,
    .cs-pair-a-left, .cs-pair-a-right, .cs-pair-b-left, .cs-pair-b-right,
    .cs-pair-half-left, .cs-pair-half-right,
    .cs-pair-narrow-left, .cs-pair-broad-right,
    .cs-img-wide,
    .cs-feat-img-left, .cs-feat-img-right,
    .cs-feat-col-left, .cs-feat-col-right { grid-column: 1 / -1; }
    .cs-feat-col-left { grid-row: auto; }
    .cs-feat-body { max-width: none; }
    .cs-pair-a-left, .cs-pair-a-right, .cs-pair-b-left, .cs-pair-b-right,
    .cs-pair-half-left, .cs-pair-half-right,
    .cs-pair-narrow-left, .cs-pair-broad-right { height: clamp(280px, 60vw, 480px); aspect-ratio: auto; }
    .cs-img-wide { height: clamp(300px, 64vw, 520px); aspect-ratio: auto; }
    /* The scheduled-posts card is content-sized HTML — its stacked mobile
       layout is taller than the pairs' clamped height, so let the panel
       wrap the card instead of clipping it. */
    .cs-usp-panel { height: auto; aspect-ratio: auto; }
    .cs-usp-center { position: static; padding: var(--space-3); }
    /* The extension composition scales off panel width — keep the file's
       ratio here or the mock loses its bottom breathing room again. */
    .cs-ext-panel { height: auto; aspect-ratio: 746 / 648; }
    .cs-cards { grid-template-columns: 1fr; }
    .cs-card-tags { display: none; }
  }
</style>

<style is:global>
  /* ---- Upcoming Scheduled Posts (usp-*) ----
     Component styles for the scheduled-posts card in Product Design.
     Global, not scoped: the skeleton rows are injected by script at
     runtime, so Astro's scope attribute would never reach them. Every
     selector is usp-prefixed — nothing can leak. Colors/typography are
     the product's real design tokens, not the site scale, matching how
     the Twitch extension rebuild carries its own file-exact values. */
  .usp-card {
    --usp-font: 'Open Sauce Two', 'Inter', -apple-system, BlinkMacSystemFont,
      'Segoe UI', Roboto, sans-serif;
    --usp-surface-0: #111111;   /* card            */
    --usp-surface-1: #161616;   /* post item       */
    --usp-surface-2: #202020;   /* button          */
    --usp-hairline: rgba(255, 255, 255, 0.07);
    --usp-text-high: #ffffff;
    --usp-text-med: rgba(255, 255, 255, 0.72);
    --usp-text-low: rgba(255, 255, 255, 0.48);
    --usp-bone: rgba(255, 255, 255, 0.05);
    --usp-bone-strong: rgba(255, 255, 255, 0.07);
    --usp-accent: rgba(193, 151, 255, 0.4); /* landing glow */

    position: relative;
    overflow: hidden;
    width: min(640px, 100%);
    border: 1px solid var(--usp-hairline);
    border-radius: 24px;
    background: var(--usp-surface-0);
    padding: 24px;
    font-family: var(--usp-font);
    box-shadow:
      0px 56px 56px -28px rgba(0, 0, 0, 0.04),
      0px 32px 32px -16px rgba(0, 0, 0, 0.04),
      0px 6px 6px -3px rgba(0, 0, 0, 0.04),
      0px 3px 3px -1.5px rgba(0, 0, 0, 0.04),
      0px 1px 1px -0.5px rgba(0, 0, 0, 0.04);
  }

  .usp-layout { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 560px) {
    .usp-layout { flex-direction: row; }
  }

  .usp-head {
    min-width: 215px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }
  .usp-title {
    margin: 0;
    font-size: 22px;
    line-height: 32px;
    font-weight: 400;
    color: var(--usp-text-high);
  }
  .usp-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 32px;
    padding: 8px;
    border: 0;
    border-radius: 8px;
    background: var(--usp-surface-2);
    color: var(--usp-text-med);
    font-family: var(--usp-font);
    font-size: 11px;
    line-height: 16px;
    font-weight: 500;
    cursor: pointer;
    box-shadow:
      0px -1px 3px -2px rgba(0, 0, 0, 0.07) inset,
      0px 2px 3px -1px rgba(255, 255, 255, 0.07) inset,
      0px 1px 1px -0.5px rgba(0, 0, 0, 0.04);
    transition: background 0.2s ease;
  }
  .usp-cta:hover { background: #272727; }
  .usp-cta svg { display: block; }

  /* posts column — skeleton layer and live layer stacked in one cell */
  .usp-list {
    flex: 1;
    min-width: 0;
    height: 288px; /* fits the 3 populated posts; skeleton clips under the fade */
    display: grid;
  }
  /* Stacked layout only: flex: 1's 0% basis is vertical there, so the list
     would content-size to the 560px skeleton and ignore the height above.
     (Must come after the base rule — media queries don't add specificity.) */
  @media (max-width: 559.98px) {
    .usp-list { flex: none; }
  }
  .usp-empty, .usp-posts { grid-area: 1 / 1; }

  /* ---- day header row (shared by both layers) ---- */
  .usp-dayrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
  }
  .usp-day {
    font-size: 11px;
    line-height: 16px;
    color: var(--usp-text-med);
    white-space: nowrap;
  }
  .usp-divider {
    flex: 1;
    height: 1px;
    border-radius: 999px;
    background: var(--usp-hairline);
  }

  /* ---- post item ---- */
  .usp-item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border: 1px solid var(--usp-hairline);
    border-radius: 8px;
    background: var(--usp-surface-1);
    padding: 8px;
    margin-bottom: 8px;
  }
  .usp-item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .usp-time {
    font-size: 11px;
    line-height: 16px;
    color: var(--usp-text-low);
  }
  .usp-platforms { display: flex; align-items: center; gap: 6px; }
  .usp-platforms svg { display: block; }
  .usp-item-title {
    margin: 0;
    font-size: 11px;
    line-height: 16px;
    font-weight: 400;
    color: var(--usp-text-high);
  }

  /* ---- skeleton (empty state) ---- */
  .usp-empty {
    position: relative;
    overflow: hidden;
    transition: opacity 0.45s ease;
  }
  .usp-bones { opacity: 0.5; }
  .usp-bone { border-radius: 8px; background: var(--usp-bone); display: block; }
  .usp-bone--day { height: 8px; width: 88px; }
  .usp-bone--time { height: 8px; width: 68px; }
  .usp-bone--title { height: 8px; background: var(--usp-bone-strong); }
  .usp-bone--dot { height: 14px; width: 14px; border-radius: 999px; }

  .usp-pill-wrap {
    pointer-events: none;
    position: absolute;
    inset: 118px 0 auto 0;
    display: flex;
    justify-content: center;
    z-index: 10;
  }
  .usp-pill {
    font-size: 18px;
    line-height: 24px;
    font-weight: 500;
    color: var(--usp-text-med);
    border: 1px solid var(--usp-hairline);
    border-radius: 8px;
    background: rgba(22, 22, 22, 0.9);
    padding: 8px 16px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow:
      0 18px 48px rgba(0, 0, 0, 0.52),
      0 6px 18px rgba(0, 0, 0, 0.38);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  /* ---- live layer ---- */
  .usp-posts {
    position: relative;
    z-index: 5;
    visibility: hidden;
    transition: opacity 0.4s ease;
  }
  .usp-posts.usp-live { visibility: visible; }

  /* rows start hidden; .usp-in plays the entrance */
  .usp-posts .usp-row,
  .usp-posts .usp-item {
    opacity: 0;
  }
  .usp-posts .usp-row.usp-in {
    animation: usp-enter 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .usp-posts .usp-item.usp-in {
    animation:
      usp-enter 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards,
      usp-land 1.1s ease-out forwards;
  }
  @keyframes usp-enter {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  /* brief brand-tinted border glow as each card lands */
  @keyframes usp-land {
    0%   { border-color: var(--usp-accent); box-shadow: 0 0 0 3px rgba(193, 151, 255, 0.12); }
    100% { border-color: var(--usp-hairline); box-shadow: 0 0 0 0 rgba(193, 151, 255, 0); }
  }

  /* exit states driven by JS */
  .usp-out { opacity: 0 !important; transform: translateY(-6px) scale(0.97); }
  .usp-fade { opacity: 0 !important; }

  /* bottom fade — same as production */
  .usp-fadeout {
    pointer-events: none;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 103px;
    background: linear-gradient(to bottom, rgba(17, 17, 17, 0), #111111);
    z-index: 8;
  }

  @media (prefers-reduced-motion: reduce) {
    .usp-posts .usp-row, .usp-posts .usp-item { opacity: 1 !important; animation: none !important; }
    .usp-posts { visibility: visible !important; }
    .usp-empty { opacity: 0 !important; }
  }
</style>

<style is:global>
  /* Case-study selection tint (TL;DR purple): overrides the site-wide charcoal
     band — page CSS loads after global.css, so this wins here and ships
     only with this page. */
  ::selection {
    background: #241b31;
    color: #c9a8ff;
    text-shadow: 0 0 12px rgba(193, 151, 255, 0.45);
  }
</style>
