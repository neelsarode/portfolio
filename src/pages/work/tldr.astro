<!-- Same reveal system as the homepage: masked line rises + media fades per
     [data-reveal-group], wired to Lenis. gsap.from only — no-JS/reduced-motion
     visitors simply see the content. -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.registerPlugin(ScrollTrigger);

    const wireLenis = () => {
      const lenis = (window as any).lenis;
      if (lenis) lenis.on("scroll", ScrollTrigger.update);
    };
    (window as any).lenis
      ? wireLenis()
      : addEventListener("lenis:init", wireLenis, { once: true });

    // Panel loops autoplay below the fold, and Chrome's offscreen media
    // optimisation can pause them there without resuming on scroll — same
    // failure mode the homepage covers solve. Gate each on visibility.
    document
      .querySelectorAll<HTMLVideoElement>("video.cs-ext-bg, .cs-img > video, .cs-frame > video")
      .forEach((v) => {
        new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) v.play().catch(() => {});
              else v.pause();
            });
          },
          { rootMargin: "160px" },
        ).observe(v);
      });

    gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
      const risers = group.querySelectorAll(".mask > *");
      const fades = group.querySelectorAll("[data-fade]");
      const tl = gsap.timeline({
        scrollTrigger: { trigger: group, start: "top 82%", once: true },
      });
      if (risers.length) {
        tl.from(risers, {
          yPercent: 110,
          duration: 0.9,
          ease: "power4.out",
          stagger: 0.09,
        });
      }
      if (fades.length) {
        tl.from(fades, { opacity: 0, duration: 0.9, ease: "power2.out" }, 0.1);
      }
    });
  } else {
    // Reduced motion: the hero and extension loops stay on their posters.
    document.querySelectorAll<HTMLVideoElement>("video.cs-hero-img, video.cs-ext-bg, .cs-img > video, .cs-frame > video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
      v.currentTime = 0;
    });
  }
</script>

<script>
  // Section tabs: sticky bar with scroll-spy and smooth jumps (Lenis when
  // it's running, native scroll otherwise). In-page links elsewhere on the
  // page (the three-call cards) use the same jump so they land clear of
  // the bar.
  const bar = document.querySelector<HTMLElement>(".cs-tabs");
  const sentinel = document.querySelector<HTMLElement>(".cs-tabs-sentinel");
  const list = bar?.querySelector<HTMLElement>(".cs-tabs-list");
  const ink = bar?.querySelector<HTMLElement>(".cs-tabs-ink");

  if (bar && sentinel && list && ink) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tabs = Array.from(bar.querySelectorAll<HTMLAnchorElement>(".cs-tab"));
    const targets = tabs.map((t) => document.getElementById(t.hash.slice(1)));
    let current = -1;
    let locked = false;
    let unlockTimer: ReturnType<typeof setTimeout> | undefined;

    const moveInk = () => {
      const tab = tabs[current];
      if (!tab) return;
      ink.style.width = `${tab.offsetWidth}px`;
      ink.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      tabs.forEach((t, k) => {
        if (k === i) t.setAttribute("aria-current", "true");
        else t.removeAttribute("aria-current");
      });
      moveInk();
      // Narrow screens scroll the strip sideways: keep the active tab in it.
      if (list.scrollWidth > list.clientWidth) {
        const tab = tabs[i];
        list.scrollTo({
          left: tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2,
          behavior: reduce ? "auto" : "smooth",
        });
      }
    };

    // Active = the last section whose top has crossed 30% of the viewport.
    const spy = () => {
      if (locked) return;
      const line = innerHeight * 0.3;
      let i = 0;
      targets.forEach((el, k) => {
        if (el && el.getBoundingClientRect().top <= line) i = k;
      });
      setActive(i);
    };

    let ticking = false;
    addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        spy();
      });
    }, { passive: true });
    addEventListener("resize", () => { moveInk(); spy(); });
    // Fonts settle tab widths after first paint.
    document.fonts?.ready.then(moveInk);

    // Stuck state: the sentinel sits right above the bar, so once it has
    // scrolled out of the top the bar is pinned.
    new IntersectionObserver(([e]) => {
      bar.classList.toggle("is-stuck", !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(sentinel);

    const release = () => {
      clearTimeout(unlockTimer);
      locked = false;
      spy();
    };
    // A wheel or touch mid-jump hands control back to the reader.
    addEventListener("wheel", () => { if (locked) release(); }, { passive: true });
    addEventListener("touchstart", () => { if (locked) release(); }, { passive: true });

    // Content lands one --space-4 below the pinned bar; Overview instead
    // scrolls just past the sentinel, so the bar pins exactly at the top.
    const jump = (el: HTMLElement, tabIndex?: number) => {
      const offset = el === sentinel ? 1 : -(bar.offsetHeight + 32);
      if (tabIndex !== undefined) {
        setActive(tabIndex);
        locked = true;
        unlockTimer = setTimeout(release, 1800);
      }
      const lenis = (window as any).lenis;
      if (lenis) {
        // Lenis already honours the target's scroll-margin-top (set in CSS
        // for native hash loads), so take it back out of the offset.
        const margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
        lenis.scrollTo(el, { offset: offset + margin, duration: 1.2, onComplete: release });
      } else {
        const top = el.getBoundingClientRect().top + scrollY + offset;
        scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
        if (tabIndex !== undefined) {
          clearTimeout(unlockTimer);
          unlockTimer = setTimeout(release, reduce ? 50 : 900);
        }
      }
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", (e) => {
        const el = targets[i];
        if (!el) return;
        e.preventDefault();
        // Overview jumps to the very top of the chapters, bar included.
        if (i === 0) jump(sentinel, 0);
        else jump(el, i);
        history.replaceState(null, "", t.hash);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('.cs-chapters a[href^="#"]:not(.cs-tab)').forEach((a) => {
      a.addEventListener("click", (e) => {
        const el = document.getElementById(a.hash.slice(1));
        if (!el) return;
        e.preventDefault();
        jump(el);
      });
    });

    spy();
  }
</script>

<script>
  // Product UI panels. Each .cs-ui host gets a shadow root holding a snapshot
  // of the TL;DR prototype's markup + CSS (public/tldr-ui/<id>.html), laid
  // out at 1600px and scaled to the host via --k. Snapshots load as their
  // panel approaches; all four are also warmed once the page is idle so a
  // tab jump rarely lands on an empty panel.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hosts = Array.from(document.querySelectorAll<HTMLElement>(".cs-ui[data-ui]"));
  const cache = new Map<string, Promise<string>>();
  const load = (id: string) => {
    if (!cache.has(id)) {
      cache.set(id, fetch(`/tldr-ui/${id}.html`).then((r) => (r.ok ? r.text() : Promise.reject(r.status))));
    }
    return cache.get(id)!;
  };
  const fit = (h: HTMLElement) => h.style.setProperty("--k", String(h.clientWidth / 1600));
  const ro = new ResizeObserver((es) => es.forEach((e) => fit(e.target as HTMLElement)));

  const mount = async (h: HTMLElement) => {
    if (h.shadowRoot) return;
    let html: string;
    try {
      html = await load(h.dataset.ui!);
    } catch {
      return;
    }
    const root = h.attachShadow({ mode: "open" });
    root.innerHTML = html;
    h.inert = true;
    fit(h);
    ro.observe(h);
    if (h.dataset.anim) animate(h);
  };

  const near = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (!e.isIntersecting) return;
      near.unobserve(e.target);
      mount(e.target as HTMLElement);
    });
  }, { rootMargin: "1200px 0px" });
  hosts.forEach((h) => near.observe(h));

  const idle: (cb: () => void) => void =
    (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1500));
  idle(() => new Set(hosts.map((h) => h.dataset.ui!)).forEach((id) => load(id).catch(() => {})));

  // ---- Animated panels (Web Animations API + timers) ----
  type Anim = { start: () => void; stop: () => void };
  const EASE_OUT = "cubic-bezier(0.23, 1, 0.32, 1)";
  const EASE_MOVE = "cubic-bezier(0.77, 0, 0.175, 1)";
  const nf = new Intl.NumberFormat("en-US");
  const leaf = (root: ParentNode, re: RegExp) => {
    const all = root.querySelectorAll<HTMLElement>("span, div, p");
    for (const el of all) if (el.children.length === 0 && re.test(el.textContent!.trim())) return el;
    return null;
  };
  const scaleOf = (root: ShadowRoot) => root.querySelector(".snap-html")!.getBoundingClientRect().width / 1600;
  const bump = (el: HTMLElement, v: number) => {
    el.textContent = nf.format(v);
    el.style.display = "inline-block";
    el.animate([{ transform: "translateY(35%)", opacity: 0.25 }, { transform: "none", opacity: 1 }], { duration: 320, easing: EASE_OUT });
  };

  // A new clip lands at the front of today's stream; the rest reflow (FLIP).
  function clipsAnim(root: ShadowRoot): Anim | null {
    const grid = root.querySelector<HTMLElement>(".clips-grid");
    if (!grid || grid.children.length < 2) return null;
    const tick = () => {
      const k = scaleOf(root) || 1;
      const cards = Array.from(grid.children) as HTMLElement[];
      const before = cards.map((c) => c.getBoundingClientRect());
      const last = cards[cards.length - 1];
      const fresh = last.cloneNode(true) as HTMLElement;
      grid.insertBefore(fresh, grid.firstChild);
      grid.removeChild(last);
      cards.slice(0, -1).forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const dx = (before[i].left - r.left) / k;
        const dy = (before[i].top - r.top) / k;
        if (dx || dy) c.animate([{ transform: `translate(${dx}px,${dy}px)` }, { transform: "none" }], { duration: 640, easing: EASE_MOVE });
      });
      fresh.animate([{ opacity: 0, transform: "scale(0.94)" }, { opacity: 1, transform: "none" }], { duration: 520, delay: 200, easing: EASE_OUT, fill: "backwards" });
      const card = fresh.firstElementChild as HTMLElement;
      const ring = document.createElement("div");
      ring.style.cssText = `position:absolute;inset:0;pointer-events:none;opacity:0;border-radius:${getComputedStyle(card).borderRadius};box-shadow:0 0 0 2px #9851FB,0 0 40px rgba(152,81,251,.5)`;
      fresh.appendChild(ring);
      ring.animate([{ opacity: 0 }, { opacity: 1, offset: 0.15 }, { opacity: 0 }], { duration: 2400, delay: 240, easing: "ease-out" }).onfinish = () => ring.remove();
      const badge = fresh.querySelector<HTMLElement>('[class*="right-[10px]"]');
      const score = badge && leaf(badge, /^\d{1,3}$/);
      if (score) {
        const to = +score.textContent!;
        let t0: number | null = null;
        score.textContent = "0";
        const step = (t: number) => {
          if (t0 === null) t0 = t;
          const p = Math.min(1, (t - t0 - 300) / 700);
          if (p > 0) score.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    };
    let timer: ReturnType<typeof setTimeout> | null = null;
    return {
      start: () => {
        if (timer) return;
        const run = () => { tick(); timer = setTimeout(run, 3600); };
        timer = setTimeout(run, 900);
      },
      stop: () => { if (timer) clearTimeout(timer); timer = null; },
    };
  }

  // Mid-stream: the chat line draws in, then views, chats and clips count up.
  function liveAnim(root: ShadowRoot): Anim | null {
    const views = leaf(root, /^48,219$/);
    const chats = leaf(root, /^2,479$/);
    const clips = leaf(root, /^86$/);
    const voice = leaf(root, /^24$/);
    const path = root.querySelector<SVGPathElement>('svg path[stroke="currentColor"][stroke-width="2"]');
    const dot = path?.parentNode?.querySelector<SVGCircleElement>("circle");
    if (!views || !clips || !path || !dot) return null;
    const n = { views: 48219, chats: 2479, clips: 86, voice: 24 };
    let drawn = false;
    let timers: ReturnType<typeof setInterval>[] = [];
    let pulse: Animation | null = null;
    const ring = dot.cloneNode(false) as SVGCircleElement;
    ring.removeAttribute("class");
    ring.setAttribute("fill", "none");
    ring.setAttribute("stroke-width", "2");
    ring.style.transformBox = "fill-box";
    ring.style.transformOrigin = "center";
    ring.style.opacity = "0";
    dot.parentNode!.insertBefore(ring, dot);
    let tickN = 0;
    return {
      start: () => {
        if (!drawn) {
          drawn = true;
          const L = path.getTotalLength();
          path.style.strokeDasharray = String(L);
          path.animate([{ strokeDashoffset: L }, { strokeDashoffset: 0 }], { duration: 1600, easing: EASE_OUT });
          dot.style.transformBox = "fill-box";
          dot.style.transformOrigin = "center";
          dot.animate([{ opacity: 0, transform: "scale(0.5)" }, { opacity: 1, transform: "none" }], { duration: 360, delay: 1350, easing: EASE_OUT, fill: "backwards" });
        }
        if (!pulse) pulse = ring.animate([{ transform: "scale(1)", opacity: 0.7 }, { transform: "scale(2.6)", opacity: 0 }], { duration: 1800, delay: 1600, iterations: Infinity, easing: EASE_OUT });
        else pulse.play();
        if (!timers.length) {
          timers.push(setInterval(() => {
            n.views += 7 + Math.floor(Math.random() * 30);
            bump(views, n.views);
            n.chats += 1 + Math.floor(Math.random() * 8);
            if (chats) bump(chats, n.chats);
          }, 1700));
          timers.push(setInterval(() => {
            tickN++;
            n.clips++;
            bump(clips, n.clips);
            if (tickN % 3 === 0 && voice) { n.voice++; bump(voice, n.voice); }
          }, 4300));
        }
      },
      stop: () => { timers.forEach(clearInterval); timers = []; pulse?.pause(); },
    };
  }

  // Runs only while the panel is on screen and the tab is visible; each has
  // a Pause/Play button. Reduced motion: no animation, no button.
  function animate(h: HTMLElement) {
    if (reduce || !h.shadowRoot) return;
    const a = (h.dataset.anim === "clips" ? clipsAnim : liveAnim)(h.shadowRoot);
    const fig = h.closest("figure");
    const btn = fig?.querySelector<HTMLButtonElement>(".cs-abtn");
    if (!a || !fig || !btn) return;
    let paused = false;
    let seen = false;
    btn.hidden = false;
    const sync = () => {
      btn.textContent = paused ? "Play" : "Pause";
      btn.setAttribute("aria-pressed", paused ? "true" : "false");
      btn.setAttribute("aria-label", `${paused ? "Play" : "Pause"} animation`);
      if (seen && !paused && !document.hidden) a.start();
      else a.stop();
    };
    btn.addEventListener("click", () => { paused = !paused; sync(); });
    // Watch the figure: the UI inside is larger than its panel.
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: 0.3 }).observe(fig);
    document.addEventListener("visibilitychange", sync);
    sync();
  }
</script>

<script>
  // Chat activity demo: an example 3-hour stream in 5-minute readings, with
  // the clips captured in it. Moving along the line (pointer, or the hidden
  // range input by keyboard) reads out the chats and reveals the clips.
  const CHATS = [18, 34, 41, 47, 52, 58, 64, 131, 78, 70, 74, 81, 88, 176, 102, 94, 99, 105, 112, 121, 138, 248, 151, 140, 133, 129, 136, 142, 150, 231, 160, 148, 152, 158, 214, 166];
  type Clip = { kind: "ai" | "voice"; title: string; score: number; wake?: string };
  const CLIPS: Record<number, Clip> = {
    7: { kind: "ai", title: "Boss kill on hardcore mode", score: 74 },
    13: { kind: "voice", wake: "Clip it", title: "Funniest reaction of the stream", score: 63 },
    21: { kind: "voice", wake: "Clip that", title: "Insane 1v5 clutch moment", score: 92 },
    29: { kind: "ai", title: "Chat loses it after this play", score: 88 },
    34: { kind: "ai", title: "Unbelievable no-scope", score: 79 },
  };
  const plot = document.getElementById("plot");
  const line = document.getElementById("chat-line");

  if (plot && line) {
    const N = CHATS.length;
    const MAX = 270;
    const fmt = new Intl.NumberFormat("en-US");
    const total = CHATS.reduce((a, b) => a + b, 0);
    const X = (i: number) => (i / (N - 1)) * 1000;
    const Y = (v: number) => 300 - (v / MAX) * 300;

    // Monotone cubic (Fritsch–Carlson) tangents: the curve never overshoots.
    const d: number[] = [];
    const m: number[] = [];
    for (let i = 0; i < N - 1; i++) d.push(CHATS[i + 1] - CHATS[i]);
    m[0] = d[0];
    m[N - 1] = d[N - 2];
    for (let i = 1; i < N - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;
    for (let i = 0; i < N - 1; i++) {
      if (d[i] === 0) { m[i] = 0; m[i + 1] = 0; continue; }
      const a = m[i] / d[i], b = m[i + 1] / d[i], s = a * a + b * b;
      if (s > 9) { const t = 3 / Math.sqrt(s); m[i] = t * a * d[i]; m[i + 1] = t * b * d[i]; }
    }
    const dx = 1000 / (N - 1);
    let path = `M${X(0)},${Y(CHATS[0])}`;
    for (let i = 0; i < N - 1; i++) {
      path += ` C${X(i) + dx / 3},${Y(CHATS[i] + m[i] / 3)} ${X(i + 1) - dx / 3},${Y(CHATS[i + 1] - m[i + 1] / 3)} ${X(i + 1)},${Y(CHATS[i + 1])}`;
    }
    line.setAttribute("d", path);
    // Value on the drawn curve at a fractional index (cubic Hermite).
    const at = (f: number) => {
      const k = Math.min(Math.floor(f), N - 2), t = f - k;
      const h00 = 2 * t ** 3 - 3 * t ** 2 + 1, h10 = t ** 3 - 2 * t ** 2 + t;
      const h01 = -2 * t ** 3 + 3 * t ** 2, h11 = t ** 3 - t ** 2;
      return h00 * CHATS[k] + h10 * m[k] + h01 * CHATS[k + 1] + h11 * m[k + 1];
    };

    const dot = document.getElementById("chat-dot")!;
    const guide = document.getElementById("chat-guide")!;
    const range = document.getElementById("chat-range") as HTMLInputElement;
    const num = document.getElementById("chat-num")!;
    const unit = document.getElementById("chat-unit")!;
    const sub = document.getElementById("chat-sub")!;
    const clipEl = document.getElementById("chat-clip")!;
    const marks = document.getElementById("chat-marks")!;
    const markEls: Record<number, HTMLElement> = {};
    Object.keys(CLIPS).forEach((key) => {
      const k = +key, c = CLIPS[k], el = document.createElement("i");
      el.className = "tl-mk" + (c.kind === "voice" ? " tl-voice" : "");
      el.style.left = `${(k / (N - 1)) * 100}%`;
      el.style.top = `${(Y(CHATS[k]) / 300) * 100}%`;
      marks.appendChild(el);
      markEls[k] = el;
    });
    const when = (min: number) => {
      const h = Math.floor(min / 60), mm = min % 60;
      return h ? `${h}h${mm ? ` ${mm}m` : ""}` : `${mm}m`;
    };
    const tbody = document.querySelector("#chat-table tbody")!;
    CHATS.forEach((v, k) => {
      const tr = document.createElement("tr");
      tr.innerHTML = `<td>${when(k * 5)}</td><td>${v}</td><td>${CLIPS[k] ? CLIPS[k].title : ""}</td>`;
      tbody.appendChild(tr);
    });
    const bolt = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>';
    const clipHtml = (c: Clip) =>
      `<span class="tl-chip tl-chip--type">${c.kind === "voice" ? "Voice Clip" : "AI Clip"}</span>` +
      (c.wake ? `<span class="tl-chip tl-chip--wake">“${c.wake}”</span>` : "") +
      `<strong>${c.title}</strong>` +
      `<span class="tl-chip tl-chip--score" aria-label="Clip score ${c.score} out of 100">${bolt}${c.score}</span>`;
    const place = (f: number) => {
      const x = (f / (N - 1)) * 100;
      dot.style.left = `${x}%`;
      dot.style.top = `${(Y(at(f)) / 300) * 100}%`;
      guide.style.left = `${x}%`;
    };
    let lastNear: number | null = null;
    const show = (f: number) => {
      place(f);
      const k = Math.round(f);
      let nearest: number | null = null;
      for (let j = k - 1; j <= k + 1; j++) if (CLIPS[j]) { nearest = j; break; }
      plot.classList.add("is-scrub");
      num.textContent = fmt.format(Math.round(at(f)));
      unit.textContent = "chats";
      sub.textContent = `${when(Math.round(f * 5))} into the stream`;
      if (nearest !== lastNear) {
        if (lastNear !== null) markEls[lastNear].classList.remove("is-on");
        if (nearest !== null) markEls[nearest].classList.add("is-on");
        clipEl.innerHTML = nearest !== null ? clipHtml(CLIPS[nearest]) : "No clip here. Keep moving to find one of the five.";
        lastNear = nearest;
      }
      range.setAttribute("aria-valuetext", `${when(k * 5)} into the stream, ${CHATS[k]} chats${CLIPS[k] ? `, clip captured: ${CLIPS[k].title}, score ${CLIPS[k].score}` : ""}`);
    };
    const rest = () => {
      place(N - 1);
      plot.classList.remove("is-scrub");
      num.textContent = fmt.format(total);
      unit.textContent = "chats in total";
      sub.textContent = "Example stream, 3 hours";
      if (lastNear !== null) markEls[lastNear].classList.remove("is-on");
      lastNear = null;
      clipEl.innerHTML = "<span>Five clips captured: <strong>three by AI, two by voice</strong>. Move along the line to find them.</span>";
    };
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    plot.addEventListener("pointermove", (e) => {
      if (!fine && e.pointerType !== "mouse") return;
      const r = plot.getBoundingClientRect();
      show(Math.max(0, Math.min(N - 1, ((e.clientX - r.left) / r.width) * (N - 1))));
    });
    plot.addEventListener("pointerleave", () => { if (document.activeElement !== range) rest(); });
    range.addEventListener("input", () => show(+range.value));
    range.addEventListener("focus", () => show(+range.value));
    range.addEventListener("blur", rest);
    rest();
  }
</script>

<script>
  // Dashboard spotlight. Hovering or focusing a question moves the spotlight
  // to its area; while the band is in view it steps through the four by
  // itself, and the active row's top line filling is the timer.
  const dash = document.querySelector<HTMLElement>(".cs-dash");
  if (dash) {
    const items = Array.from(dash.querySelectorAll<HTMLElement>(".cs-qa-item"));
    const spot = dash.querySelector<HTMLElement>(".cs-spot");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let inView = false;
    let hovering = false;

    const set = (i: number) => {
      items.forEach((li) => li.classList.toggle("is-active", li.dataset.i === String(i)));
      const vars = items[i - 1]?.dataset.spot;
      if (spot && vars) spot.setAttribute("style", vars);
    };
    const sync = () => {
      dash.classList.toggle("is-auto", !reduce);
      dash.classList.toggle("is-playing", inView && !hovering);
    };

    items.forEach((li) => {
      const i = Number(li.dataset.i);
      li.addEventListener("pointerenter", () => set(i));
      li.addEventListener("focus", () => set(i));
      li.addEventListener("click", () => set(i));
      li.addEventListener("animationend", (e) => {
        if (e.target === li && e.pseudoElement === "::after") set((i % items.length) + 1);
      });
    });

    // The tour pauses under a mouse and outside the viewport.
    dash.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      hovering = true;
      sync();
    });
    dash.addEventListener("pointerleave", () => {
      hovering = false;
      sync();
    });
    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        sync();
      },
      { threshold: 0.35 },
    ).observe(dash);

    sync();
  }
</script>

<style>
  .content { position: relative; z-index: 1; }

  /* ---- Masked line reveals (same recipe as the homepage) ---- */
  .mask {
    display: block;
    overflow: clip;
    padding-block-end: 0.14em;
    margin-block-end: -0.14em;
  }
  .line { display: block; }

  /* ============================================================
     Type recipes — EXACT values from the Figma file. All Geist 400.
       display title    52 / 1    / -0.04em
       body (24-class)  24 / 1.2  / -0.02em   white, .mut spans 65%
       about statement  24 / 1.15 / -0.02em
       row label        16 / 1.2  / -0.01em   65%
       stat number      24 / 1.15 / -0.02em   · stat sub 16 / 1.15 / 65%
       info label       14 / 1.2  / -0.01em   65%
       info value       14 / 1.48 / -0.01em   white
       feature title    18 / 1.48 / -0.01em   white
       feature body     14 / 1.2  / -0.01em   65% (lead-in white)
       image caption    12 / 1.2  / -0.01em   88%
     ============================================================ */
  .cs-title {
    margin: 0;
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #fff;
  }
  .cs-body {
    margin: 0;
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-statement {
    margin: 0;
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .mut { color: rgba(255, 255, 255, 0.65); }
  .cs-center { text-align: center; text-wrap: balance; }
  .cs-label {
    margin: 0;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-ilabel {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-ivalue {
    margin: 0;
    font-size: 14px;
    line-height: 1.48;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .cs-ilink { text-decoration: underline; text-underline-offset: 3px; }

  /* ---- 1 · Hero ---- */
  .cs-hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--placeholder);
  }
  .cs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.25) 0%, rgba(10, 10, 11, 0) 30%, rgba(10, 10, 11, 0) 55%, rgba(10, 10, 11, 0.55) 100%);
  }
  /* Edge-hug overlay — the homepage hero's exact padding recipe. */
  .cs-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 1.2vw, 20px);
  }
  .cs-nav { padding: 0; }

  /* ---- Section rhythm (from the file: 96 into About, 128 between bands,
         64 around intros and label/body rows, 24 between media rows). ---- */
  .cs-band { padding-block-end: var(--space-8); }
  .cs-about { padding-block: var(--space-7) var(--space-8); }
  .cs-row { margin-block-start: var(--space-6); }
  .cs-intro {
    grid-column: 1 / -1;
    justify-self: center;
    max-width: 702px;
    margin-block-end: var(--space-6);
  }
  .cs-feature { margin-block-start: var(--space-6); }

  /* ---- 2 · About ---- */
  .cs-info {
    grid-column: 1 / 6;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--gutter);
    align-content: start;
  }
  .cs-tile { display: flex; flex-direction: column; gap: var(--space-1); align-content: start; }
  .cs-tile-values { display: flex; flex-direction: column; gap: var(--space-1); }
  .cs-tile-stack { display: flex; flex-direction: column; gap: var(--space-3); }
  .cs-standfirst {
    grid-column: 7 / 13;
    max-width: 618px;
    align-self: center;
    display: flex;
    flex-direction: column;
    /* One blank line at 24/1.15 — the file separates the paragraphs with a
       double break, not a spacing token. */
    gap: 1.15em;
    font-size: clamp(18px, 1.67vw, 24px);
  }

  /* ---- Media panels ----
     The pair/wide widths in the file are whole column spans (see header
     comment). Heights: pairs are 648 at 1440 (45vw), wides 806 (56vw). */
  .cs-img {
    position: relative;
    overflow: hidden;
    background: #171718; /* the file's placeholder fill */
  }
  /* Direct child only: the extension panel nests its own imgs (logo, emoji,
     thumbnails, the stat card's Twitch mark) which size themselves — a bare
     descendant selector here would stretch every one of them to 100%. */
  .cs-img > img,
  .cs-img > video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Heights via aspect-ratio, not clamps: the grid is fluid past 1440, and a
     capped height lets the panels drift wide-and-short there — which pushed
     the extension mock (sized off panel WIDTH) out of the panel's bottom.
     Each ratio is the file's box (row height 648, or 806 for wides), so every
     pair resolves to the same row height at any container width. */
  /* ONE box per row carries the ratio and drives the row height; its partner
     has no ratio and stretches to match. Giving both boxes their own ratio
     leaves them ~2px ragged at wide viewports, because the fixed 24px gutters
     shift each box's width FRACTION slightly as the grid grows. */
  .cs-pair-a-left { grid-column: 1 / 8; aspect-ratio: 746 / 648; }
  .cs-pair-b-right { grid-column: 8 / 13; }
  .cs-pair-b-left { grid-column: 1 / 6; }
  .cs-pair-a-right { grid-column: 6 / 13; aspect-ratio: 746 / 648; }
  .cs-pair-half-left { grid-column: 1 / 7; aspect-ratio: 636 / 648; }
  .cs-pair-half-right { grid-column: 7 / 13; }
  /* 4/8-col approximation of the file's off-grid 360/912 pair. */
  .cs-pair-narrow-left { grid-column: 1 / 5; }
  .cs-pair-broad-right { grid-column: 5 / 13; aspect-ratio: 856 / 648; }
  .cs-img-wide { grid-column: 1 / 13; aspect-ratio: 1296 / 806; }
  .cs-img-caption {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.88);
  }
  /* Variant: caption rides the top edge — for panels whose bottom region
     is busy (the micro-interactions modal fills the lower half). */
  .cs-img-caption-top { bottom: auto; top: var(--space-2); }
  /* Before/After chip (Figma 2589:38875) — top-left partner to the caption.
     The file's 36px chip read massive in situ, so it runs at 16px with the
     dev-chip padding rhythm; the fill maps to the charcoal token. */
  .cs-img-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: var(--space-1) var(--space-2);
    border-radius: 999px;
    background: var(--charcoal);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.15;
    color: #fff;
  }

  /* ---- Stat overlay (bottom-right of a media panel) ---- */
  .cs-stat {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    background: var(--void);
  }
  .cs-stat-num {
    margin: 0;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-stat-sub {
    margin: 0;
    font-size: 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.65);
  }

  /* ---- Hover note (bottom-right corner box, shown on panel hover) ----
     Same box language as .cs-stat, but holds a sentence of copy and only
     appears while the panel is hovered — fades/rises in, reverses out. */
  .cs-hover-note {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 340px;
    margin: 0;
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    background: var(--void);
    font-size: 14px;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.88);
    opacity: 0;
    transform: translateY(var(--space-1));
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-img:hover > .cs-hover-note {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-hover-note { transition: none; transform: none; }
  }

  /* Brand stat card variant: Twitch logo row above the numbers (gap 32). */
  .cs-stat-brand { gap: var(--space-4); }
  .cs-stat-logo-row { display: flex; align-items: center; gap: var(--space-1); }
  .cs-stat-twitch { width: 56px; height: auto; display: block; }
  .cs-stat-store {
    margin: 0;
    white-space: nowrap;
    font-size: 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-stat-nums { display: flex; flex-direction: column; gap: var(--space-1); }

  /* ============================================================
     Twitch extension — rebuilt as HTML (Figma 2549:24992).
     The frame is 318×496 at (80,89) inside the 746×648 panel. The panel is
     a size container and the mock's font-size is set in cqw so that 1em on
     the mock equals 16 design-px AT ANY PANEL WIDTH — every internal
     measurement below is the Figma px value divided by 16.
     Product type is Open Sauce Two (self-hosted below); the two 8px meta
     runs are Inter Display in the file and fall back to Geist here.
     ============================================================ */
  @font-face {
    font-family: "Open Sauce Two";
    src: url("/fonts/OpenSauceTwo-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Open Sauce Two";
    src: url("/fonts/OpenSauceTwo-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .cs-ext-panel { container-type: inline-size; }
  .cs-ext-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cs-ext {
    position: absolute;
    left: 10.72%;          /* 80 / 746 */
    top: 13.73%;           /* 89 / 648 */
    width: 42.63%;         /* 318 / 746 */
    height: 31em;          /* 496 — clips the list mid-card, per the file */
    font-size: 16px;       /* fallback if container queries are unsupported */
    font-size: 2.1447cqw;  /* 16px × (panel / 746) */
    font-family: "Open Sauce Two", var(--font-geist-sans);
    display: flex;
    flex-direction: column;
    gap: 1em;
    padding: 3em 1em 1em;  /* 48 / 16 / 16 — header bar sits in the top 32 */
    border-radius: 0.25em;
    background: #201c2b;
    overflow: hidden;
    /* The file's five-layer ambient shadow, in em so it scales too. */
    box-shadow:
      9.9375em 17.6875em 5.6875em rgba(0, 0, 0, 0.01),
      6.3125em 11.3125em 5.1875em rgba(0, 0, 0, 0.04),
      3.5625em 6.375em 4.375em rgba(0, 0, 0, 0.15),
      1.5625em 2.8125em 3.25em rgba(0, 0, 0, 0.26),
      0.375em 0.6875em 1.8125em rgba(0, 0, 0, 0.29);
  }
  .cs-ext p { margin: 0; }

  /* Header bar: logo left, Capturing Clips pill right. */
  .cs-ext-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2em;
    background: rgba(255, 255, 255, 0.05);
  }
  .cs-ext-logo {
    position: absolute;
    left: 0.6875em;
    top: 0.5625em;
    width: 3.0625em;
    height: 0.8346em;
  }
  .cs-ext-logo img { width: 100%; height: 100%; display: block; }
  /* The purple semicolon of the logotype — drawn as pixels in the file. */
  .cs-ext-px { position: absolute; background: #c197ff; }
  .cs-ext-px1 { left: 2.0394em; top: 0.6825em; width: 0.1816em; height: 0.1816em; }
  .cs-ext-px2 { left: 2.0394em; top: 1.0338em; width: 0.1816em; height: 0.1816em; }
  .cs-ext-px3 { left: 2.1306em; top: 1.2156em; width: 0.0908em; height: 0.1816em; }
  .cs-ext-pill {
    position: absolute;
    right: 0.2856em;
    top: 0.25em;
    height: 1.5em;
    display: flex;
    align-items: center;
    gap: 0.125em;
    padding: 0.25em;
    border-radius: 0.25em;
    background: rgba(141, 122, 255, 0.12);
    box-shadow:
      inset 0 0.125em 0.1875em rgba(255, 255, 255, 0.07),
      inset 0 -0.0625em 0.1875em -0.0625em rgba(255, 255, 255, 0.07);
  }
  .cs-ext-pill-icon { position: relative; width: 0.7143em; height: 0.7143em; flex: none; }
  .cs-ext-pill-icon img {
    position: absolute;
    inset: -5% -13.2% -29.61% -13.21%;
    width: auto;
    height: auto;
  }
  .cs-ext-pill-text {
    padding-inline: 0.125em;
    font-size: 0.6875em;      /* 11 */
    line-height: 1.4545;      /* 16 */
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
  }

  /* Stream Highlights + avatar */
  .cs-ext-row { display: flex; align-items: center; justify-content: space-between; }
  .cs-ext-h {
    font-size: 0.9375em;      /* 15 */
    line-height: 1.6;         /* 24 */
    font-weight: 600;
    color: #fff;
  }
  .cs-ext-avatar {
    position: relative;
    width: 1.5em;
    height: 1.5em;
    flex: none;
    border-radius: 0.125em;
    border: 0.033em solid rgba(255, 255, 255, 0.17);
    overflow: hidden;
  }
  .cs-ext-avatar img {
    position: absolute;
    left: 0;
    top: -24.92%;             /* the file's crop of the portrait */
    width: 100%;
    height: 199.1%;
    max-width: none;
  }

  /* Clip cards */
  .cs-ext-card { display: flex; flex-direction: column; gap: 1em; }
  .cs-ext-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 132 / 74;
    border-radius: 0.25em;
    border: 0.0625em solid rgba(255, 255, 255, 0.17);
    overflow: hidden;
  }
  .cs-ext-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cs-ext-cap { display: flex; flex-direction: column; gap: 0.375em; }
  .cs-ext-title {
    font-size: 0.6875em;      /* 11 */
    line-height: 1.4545;      /* 16 */
    font-weight: 600;
    color: #fff;
  }
  .cs-ext-meta {
    display: flex;
    align-items: center;
    gap: 1em; /* meta font is 8px, so 1em = the file's 8px gap */
    font-family: var(--font-geist-sans); /* Inter Display in the file */
    font-size: 0.5em;         /* 8 */
    font-weight: 500;
    line-height: normal;
    color: #fff;
  }
  .cs-ext-dim { color: rgba(255, 255, 255, 0.59); }
  /* Inside the 8px meta row, so 1.75em/1.875em = the file's 14×15. */
  .cs-ext-badge { width: 1.75em; height: 1.875em; flex: none; }
  .cs-ext-badge img { width: 100%; height: 100%; display: block; }

  .cs-ext-actions { display: flex; align-items: flex-start; justify-content: space-between; }
  .cs-ext-reacts { display: flex; align-items: center; gap: 0.125em; }
  .cs-ext-react {
    display: flex;
    align-items: center;
    gap: 0.125em;
    padding: 0.125em;
    border-radius: 0.25em;
    border: 0.03125em solid rgba(255, 255, 255, 0.08);
    background: #15121e;
  }
  .cs-ext-react-hot { background: #373245; border-color: transparent; }
  .cs-ext-react-mid { background: #231f2f; }
  .cs-ext-react img { width: 0.75em; height: 0.75em; display: block; }
  .cs-ext-react span {
    font-size: 0.5em;         /* 8 */
    line-height: 1.22;
    font-weight: 500;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .cs-ext-share {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 0.923em;
    padding: 0.1539em 0.2308em;
    border-radius: 0.2609em;
    background: rgba(141, 122, 255, 0.12);
    box-shadow:
      inset 0 0.0769em 0.1154em -0.0625em rgba(255, 255, 255, 0.07),
      inset 0 -0.0385em 0.1154em -0.125em rgba(255, 255, 255, 0.07),
      0 0.0385em 0.0385em -0.03125em rgba(0, 0, 0, 0.12);
    flex: none;
  }
  .cs-ext-share-t {
    padding-inline: 0.1539em;
    font-size: 0.4231em;      /* 6.77 */
    line-height: 1.4544;      /* 9.85 */
    font-weight: 600;
    color: #d1b2ff;
    white-space: nowrap;
  }
  .cs-ext-share-i { width: 0.3314em; height: 0.3314em; display: block; }
  .cs-ext-share-i-lg { width: 0.5384em; height: 0.5384em; }
  .cs-ext-meta .cs-ext-share-solo {
    margin-left: auto;
    font-size: 2em; /* meta is 8px-based; restore the 16px em basis */
  }

  /* ---- Label / body rows: label cols 1-6, body cols 6-13 (549px start and
         747px measure in the file — exactly the col-6 boundary). ---- */
  .cs-rowlabel { grid-column: 1 / 6; align-self: start; }
  .cs-rowbody { grid-column: 6 / 13; text-wrap: balance; }
  /* The fluid grid outgrows a comfortable measure on big monitors — step the
     body's start line right one column at a time, so the block stays near the
     1440 design's 746px but its left edge always sits on a grid line. Each
     threshold is where the current span passes ~880px. (These must follow the
     base rule: same specificity, later wins.) */
  @media (min-width: 1650px) { .cs-rowbody { grid-column: 7 / 13; } }
  @media (min-width: 1980px) { .cs-rowbody { grid-column: 8 / 13; } }
  @media (min-width: 2340px) { .cs-rowbody { grid-column: 9 / 13; } }
  @media (min-width: 2880px) { .cs-rowbody { grid-column: 10 / 13; } }

  /* ---- Feature rows (My TL:DR / Streamhub) ---- */
  .cs-feat-img-left { grid-column: 1 / 10; aspect-ratio: 984 / 806; }
  .cs-feat-img-right { grid-column: 4 / 13; aspect-ratio: 984 / 806; }
  .cs-feat-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .cs-feat-col-right { grid-column: 10 / 13; }
  .cs-feat-col-left { grid-column: 1 / 4; grid-row: 1; }
  .cs-feat-head { display: flex; flex-direction: column; gap: var(--space-2); }
  .cs-feat-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.48;
    letter-spacing: -0.01em;
    font-weight: 400;
    color: #fff;
  }
  .cs-feat-body {
    margin: 0;
    max-width: 280px;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-feat-lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .cs-feat-list { display: flex; flex-direction: column; gap: var(--space-2); }
  .cs-feat-item { display: flex; gap: var(--space-2); align-items: flex-start; }
  .cs-bullet { flex: 0 0 auto; width: 15px; height: 15px; margin-top: 1px; }

  /* ---- Responsive: collapse to single column under 900px ---- */
  @media (max-width: 900px) {
    .cs-info, .cs-standfirst,
    .cs-rowlabel, .cs-rowbody,
    .cs-pair-a-left, .cs-pair-a-right, .cs-pair-b-left, .cs-pair-b-right,
    .cs-pair-half-left, .cs-pair-half-right,
    .cs-pair-narrow-left, .cs-pair-broad-right,
    .cs-img-wide,
    .cs-feat-img-left, .cs-feat-img-right,
    .cs-feat-col-left, .cs-feat-col-right { grid-column: 1 / -1; }
    .cs-feat-col-left { grid-row: auto; }
    .cs-feat-body { max-width: none; }
    /* Media leads the stacked feature rows: text-left/image-right features
       (Streamhub) carry their image second in DOM, so pull it first here —
       image-left features already stack media-first naturally. */
    .cs-feat-img-right { order: -1; }
    /* Native ratio, never cropped (site rule for work-page panels): each
       stacked panel takes its media's intrinsic ratio — the medium flows
       in-layout instead of cover-filling an imposed box. Every panel
       img/video carries real width/height attrs, so the ratio is known
       before load and nothing shifts. Composed panels (the extension mock)
       keep their own boxes via the :not(); the product screens aren't
       .cs-img at all and keep their 4:3 box. */
    .cs-pair-a-left, .cs-pair-a-right, .cs-pair-b-left, .cs-pair-b-right,
    .cs-pair-half-left, .cs-pair-half-right,
    .cs-pair-narrow-left, .cs-pair-broad-right,
    .cs-feat-img-left, .cs-feat-img-right,
    .cs-img-wide { height: auto; aspect-ratio: auto; }
    .cs-img:not(.cs-ext-panel) > img,
    .cs-img:not(.cs-ext-panel) > video {
      position: static;
      height: auto;
    }
    /* Stat boxes: tighter box, all text at 14px on mobile. */
    .cs-stat { padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2); }
    .cs-stat-num,
    .cs-stat-sub,
    .cs-stat-store { font-size: 14px; }
    /* Extension panel per Figma 2785:36687 — taller field, the mock scaled
       up (51% of panel width, was 42.6%) and centred in the space above a
       full-width stat BAR along the bottom (logo + store label spread from
       the stacked numbers), replacing the desktop corner notch. The bar is
       a token height so the mock's centring can subtract it; the ratio runs
       a little past the file's 793 because the fixed-px bar eats
       proportionally more of a phone-width panel than of the 746 comp. */
    .cs-ext-panel { height: auto; aspect-ratio: 746 / 840; }
    .cs-ext {
      left: 50%;
      top: calc((100% - var(--space-7)) / 2);
      transform: translate(-50%, -50%);
      width: 50.96%;             /* 380 / 746 */
      font-size: 2.564cqw;       /* 19.13px × (panel / 746) */
    }
    .cs-stat-brand {
      inset-inline: 0;
      height: var(--space-7);
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      padding: 0 var(--space-3);
    }
    /* The numbers column gives way first: it may wrap on the narrowest
       phones rather than force the bar past the screen edge. */
    .cs-stat-brand .cs-stat-nums { flex: 0 1 auto; min-width: 0; }
  }

  /* ============================================================
     Chapters, section tabs and the Product Design chapter.
     ============================================================ */

  /* ---- Section tabs ----
     In flow under the hero, then pinned to the top until the chapters end
