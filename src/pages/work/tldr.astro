---
import FullscreenLayout from "../../layouts/FullscreenLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import GridLines from "../../components/GridLines.astro";
import DevGrid from "../../components/DevGrid.astro";
import MoreWork from "../../components/MoreWork.astro";
import MobileVideoSwap from "../../components/MobileVideoSwap.astro";
// TL;DR case study. The hero, About, Front-End Builds and Brand & Marketing
// bands come from Figma 2548:24573: typography copied exactly, spacing and
// columns mapped onto the site's 12-col macro grid. The page is split into
// three chapters under a sticky tab bar (Overview · Product Design ·
// Front-End Builds · Brand & Marketing):
//
//   Product Design   — the product case study Neel supplied (tldr-case-study
//                      .zip): three calls, the dashboard, live clipping, the
//                      product's visual language, clip-to-post. Replaces the
//                      old Product Design band.
//   Front-End Builds — the old Feature Builds band, unchanged.
//   Brand & Marketing — the old Brand, Website and TwitchCon bands, unchanged.
//
// Product UI panels: the screens are snapshots of the TL;DR prototype's own
// markup + CSS (public/tldr-ui/*.html), fetched on approach and mounted in a
// shadow root so neither stylesheet leaks into the other, then scaled from
// their 1600px layout to the panel width via --k. Each screen sits on a
// TL;DR pixel-texture panel (public/tldr-panel-bg-*.jpg). These are composed
// panels: the app window deliberately runs off the panel edge, so they keep
// their 4:3 box on mobile like the extension mock does.

const info = [
  {
    label: "Things I Did",
    values: [
      "Brand Creation",
      "Product UI/UX",
      "Product Front-End Code (React)",
      "Website Design & Development",
      "Investor & Sales Decks",
      "Clothing & Event Design",
    ],
  },
  { label: "Company", values: ["TL;DR"] },
  { label: "Role", values: ["Co-Founder", "Creative Director"] },
  { label: "Year", values: ["2024 → Present"] },
  { label: "Live website", values: [], link: { text: "Visit website", href: "https://tl-dr.tv" } },
];

const myTldrFeatures = [
  "Modular bento-style layout engine that adapts based off what the user sets up",
  "Detection if the user is live on Twitch or Kick to drive traffic to their stream",
  "Opt-in for user to send out email and text blasts when they go live",
  "Stream highlight clips from TL;DR",
  "User’s livestreaming schedule",
  "Links to their affiliate products",
];

const streamhubFeatures = [
  "Drag and drop canvas to position and resize sub account livestreams",
  "Manual clipping button per sub account livestream",
  "Ability to toggle on & off subaccounts in the canvas view",
];

// ---- Product Design chapter (copy from the supplied case study) ----
// The three calls; each card jumps to its section.
const calls = [
  { id: "d-rhythm", title: "Built for the minutes around a stream", body: "Every question in a fixed place, for quick check-ins." },
  { id: "d-live", title: "Clips arrive while you’re still live", body: "Each clip shows up as it lands, not after the VOD." },
  { id: "d-twitch", title: "At home next to Twitch", body: "Twitch’s visual language, with a mark of its own." },
];

// The dashboard's four questions — numbered to match the pins on the screen.
const dashQuestions = [
  { q: "Is TL;DR seeing my stream?", a: "Before going live, the status banner says so, with support one click away." },
  { q: "What posts when I go live?", a: "StreamSignal shows the post and where it goes." },
  { q: "How did that one go?", a: "Views, clips and chat activity from the last stream." },
  { q: "What’s going out next?", a: "Upcoming posts, by day." },
];

// Where each question lives on the dashboard: % of the app window, measured
// from the snapshot. r is the card's corner radius in cqw of the window
// (1cqw = 16px at the snapshot's 1600px width). spotVars feeds the spotlight.
const dashRegions = [
  { l: 3.06, t: 13.7, w: 42.55, h: 13.29, r: 1 }, // status banner
  { l: 48.67, t: 11.2, w: 49.84, h: 25.34, r: 1.5 }, // StreamSignal
  { l: 3.06, t: 28.99, w: 42.55, h: 46.05, r: 1 }, // stat tiles + chat activity
  { l: 48.67, t: 38.94, w: 49.84, h: 38.6, r: 1.5 }, // upcoming posts
];
const spotVars = (r: (typeof dashRegions)[number]) =>
  `--l:${r.l}%;--t:${r.t}%;--w:${r.w}%;--h:${r.h}%;--r:${r.r}cqw`;

const libraryNotes = [
  { title: "A score on every clip", body: "Clip Score, 0 to 100, so the best moments stand out." },
  { title: "How it was caught", body: "AI Clip, or Voice Clip with the words that triggered it, like “Clip that”." },
  { title: "Straight to editing", body: "Edit Clip sits on every card." },
];

// Product palette — fills/ink are the product's own colours, not site tokens.
const swatches = [
  { name: "Primary", fill: "#9851FB", ink: "#FFFFFF", hex: "#9851FB", use: "Actions, selection and Pro. A neighbour of Twitch’s #9146FF." },
  { name: "Lilac", fill: "#C197FF", ink: "#15131A", hex: "#C197FF", use: "The logo’s pixels, the one break from white." },
  // The product's bg-fancy-gradient-2, copied exactly (the You're Live badge).
  { name: "Gradient", fill: "radial-gradient(60% 140% at 70% 125%, #3112f5 0%, rgba(0, 0, 0, 0) 80%), radial-gradient(59.09% 164.65% at -20% 10%, #3a33ff 10%, rgba(0, 0, 0, 0) 100%), radial-gradient(57.81% 391.02% at 25.57% 34.38%, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 100%), #c262fd", ink: "#FFFFFF", hex: "#C262FD #3A33FF #3112F5", use: "Moments worth celebrating, like the You’re Live badge." },
  { name: "Live", fill: "#F03D3D", ink: "#FFFFFF", hex: "#F03D3D", use: "Live badges and errors, and nothing else." },
  { name: "Surface", fill: "#070707", ink: "#FFFFFF", ring: "rgba(255,255,255,0.12)", hex: "#070707 to #272727", use: "Five steps from the page up to modals. Never pure black." },
  { name: "Text", fill: "#FFFFFF", ink: "#15131A", ring: "rgba(21,19,26,0.12)", hex: "100 72 48 32%", use: "White at four levels of emphasis instead of extra greys." },
];

---
<FullscreenLayout title="TL;DR — Case Study — Neel Sarode">
  <GridLines />

  <!-- Shared radial fill for the spark bullets (exact gradient from the file:
       white core to #999 tips). One defs block; every bullet references it. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <radialGradient id="cs-spark-grad" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(7.5 7.5) rotate(90) scale(7.5)">
        <stop stop-color="white" />
        <stop offset="1" stop-color="#999999" />
      </radialGradient>
    </defs>
  </svg>

  <main class="content">
    <!-- 1 · Hero — full viewport, nav overlaid, title bottom-left. The file
         leaves the hero media empty; the dashboard loop is the obvious
         occupant and was already encoded for the homepage. -->
    <section class="cs-hero" data-reveal-group>
      <video
        class="cs-hero-img"
        src="/tldr-dashboard.mp4" width="1920" height="1080"
        poster="/tldr-dashboard-poster.jpg"
        data-desktop-src="/tldr-dashboard.mp4"
        data-desktop-poster="/tldr-dashboard-poster.jpg"
        data-mobile-src="/tldr-dashboard-mobile.mp4"
        data-mobile-poster="/tldr-dashboard-poster-mobile.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
        data-fade
      ></video>
      <!-- Mobile: the square 1080² cut — a portrait 100dvh cover-crop keeps
           roughly half of a square frame vs a quarter of the 16:9 master. -->
      <MobileVideoSwap />
      <div class="cs-hero-scrim" aria-hidden="true"></div>
      <div class="cs-hero-overlay">
        <header class="cs-nav"><SiteNav activePath="/" /></header>
        <h1 class="cs-title">
          <span class="mask"><span class="line">TL;DR</span></span>
        </h1>
      </div>
    </section>


    <!-- Chapters wrapper: holds the tab bar and everything it indexes, so the
         sticky bar lets go when the chapters end (before More Work). -->
    <div class="cs-chapters">
      <!-- Section tabs — in flow under the hero, then sticky at the top.
           The sentinel tells the script when the bar has stuck (the project
           name fades in then). Short labels swap in on narrow screens. -->
      <div class="cs-tabs-sentinel" aria-hidden="true"></div>
      <nav class="cs-tabs" aria-label="Case study sections">
        <div class="content-grid">
          <div class="full-composed cs-tabs-row">
            <p class="cs-tabs-name" aria-hidden="true">TL;DR</p>
            <div class="cs-tabs-list">
              <a class="cs-tab" href="#overview" aria-current="true">Overview</a>
              <a class="cs-tab" href="#product"><span class="cs-tab-long">Product Design</span><span class="cs-tab-short">Product</span></a>
              <a class="cs-tab" href="#builds"><span class="cs-tab-long">Front-End Builds</span><span class="cs-tab-short">Front-End</span></a>
              <a class="cs-tab" href="#brand"><span class="cs-tab-long">Brand &amp; Marketing</span><span class="cs-tab-short">Brand</span></a>
              <span class="cs-tabs-ink" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </nav>

    <!-- 2 · About — info tiles (cols 1-6) + standfirst (cols 7-13). -->
    <section class="cs-band cs-about" id="overview" aria-label="Overview">
      <div class="content-grid">
        <div class="full-composed">
          <div class="cs-info" data-reveal-group>
            <div class="cs-tile cs-tile-tall">
              <span class="mask"><p class="cs-ilabel">{info[0].label}</p></span>
              <div class="cs-tile-values">
                {info[0].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
            </div>
            <div class="cs-tile-stack">
              <div class="cs-tile">
                <span class="mask"><p class="cs-ilabel">{info[1].label}</p></span>
                {info[1].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
              <div class="cs-tile">
                <span class="mask"><p class="cs-ilabel">{info[2].label}</p></span>
                {info[2].values.map((v) => (
                  <span class="mask"><p class="cs-ivalue">{v}</p></span>
                ))}
              </div>
            </div>
            <div class="cs-tile">
              <span class="mask"><p class="cs-ilabel">{info[3].label}</p></span>
              {info[3].values.map((v) => (
                <span class="mask"><p class="cs-ivalue">{v}</p></span>
              ))}
            </div>
            <div class="cs-tile">
              <span class="mask"><p class="cs-ilabel">{info[4].label}</p></span>
              <span class="mask">
                <a class="cs-ivalue cs-ilink" href={info[4].link!.href} target="_blank" rel="noopener">{info[4].link!.text}</a>
              </span>
            </div>
          </div>

          <div class="cs-standfirst" data-reveal-group>
            <span class="mask"><p class="cs-statement">
              <span class="mut">TL;DR is a software platform that empowers livestreamers
              with growth tools like AI-generated live highlight clips, video editing,
              and distribution across socials.</span>
            </p></span>
            <span class="mask"><p class="cs-statement">
              I joined at formation and built everything users see: the brand and
              website from zero, the product UX, and large parts of shipped React
              front-end. Most feature and product direction decisions were mine.
            </p></span>
          </div>
        </div>
      </div>
    </section>


    <!-- ================================================================
         CHAPTER · Product Design — the supplied product case study.
         ================================================================ -->
    <section class="cs-chapter" id="product" aria-labelledby="ch-product">
      <div class="content-grid">
        <header class="full-composed cs-chapter-head" data-reveal-group>
          <span class="cs-chapter-rule" aria-hidden="true"></span>
          <span class="mask cs-rowlabel"><h2 class="cs-chapter-title" id="ch-product">Product Design</h2></span>
          <span class="mask cs-rowbody"><p class="cs-body">
            <span class="mut">Product design at TL;DR wasn’t just hand-off work.</span>
            I made most feature and UX direction calls, deciding not just how
            things looked but what got built and why.
          </p></span>
        </header>
      </div>

      <!-- Three calls — label/body row, then the three calls as index rows
           on the same columns, each jumping to its section below. -->
      <section class="cs-band">
        <div class="content-grid">
          <div class="full-composed cs-row-lead" data-reveal-group>
            <span class="mask cs-rowlabel"><p class="cs-label">Three calls from the start</p></span>
            <span class="mask cs-rowbody"><p class="cs-body">
              <span class="mut">Short clips are how streams find new viewers, and
              most streamers have no time to make them.</span> Three calls made at
              the start shaped everything after.
            </p></span>
          </div>
        </div>
        <div class="content-grid">
          <div class="full-composed" data-reveal-group>
            <div class="cs-index">
              {calls.map((c, i) => (
                <a class="cs-index-row" href={`#${c.id}`} data-fade data-cursor-label="Jump to section ↓">
                  <span class="cs-rowlabel cs-index-label">
                    <span class="cs-mono">{String(i + 1).padStart(2, "0")}</span>
                    <span>{c.title}</span>
                  </span>
                  <span class="cs-rowbody cs-index-body">
                    <span>{c.body}</span>
                    <svg class="cs-index-arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v10M1.5 6.5 6 11l4.5-4.5" /></svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 01 · Built for the minutes around a stream — dashboard screen
           (left 9 cols) with a spotlight that steps through the four
           questions it answers (right). -->
      <section class="cs-band">
        <div class="content-grid">
          <div class="full-composed cs-row-lead" id="d-rhythm" data-reveal-group>
            <div class="cs-rowlabel cs-rowlabel-stack">
              <span class="mask"><p class="cs-mono">01</p></span>
              <span class="mask"><p class="cs-label">Built for the minutes around a stream</p></span>
            </div>
            <span class="mask cs-rowbody"><p class="cs-body">
              <span class="mut">Streamers don’t sit in TL;DR.</span> They open it
              before going live, between sessions and right after, next to OBS
              and Twitch. So the dashboard is dark, fast to scan, and every
              question has a fixed place.
            </p></span>
          </div>
        </div>
        <div class="content-grid">
          <!-- The list drives the screen: the active question's area stays
               lit while the rest of the window dims. -->
          <div class="full-composed cs-dash" data-reveal-group>
            <figure class="cs-screen cs-bg-1 cs-scr-left" data-fade>
              <div class="cs-shot" style="--x:6%;--y:9%;--w:124%">
                <div class="cs-frame">
                  <div class="cs-ui" data-ui="dash" style="aspect-ratio:1600/1000" role="img" aria-label="The TL;DR dashboard between streams: the status banner, which says Start Your Stream to Generate Clips and offers support if TL;DR missed the stream; StreamSignal, showing the socials and platforms it posts to; views, clips and the chat activity chart from the last stream; and Upcoming Scheduled Posts, listed by day."></div>
                  <span class="cs-spot" aria-hidden="true" style={spotVars(dashRegions[0])}></span>
                </div>
              </div>
              <figcaption class="cs-cap">The dashboard between streams</figcaption>
            </figure>
            <div class="cs-feat-col cs-feat-col-right">
              <div class="cs-feat-head">
                <span class="mask"><h3 class="cs-feat-title">Dashboard</h3></span>
                <span class="mask"><p class="cs-feat-body">
                  One screen answers the four questions a streamer brings to it,
                  each in the same place every time.
                </p></span>
              </div>
              <ol class="cs-qa">
                {dashQuestions.map((q, i) => (
                  <li class={`cs-qa-item${i === 0 ? " is-active" : ""}`} data-i={i + 1} data-spot={spotVars(dashRegions[i])} tabindex="0">
                    <span class="cs-mono cs-qa-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <div class="cs-qa-text">
                      <span class="mask"><p class="cs-feat-lead">{q.q}</p></span>
                      <span class="mask"><p class="cs-feat-body">{q.a}</p></span>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 · Clips arrive while you're still live — the chat-activity demo,
           the Video Library (notes left, animated screen right), then the
           live dashboard + StreamSignal pair. -->
      <section class="cs-band">
        <div class="content-grid">
          <div class="full-composed cs-row-lead" id="d-live" data-reveal-group>
            <div class="cs-rowlabel cs-rowlabel-stack">
              <span class="mask"><p class="cs-mono">02</p></span>
              <span class="mask"><p class="cs-label">Clips arrive while you’re still live</p></span>
            </div>
            <div class="cs-rowbody cs-rowbody-stack">
              <span class="mask"><p class="cs-body">
                <span class="mut">TL;DR was the first to clip a stream while it’s
                happening, not from the VOD afterwards.</span> So the product
                shows each clip as it lands: when it happened, how it was caught
                and how good it is.
              </p></span>
              <span class="mask"><p class="cs-body">
                <span class="mut">A stream’s best moments show up in its chat.</span>
                Try it on the stream below.
              </p></span>
            </div>
          </div>
        </div>
        <div class="content-grid">
          <div class="full-composed" data-reveal-group>
            <div class="tl-chat" id="chat" data-fade>
              <div class="tl-plot" id="plot">
                <svg viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path id="chat-line" d=""></path></svg>
                <div class="tl-guide" id="chat-guide"></div>
                <div id="chat-marks"></div>
                <div class="tl-dot" id="chat-dot"></div>
                <input type="range" id="chat-range" min="0" max="35" step="1" value="35" aria-label="Position in the example stream" />
              </div>
              <div class="tl-side">
                <div class="tl-head" aria-hidden="true">
                  <p class="tl-num" id="chat-num">0</p>
                  <p class="tl-sub"><span id="chat-unit">chats in total</span></p>
                  <p class="tl-sub" id="chat-sub">Example stream, 3 hours</p>
                </div>
                <p class="tl-clipread" id="chat-clip" aria-live="polite"></p>
                <ul class="tl-legend">
                  <li><i></i>AI clip</li>
                  <li><i class="tl-voice"></i>Voice clip</li>
                </ul>
              </div>
              <p class="cs-cap tl-chat-cap">Clip markers are added for this page. In the product, the chart is only the line.</p>
              <div class="tl-sr"><table id="chat-table"><caption>Chat activity in the example stream, per five minutes</caption><thead><tr><th scope="col">Time into stream</th><th scope="col">Chats</th><th scope="col">Clip</th></tr></thead><tbody></tbody></table></div>
            </div>
          </div>
        </div>
        <div class="content-grid">
          <div class="full-composed cs-feature" data-reveal-group>
            <div class="cs-feat-col cs-feat-col-left">
              <div class="cs-feat-head">
                <span class="mask"><h3 class="cs-feat-title">Video Library</h3></span>
                <span class="mask"><p class="cs-feat-body">
                  Clips land here mid-stream, grouped by the stream they came from.
                </p></span>
              </div>
              <ul class="cs-qa">
                {libraryNotes.map((n) => (
                  <li class="cs-qa-item">
                    <svg class="cs-bullet" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M7.5 0C7.16563 6.89063 6.89063 7.16563 0 7.5C6.89063 7.83438 7.16563 8.10938 7.5 15C7.83438 8.10938 8.10938 7.83438 15 7.5C8.10938 7.16563 7.83438 6.89063 7.5 0Z" fill="url(#cs-spark-grad)" />
                    </svg>
                    <div class="cs-qa-text">
                      <span class="mask"><p class="cs-feat-lead">{n.title}</p></span>
                      <span class="mask"><p class="cs-feat-body">{n.body}</p></span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            <figure class="cs-screen cs-bg-5 cs-scr-right" data-fade>
              <div class="cs-shot" style="--x:6%;--y:8%;--w:115%">
                <div class="cs-frame"><div class="cs-ui" data-ui="library" data-anim="clips" style="aspect-ratio:1600/1400" role="img" aria-label="The Video Library: a Pro access banner, Group by Date or Stream, then today's livestream with clip cards for Insane 1v5 clutch moment (Voice Clip, wake words Clip that, Clip Score 92), Boss kill on hardcore mode (AI Clip, 74) and Chat loses it after this play (AI Clip, 88), each with views, time, platform, Edit Clip and Save to Library."></div></div>
              </div>
              <button class="cs-abtn" type="button" aria-pressed="false" hidden>Pause</button>
              <figcaption class="cs-cap">Today’s stream, clipped while it was live</figcaption>
            </figure>
          </div>
        </div>
        <div class="content-grid">
          <div class="full-composed cs-feature" data-reveal-group>
            <figure class="cs-screen cs-bg-3 cs-scr-half-l" data-fade>
              <div class="cs-shot" style="--x:3.2%;--y:10%;--w:190%">
                <div class="cs-frame"><div class="cs-ui" data-ui="live" data-anim="live" style="aspect-ratio:1600/1000" role="img" aria-label="The dashboard during a stream, zoomed in on its top left: a You're Live badge with the Twitch icon, the title You're Live on Twitch!, the line We're actively clipping your best highlights as you stream, and stat tiles for 48,219 views, 86 clips and 24 voice clips."></div></div>
              </div>
              <button class="cs-abtn" type="button" aria-pressed="false" hidden>Pause</button>
              <figcaption class="cs-cap">Mid-stream, the dashboard says TL;DR is clipping</figcaption>
            </figure>
            <figure class="cs-screen cs-bg-4 cs-scr-half-r" data-fade>
              <div class="cs-shot" style="--x:7%;--y:10%;--w:130%">
                <div class="cs-frame">
                  <video
                    src="/tldr-streamsignal-loop.mp4" width="1920" height="1200"
                    poster="/tldr-streamsignal-poster.jpg"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    tabindex="-1"
                    aria-label="The StreamSignal page. The cursor picks different webcam frame shapes and layouts, and the vertical preview of the post rearranges to match each choice."
                  ></video>
                </div>
              </div>
              <figcaption class="cs-cap">StreamSignal posts the first clip while you’re still live</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- 03 · At home next to Twitch — palette, then the pixel logotype and
           the condensed display face on the Pro banner. -->
      <section class="cs-band">
        <div class="content-grid">
          <div class="full-composed cs-row-lead" id="d-twitch" data-reveal-group>
            <div class="cs-rowlabel cs-rowlabel-stack">
              <span class="mask"><p class="cs-mono">03</p></span>
              <span class="mask"><p class="cs-label">At home next to Twitch</p></span>
            </div>
            <div class="cs-rowbody cs-rowbody-stack">
              <span class="mask"><p class="cs-body">
                <span class="mut">TL;DR started as an extension inside Twitch,
                installed 35,000+ times.</span> So it borrows what streamers
                already trust, a purple close to Twitch’s on dark surfaces, and
                adds a pixel logotype of its own.
              </p></span>
              <span class="mask"><p class="cs-body">
                <span class="mut">Everything is tuned for a dark room.</span> Five
                surface steps carry depth, and type is Open Sauce Two at two
                weights.
              </p></span>
            </div>
          </div>
        </div>
        <div class="content-grid">
          <div class="full-composed" data-reveal-group>
            {swatches.map((s) => (
              <div class="cs-swatch" data-fade>
