    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .cs-chip {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: flex-end;
    padding: var(--space-2);
