</FullscreenLayout>

<!-- Same reveal system as the homepage: masked line rises + media fades per
     [data-reveal-group], wired to Lenis. gsap.from only — no-JS/reduced-motion
     visitors simply see the content. -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.registerPlugin(ScrollTrigger);

    const wireLenis = () => {
      const lenis = (window as any).lenis;
      if (lenis) lenis.on("scroll", ScrollTrigger.update);
    };
    (window as any).lenis
      ? wireLenis()
      : addEventListener("lenis:init", wireLenis, { once: true });

    // Panel loops autoplay below the fold, and Chrome's offscreen media
    // optimisation can pause them there without resuming on scroll — same
    // failure mode the homepage covers solve. Gate each on visibility.
    document
      .querySelectorAll<HTMLVideoElement>("video.cs-ext-bg, .cs-img > video")
      .forEach((v) => {
        new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) v.play().catch(() => {});
              else v.pause();
            });
          },
          { rootMargin: "160px" },
        ).observe(v);
      });

    gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
      const risers = group.querySelectorAll(".mask > *");
      const fades = group.querySelectorAll("[data-fade]");
      const tl = gsap.timeline({
        scrollTrigger: { trigger: group, start: "top 82%", once: true },
      });
      if (risers.length) {
        tl.from(risers, {
          yPercent: 110,
          duration: 0.9,
          ease: "power4.out",
          stagger: 0.09,
        });
      }
      if (fades.length) {
        tl.from(fades, { opacity: 0, duration: 0.9, ease: "power2.out" }, 0.1);
      }
    });
  } else {
    // Reduced motion: the hero and extension loops stay on their posters.
    document.querySelectorAll<HTMLVideoElement>("video.cs-hero-img, video.cs-ext-bg, .cs-img > video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
      v.currentTime = 0;
    });
  }
</script>

<style>
  .content { position: relative; z-index: 1; }

  /* ---- Masked line reveals (same recipe as the homepage) ---- */
  .mask {
    display: block;
    overflow: clip;
    padding-block-end: 0.14em;
    margin-block-end: -0.14em;
  }
  .line { display: block; }

  /* ============================================================
     Type recipes — EXACT values from the Figma file. All Geist 400.
       display title    52 / 1    / -0.04em
       body (24-class)  24 / 1.2  / -0.02em   white, .mut spans 65%
       about statement  24 / 1.15 / -0.02em
       row label        16 / 1.2  / -0.01em   65%
       stat number      24 / 1.15 / -0.02em   · stat sub 16 / 1.15 / 65%
       info label       14 / 1.2  / -0.01em   65%
       info value       14 / 1.48 / -0.01em   white
       feature title    18 / 1.48 / -0.01em   white
       feature body     14 / 1.2  / -0.01em   65% (lead-in white)
       image caption    12 / 1.2  / -0.01em   88%
     ============================================================ */
  .cs-title {
    margin: 0;
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #fff;
  }
  .cs-body {
    margin: 0;
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cs-statement {
    margin: 0;
    font-size: clamp(18px, 1.67vw, 24px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .mut { color: rgba(255, 255, 255, 0.65); }
  .cs-center { text-align: center; text-wrap: balance; }
  .cs-label {
    margin: 0;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-ilabel {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.65);
  }
  .cs-ivalue {
    margin: 0;
    font-size: 14px;
    line-height: 1.48;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .cs-ilink { text-decoration: underline; text-underline-offset: 3px; }

  /* ---- 1 · Hero ---- */
  .cs-hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--placeholder);
  }
  .cs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.25) 0%, rgba(10, 10, 11, 0) 30%, rgba(10, 10, 11, 0) 55%, rgba(10, 10, 11, 0.55) 100%);
  }
  /* Edge-hug overlay — the homepage hero's exact padding recipe. */
  .cs-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 1.2vw, 20px);
  }
  .cs-nav { padding: 0; }

  /* ---- Section rhythm (from the file: 96 into About, 128 between bands,
         64 around intros and label/body rows, 24 between media rows). ---- */
  .cs-band { padding-block-end: var(--space-8); }
  .cs-about { padding-block: var(--space-7) var(--space-8); }
  .cs-row { margin-block-start: var(--space-6); }
  .cs-intro {
    grid-column: 1 / -1;
    justify-self: center;
    max-width: 702px;
    margin-block-end: var(--space-6);
  }
  .cs-feature { margin-block-start: var(--space-6); }

  /* ---- 2 · About ---- */
  .cs-info {
    grid-column: 1 / 6;
    display: grid;
